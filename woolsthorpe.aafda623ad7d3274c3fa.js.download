;\nuniform bool  uOutsideIsolation;\n#endif\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n\n//#define DEBUG_SILHOUETTES\n\nvoid decodeNormals(vec3 position, vec3 direction, vec3 encodedNormals, out vec3 normal1, out vec3 normal2) {\n  float xyLength = cos(encodedNormals[1]);\n  float x1 = cos(encodedNormals[0]) * xyLength;\n  float y1 = sin(encodedNormals[0]) * xyLength;\n  float z1 = sin(encodedNormals[1]);\n  normal1 = vec3(x1, y1, z1);\n  vec3 binormal = cross(direction, normal1);\n  normal2 = (cos(encodedNormals[2]) * normal1) + (sin(encodedNormals[2]) * binormal);\n}\n\nbool silhouetteTestOrthographic(mat4 pmvMatrix, vec3 normal1, vec3 normal2) {\n  // In orthographic, we just need to rotate the normals and check the z coordinate.\n  float p1z = (pmvMatrix * vec4(normal1, 0.0)).z;\n  float p2z = (pmvMatrix * vec4(normal2, 0.0)).z;\n\n  // If the normals have different signs, then one is pointed into the screen and one is pointed out, and hence\n  // this edge is a silhouette.\n  return p1z * p2z < 0.0;\n}\n\nbool silhouetteTestPerspective(mat4 pmvMatrix, vec3 position, vec3 direction, vec3 normal1, vec3 normal2) {\n  // In perspective things are more complicated. We need to create points that lie in the two normal planes,\n  // project these in-plane points along with the edge position and edge tangent point, then reconstruct\n  // a clip-space normal for each face and test the Z coordinates of those normals.\n  const float SMALL_STEP = 0.0001;\n  vec3 binormal1 = cross(direction, normal1);\n  vec3 binormal2 = cross(direction, normal2);\n\n  vec3 onEdge = position + direction*SMALL_STEP;\n  vec3 inPlane1 = position + binormal1*SMALL_STEP;\n  vec3 inPlane2 = position + binormal2*SMALL_STEP;\n  vec4 projectedPosition = pmvMatrix * vec4(position, 1.0);\n  vec4 projectedOnEdge = pmvMatrix * vec4(onEdge, 1.0);\n  vec4 projectedInPlane1 = pmvMatrix * vec4(inPlane1, 1.0);\n  vec4 projectedInPlane2 = pmvMatrix * vec4(inPlane2, 1.0);\n\n  vec3 clipPosition = projectedPosition.xyz / projectedPosition.w;\n  vec3 clipOnEdge = projectedOnEdge.xyz / projectedOnEdge.w;\n  vec3 clipInPlane1 = projectedInPlane1.xyz / projectedInPlane1.w;\n  vec3 clipInPlane2 = projectedInPlane2.xyz / projectedInPlane2.w;\n\n  vec3 clipTangent = clipOnEdge - clipPosition;\n  vec3 clipBinormal1 = clipInPlane1 - clipPosition;\n  vec3 clipBinormal2 = clipInPlane2 - clipPosition;\n\n  vec3 clipNormal1 = cross(clipBinormal1, clipTangent);\n  vec3 clipNormal2 = cross(clipBinormal2, clipTangent);\n\n  // If the normals have different signs, then one is pointed into the screen and one is pointed out, and hence\n  // this edge is a silhouette.\n  return clipNormal1.z * clipNormal2.z < 0.0;\n}\n\nvoid main(void) {\n    mat4 projectedModelViewMatrix = uPMatrix * uMVMatrix;\n    bool isOrthographic = (uPMatrix[3][3] > 0.0);\n\n    vec3 edgeDirection = normalize(aEdgeData.xyz);\n    float edgeLength = abs(aEdgeData.a) - 1.0;\n    vec3 normal1, normal2;\n    decodeNormals(aVertexPosition, edgeDirection, aVertexNormal, normal1, normal2);\n\n    vec4 cameraPosition = (uMVMatrix * vec4(aVertexPosition, 1.0));\n    gl_Position = uPMatrix * cameraPosition;\n\n    vPosition = cameraPosition.xyz;\n\n    bool isSilhouette = false;\n    if (isOrthographic) {\n      isSilhouette = silhouetteTestOrthographic(projectedModelViewMatrix, normal1, normal2);\n    } else {\n      isSilhouette = silhouetteTestPerspective(projectedModelViewMatrix, aVertexPosition, edgeDirection,\n                                               normal1, normal2);\n    }\n    vSilhouetteTest = 0.0;\n\n#ifdef DEBUG_SILHOUETTES\n    vColor = (isSilhouette) ? vec4(1.0, 0.0, 0.0, 1.0) : vec4(0.0, 0.0, 1.0, 0.5);\n#else\n    if (!isSilhouette) {\n      vSilhouetteTest = -1.0;\n      return;\n    }\n\n    vColor = aVertexColor;\n#ifdef OIT_SHADER\n    if (uOutsideIsolation) {\n      vColor.a = uIsolateTranslucentAlpha;\n    }\n#endif\n\n#endif\n\n    // Record the actual line width for use in the fragment shader.\n    vLineWidth = uDevicePixelRatio * aPrimitiveSize;\n\n    // widen the line to encompass enough fragments for edge filtering (even in the worst-case diagonal direction)\n    float lineWidth = vLineWidth + uLineFilterWidth * SQRT2;\n\n    // edge metadata\n    float cornerIndex = round(length(aEdgeData.xyz));\n    float normalDirectionFlag = -impulse(1.0, cornerIndex) - impulse(2.0, cornerIndex) + impulse(3.0, cornerIndex) + impulse(4.0, cornerIndex);\n    float tangentDirectionFlag = -impulse(1.0, cornerIndex) + impulse(2.0, cornerIndex) + impulse(3.0, cornerIndex) - impulse(4.0, cornerIndex);\n\n    // project the edge direction\n    vec4 projectedDirection = projectedModelViewMatrix * vec4(edgeDirection, 0.0);\n\n    // compute the signed distance of this vertex from the line center\n    vDistance = 0.5 * lineWidth * normalDirectionFlag;\n\n    // compute edge length at this vertex in pixels (used for stippling)\n    float worldToPixel = abs(uPMatrix[0][0] / gl_Position.w) * 0.5 * uViewport.z;\n    vLength = edgeLength * worldToPixel;  // disable line stipple for infinite lines\n\n    // compute tangent and normal offsets that will make the line quad\n    vec2 tangentOffset = vec2(0.0, 0.0);\n    vec2 screenNormal = vec2(0.0, 0.0);\n    if (isOrthographic) {\n      // orthographic projection is simpler\n\n      screenNormal = normalize(uViewport.wz * vec2(-projectedDirection.y, projectedDirection.x));\n    } else {\n      // perspective projection is trickier\n\n      float flip = sign(gl_Position.w + projectedDirection.w);\n      vec4 projectedEnd = gl_Position + flip * projectedDirection;\n      vec2 screenTangent = flip * normalize(uViewport.zw * (projectedEnd.xy / projectedEnd.w - gl_Position.xy / gl_Position.w));\n      screenNormal = vec2(-screenTangent.y, screenTangent.x);\n    }\n\n    // offset the projected vertex\n    vec2 normalOffset = (2.0 * vDistance * gl_Position.w) * (screenNormal / uViewport.zw);\n    gl_Position.xy += tangentOffset + normalOffset;\n}\n"},44518:function(e,t){"use strict";t.Z="{{{vs-draw-faces}}}\n"},53992:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nVERT_IN vec3 aVertexPosition;\n\nVERT_OUT vec2 vTextureCoordinate;\n\n{{{blitFunctions}}}\n\nvoid main(void) {\n    vTextureCoordinate = blitVertexTextureCoordinate(aVertexPosition);\n    gl_Position = vec4(aVertexPosition, 1.0);\n}\n"},98133:function(e,t){"use strict";t.Z="{{{vs-drawTexture}}}\n"},6035:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nuniform float uOffsetFactor;\nuniform float uScalarInputMax;\nuniform float uScalarInputMagnitudeInverse;\nuniform float uScalarOutputMax;\nuniform float uScalarOutputMagnitudeInverse;\n\nVERT_IN vec3 aOffsetVector;\nVERT_IN vec3 aVertexPosition;\n\nVERT_OUT vec3 vPosition;\n\n// Here we offset the simulation vertex by its offset direction, the current offset factor.\n#ifndef POSITION_SETTING_ROUTINE\n#define POSITION_SETTING_ROUTINE vec3 offsetPosition = aVertexPosition + aOffsetVector * uOffsetFactor; vPosition = vec3(uMVMatrix * vec4(offsetPosition, 1.0));\n#endif\n\n{{{vs-endcapMask-faces}}}\n\nvoid main(void) {\n    POSITION_SETTING_ROUTINE;\n    gl_Position = uPMatrix * vec4(vPosition, 1.0);\n}\n"},17666:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nuniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\n// This can be set to zero to make the hatch direction independent of the occurrence id.  We use the occurrence id to\n// increase variability in similarly-colored parts in the scene.  However, these ids are sensitive to changes, and hence\n// can be non-deterministic, and problematic used for testing.  Hence we have a mechanism to disable their use for\n// this situation.\nuniform float uUseOccurrenceIdForHatchOffset;\n\nuniform float uAddsToSectionMask;\nuniform float uMeshGroupIdHash;\nuniform bool  uOutsideIsolation; // Ensure this is declared if used\n\nVERT_IN vec3 aVertexPosition;\nVERT_IN vec4 aVertexColor;\n\nVERT_OUT vec3 vPosition;\nVERT_OUT mediump vec4 vVertexColor;\n\n{{{sectionPlaneConstants}}}\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n\n// This will set the view-space position of the vertex.  This can be overridden to animate the vertex in some fashion\n#ifndef POSITION_SETTING_ROUTINE\n#define POSITION_SETTING_ROUTINE vPosition = vec3(uMVMatrix * vec4(aVertexPosition, 1.0));\n#endif\n\nvoid main(void) {\n  // Offset the color slightly by the occurrence id and mesh ranges groupId to distinguish parts with the same color.\n  float offset = (uMeshGroupIdHash + uOccurrenceId) * uUseOccurrenceIdForHatchOffset;\n  float redOffset = mod(offset, 31.0) * 0.001;\n  float greenOffset = mod(offset, 71.0) * 0.001;\n  float blueOffset = mod(offset, 97.0) * 0.001;\n  vVertexColor = aVertexColor + vec4(redOffset, greenOffset, blueOffset, 0.0);\n\n  vVertexColor.a += partCountOrder; // Always add a constant amount to indicate a part has intersected a fragment\n  if (uOutsideIsolation)\n  {\n    vVertexColor.a += outsideIsolationOrder; // If part is not isolated, then indicate that with more higher order bits\n  }\n\n  // If uAddsToSectionMask is off, nullify its contribution to the mask.\n  vVertexColor *= uAddsToSectionMask;\n\n  POSITION_SETTING_ROUTINE;\n  gl_Position = uPMatrix * vec4(vPosition, 1.0);\n}\n"},14794:function(e,t){"use strict";t.Z="{{{vs-drawTexture}}}\n"},44091:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nuniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nuniform int uUseHighlightUniform;\nuniform vec3 uHighlightIndexInstanceId;\nuniform float uHighlightCount;\n\nVERT_IN vec3 aVertexPosition;\nVERT_IN vec4 aHighlightId;  // R = highlight index, GB = highlight instance id, A = OR of 0(normal), 1(highlighted)\n\nVERT_OUT lowp vec3 vHighlightIndexInstanceId;\n\n{{{utilityFunctions}}}\n{{{highlightFunctions}}}\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n    if (isHighlightTypeActive(aHighlightId.r)) {\n      vHighlightIndexInstanceId = aHighlightId.rgb;\n\n      vec4 cameraPosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n      gl_Position = uPMatrix * cameraPosition;\n    } else {\n      gl_Position = vec4(5.0, 5.0, 5.0, 1.0);  //Put the vertex comfortably outside clip space\n    }\n}\n"},62676:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nuniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform vec4 uViewport;\n\nuniform float uHighlightOpacity;\nuniform vec4 uHighlightLineStipple;\nuniform float uUseHighlightLineStipple;\nuniform float uHighlightLineWidthMin;\nuniform float uHighlightLineWidthScale;\nuniform vec4 uHighlightColor;\nuniform mediump float uDevicePixelRatio;\n\nVERT_IN vec3 aVertexPosition;\nVERT_IN vec4 aVertexColor;\nVERT_IN float aPrimitiveSize;  // line width\nVERT_IN vec4 aHighlightId;  // R = highlight index, GB = highlight instance id, A = an OR of 0(normal), 1(highlighted)\nVERT_IN vec4 aPrimitiveStyle;\n\nVERT_OUT lowp vec4 vColor;\nVERT_OUT mediump float vOffset;  // offset from line center to line edge in multiples of line radius\nVERT_OUT mediump vec4 vLineStipple;\nVERT_OUT mediump float vLength;  // edge length at this vertex in pixels\n\n#ifndef SKIP_SECTION_PLANES\nVERT_OUT vec3 vPositionForSection;\n#endif\n\n{{{utilityFunctions}}}\n{{{highlightFunctions}}}\n{{{vertexUtilityFunctions}}}\n{{{edgeUtilityFunctions}}}\n\nvoid main(void) {\n  // Only draw highlighted geometry\n  if (!isHighlightedForIndex(aHighlightId.a, aHighlightId.r, -1.0)) {\n    gl_Position = vec4(5.0, 5.0, 5.0, 1.0);  //Put the vertex comfortably outside clip space\n  }\n  else {\n    vLineStipple = mix(aPrimitiveStyle, uHighlightLineStipple, uUseHighlightLineStipple);\n\n    vColor = vec4(uHighlightColor.rgb, uHighlightOpacity);\n\n    // figure out line width, taking in account highlight scale and minimum\n    float lineWidth = max(uDevicePixelRatio * aPrimitiveSize * uHighlightLineWidthScale, uHighlightLineWidthMin);\n\n    vec4 cameraSpacePosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n\n#ifndef SKIP_SECTION_PLANES\n    vPositionForSection = cameraSpacePosition.xyz;\n#endif\n\n    // project the vertex position and edge direction\n    gl_Position = uPMatrix * cameraSpacePosition;\n\n    if (uUsePrimitiveLines == 0.0) {\n      // compute the signed offset of this vertex from the line center\n      vOffset = edgeNormalDirectionFlag(edgeCornerIndex());\n\n      // compute edge length at this vertex in pixels (used for stippling)\n      float worldToPixel = abs(uPMatrix[0][0] / gl_Position.w) * 0.5 * uViewport.z;\n      vLength = mix(edgeLength() * worldToPixel, 0.0, float(edgeIsInfinite()));  // disable line stipple for infinite lines\n\n      vec2 tangentOffset, normalOffset;\n      computeTangentAndNormalOffsets(uMVMatrix, gl_Position, lineWidth, tangentOffset, normalOffset);\n      gl_Position.xy += tangentOffset + normalOffset;\n    }\n  }\n}\n"},30990:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nuniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform vec4 uViewport;\n\nuniform float uHighlightOpacity;\nuniform vec2 uHighlightPointFont;\nuniform float uHighlightPointSizeMin;\nuniform float uHighlightPointSizeScale;\nuniform vec4 uHighlightColor;\n\nuniform mediump float uDevicePixelRatio;\n\nVERT_IN vec3 aVertexPosition;\nVERT_IN float aPointData;  // corner index: 1=bottom-right, 2=top-right, 3=top-left, 4=bottom-left\nVERT_IN float aPrimitiveSize;\nVERT_IN vec4 aHighlightId;  // R = highlight index, GB = highlight instance id, A = an OR of 0(normal), 1(highlighted)\n\nVERT_OUT lowp vec4 vColor;\nVERT_OUT mediump vec2  vOffset;  // screen offset from the point center in multiples of radius\n#ifndef SKIP_SECTION_PLANES\nVERT_OUT vec3 vPositionForSection;\n#endif\n\n{{{utilityFunctions}}}\n{{{highlightFunctions}}}\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n  // Only draw highlighted geometry\n  if (isHighlightedForIndex(aHighlightId.a, aHighlightId.r, -1.0)) {\n    vColor = vec4(uHighlightColor.rgb, uHighlightOpacity);\n    float pointSize = max(uDevicePixelR