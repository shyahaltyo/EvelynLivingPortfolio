ar subscription that costs \' | i18next}} {{ctrl.summary.total | currency:\'$\' | currencyDecimalSeparator}} {{\' per year. Your subscription will automatically renew for additional periods of 1 year each unless you cancel. Your price may increase at each renewal. You will be notified of increases at least 60 days prior to renewal.\'| i18next}}\n              <br/>\n              <br/>\n              {{\'You can cancel your subscription at any time by emailing\' | i18next}} <a href="mailto:onshape-customers@ptc.com">onshape-customers@ptc.com</a>.\n              {{\'To avoid being charged for the next billing cycle, you must cancel at least 30 days before your subscription renewal date, and no refunds will be provided if you cancel less than 30 days before your subscription renewal date.\'| i18next}}\n              </span>\n            </div>\n            <div class="os-form-field-container os-discount-announcement-container" ng-if="ctrl.shouldShowDiscountIndicator()">\n              <div class="alert alert-info"><os-svg icon="performance-info"></os-svg> <span ng-bind-html="ctrl.getPlanDiscountMessage(ctrl.purchaseDetails.planId)"></span></div>\n            </div>\n            <div class="os-form-group os-upgrade-company-section payment-options" ng-if="ctrl.isAutoRenewBoxChecked">\n              <osx-payment-options></osx-payment-options>\n              <div class="clearfix"></div>\n            </div>\n            <div class="os-center-content os-form-btn-container upgrade-plans-button-actions">\n              <button type="submit" ng-if="ctrl.isReviewShow()" ng-disabled="osForm.$invalid || ctrl.isReviewPurchaseButtonDisabled() || ctrl.isServerError || ctrl.isInitError || !ctrl.isAutoRenewBoxChecked" class="btn btn-primary os-signup-pro-review-btn">{{\'Review purchase\' | i18next}}</button>\n            </div>\n          </div>\n          <div class="col-xs-12 col-sm-12 col-md-4">\n            <div class="os-payment-sidebar" ng-include="\'/project/web/woolsthorpe/app