ibraryName }}</span>\n        </div>\n        <div class="col-3">\n          <span class="ellipsis-overflow-text"> {{ library.documentName }}</span>\n        </div>\n        <div class="col-3">\n          <span class="ellipsis-overflow-text"> {{ library.ownerName }}</span>\n        </div>\n        <div class="col-2">\n          <button class="btn btn-sm btn-primary ng-binding ng-scope" ng-disabled="true">{{ "Remove" | i18next }}</button>\n        </div>\n      </div>\n    </div>\n    <button class="btn btn-primary os-user-settings-margin" ng-click="$ctrl.addMaterialLibrary()">{{\'Add material library…\' | i18next}}</button>\n  </div>\n</div>\n\n\n\x3c!-- export rule settings --\x3e\n<export-rule-list\n  ng-if="!$ctrl.isExportRulesListAngular20Enabled"\n  current-user="$ctrl.currentUser"\n></export-rule-list>\n\n<osx-export-rule-list\n  ng-if="$ctrl.isExportRulesListAngular20Enabled"\n  [current-user]="$ctrl.currentUser"\n></osx-export-rule-list>\n\n\n\x3c!-- Release Management --\x3e\n<osx-preference-release-management\n  ng-if="$ctrl.releaseManagementEnabledForAnyCompany()"\n  [substitute-approver-configs]="$ctrl.substituteApproverConfigsValues"\n  [user-settings-loaded]="$ctrl.userSettingsLoaded"\n  [user-settings-updated]="$ctrl.userSettingsUpdated"\n  (update-user-settings)="$ctrl.updateUserSettings($event.params, $event.successMessage, $event.failureMessage)">\n</osx-preference-release-management>\n')}]),e.exports=n},96949:function(e,t,i){var n="/project/web/ts/variables/variableStudio.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="variable-studio"\n     ng-controller="VariableStudioTableController as variableTableController"\n     oncontextmenu="return false;">\n  <div class="header-container center-contents" ng-if="variableTableController.getCanEditVariableTable()">\n    <div class="reference-button-container btn-group">\n      <button class="btn btn-secondary"\n          data-bs-original-title="{{ \'Insert Variable Studio\