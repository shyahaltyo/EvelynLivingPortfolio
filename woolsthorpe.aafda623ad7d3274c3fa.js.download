leOutput()}}</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n')}]),e.exports=n},55013:function(e,t,i){var n="/project/web/woolsthorpe/app/partials/export.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<form ng-submit="export()" name="exportForm" novalidate autocomplete="off">\n  <div class="modal-header">\n    <h4 class="modal-title"><span class="title-description">{{ showLabelForIgnoreExportRulesForContents() | i18next }}</span></h4>\n    <button type="button" class="btn-close" ng-click="cancel()" aria-hidden="true"></button>\n  </div>\n  <div ng-show="!spinner.show" class="modal-body">\n    <p ng-if="!docDetails.canExport" id="export-permission-error" class="alert alert-danger">\n      <span>{{ "You do not have permission to export this item" | i18next }}</span>\n    </p>\n    <p ng-if="(formats.length === 0 && exportError === \'\') || exportError !== \'\'" class="alert alert-info" id="export-error-alert">\n      <a class="float-end" href="{{ helpUrl }}" target="help">\n        <os-svg class="os-help-btn" icon="help-button"></os-svg>\n      </a>\n      <span ng-show="(!isCAMToolPathExport() && formats.length === 0 && exportError === \'\')">{{ "Selected tab contains no supported geometry for export." | i18next }}</span>\n      <span ng-show="exportError !== \'\'">{{ exportError | i18next }}</span>\n    </p>\n    <div ng-show="formats.length > 0 && !noSelectedPartsToExport">\n      <a class="float-end" href="{{ helpUrl }}" target="help">\n        <os-svg class="os-help-btn" icon="help-button"></os-svg>\n      </a>\n      <div class="form-group" ng-if="isCAMToolPathExport()">\n        <label class="control-label">{{ \'Program number\' | i18next }}</label>\n        <input class="form-control" id="export-programname-input" type="number" name="programName" ng-required="true" step ="1" ng-trim="true" min="0" max="{{ CAM_MAX_PROGRAM_NUMBER }}" ng-model="program.name">\n        <span class="text-danger export-filename-error" ng-show="exportForm.programName.$invalid">{{ "Valid program number is required." | i18next }}</span>\n      </div>\n      <div class="form-group">\n        <label class="control-label" ng-if="!isCAMToolPathExport() && isMultiElementExport()">{{ \'Zip file name\' | i18next }}</label>\n        <label class="control-label" ng-if="!isMultiElementExport()">{{ \'File name\' | i18next }}</label>\n        <a class="export-rules-link" ng-if="!isCAMToolPathExport() && shouldShowExportRulesLink()" href="{{ exportRulesSettingsLink }}" target="_blank">{{ "View export rules" | i18next }}</a>\n        <span class="no-space-info" ng-show="options.format.name === \'OBJ\'">{{ "(OBJ names using spaces may not be supported by other systems)" | i18next }}</span>\n        <input class="form-control" id="export-filename-input" type="text" name="fileName" ng-change="onFileNameChangedByUser()" ng-required="true" ng-trim="true" maxlength="{{ MAX_INPUT_LENGTHS.name }}" ng-model="file.name" bt-focus="true">\n        <span class="text-danger export-filename-error" ng-show="exportForm.fileName.$invalid">{{ "Valid file name is required." | i18next }}</span>\n        <span class="text-danger export-filename-error" ng-show="isFileNameWithInvalidChars">{{ getInvalidCharactersInFileNameMessage() }}</span>\n      </div>\n      <div class="form-group" ng-if="isCAMToolPathExport()">\n          <label class="control-label">{{ \'Machine model and post processor\' | i18next }}</label>\n          <input class="form-control" id="export-machinepost-input" ng-disabled="true" type="text" name="machinepostName" ng-trim="true" maxlength="{{ MAX_INPUT_LENGTHS.name }}" ng-model="machinepost.name">\n      </div>\n      <div class="form-group" ng-if="!isCAMToolPathExport()">\n        <label class="control-label">{{ "Format" | i18next }}</label>\n        <select tabindex="1" id="export-format-dropdown" class="form-control" ng-model="options.format"\n                ng-change="onFormatChanged()" ng-options="p.displayName || p.name for p in formats"></select>\n        <label class="csv-export-message" ng-show="options.format.name === \'INSPECTION_LIST\'">{{ "Exported csv file will contain an ordered list of all inspection symbols." | i18next }}</label>\n      </div>\n      <div class="form-check" ng-show="!isCAMToolPathExport() && !isUrdfExport() && isElementNative && options.format.name !== \'INSPECTION_LIST\'">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n        <input id="axis-checkbox" class="form-check-input" type="checkbox" ng-model="options.yAxisIsUp" ng-checked="options.yAxisIsUp">{{ "Export models oriented Y axis up" | i18next }}</label>\n      </div>\n      <div class="form-group" ng-show="isElementNative && options.format.name === \'STEP\' && isStepParasolidPreprocessingEnabled">\n        <label class="control-label">{{ "Preprocessing" | i18next }}</label>\n          <select class="form-control" id="step-parasolid-preprocessing-on-read"  ng-model="options.stepParasolidPreprocessingOption"\n                  ng-options="p.value as p.name for p in stepParasolidPreprocessing"></select>\n      </div>\n      <div class="form-group" ng-show="isElementNative && isUrdfExport()">\n        <label class="control-label">{{ "Geometry format" | i18next }}</label>\n          <select class="form-control" id="urdf-geometry-format-dropdown"  ng-model="options.urdfMeshFormat"\n                  ng-options="p.value as p.name for p in urdfMeshFormatOptions"></select>\n      </div>\n      <div class="form-group" ng-show="isElementNative && options.format.name === \'STEP\'">\n        <label class="control-label">{{ "Version" | i18next }}</label>\n          <select class="form-control" id="step-export-version-dropdown" tabindex="2" ng-model="options.stepVersionString"\n                  ng-options="v for v in stepVersions" ng-disabled="options.useLatestStepVersion" ng-change="updateWarnMeshExport()"></select>\n      </div>\n\n      <div class="form-group" ng-show="i