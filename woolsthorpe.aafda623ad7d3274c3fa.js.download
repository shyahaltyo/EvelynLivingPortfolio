phi = atan(dir.y, dir.x);\n    float theta = acos(dir.z);\n    vec2 latLong = vec2((phi + PI) / TWO_PI, theta / PI);\n\n    // Add map rotation to x coord (convert from [0-2PI] to [0-1]) and\n    // return modulo for continuous rotation.\n    latLong.x = mod(latLong.x + (uMapRotation / TWO_PI), 1.0);\n    return latLong;\n}\n\nvec3 getWorldReflection() {\n    vec3 eyeDir = normalize(-vPosition);\n    vec3 reflectedView = reflect(-eyeDir, normalize(vNormal));\n    return normalize(mat3(uInverseMVMatrix_fs) * reflectedView);\n}\n\n// Blur function based on a simple Gaussian technique. Rather than sampling from a surrounding array of pixels and using\n// the 2D distance to determine weight, it is sampling from concentric circles around the world reflection vector and using\n// the radius of each sample circle as the weight.\nvec4 getBlurredSample() {\n    const int samplePasses = 4;\n    const int samplesPerPass = 4;\n\n    // Distance from the sample pass to the unmodified world reflection. This value was based on experimentation and\n    // manual adjustments. The higher the distance, the more colors blend at the cost of visual sample noise. Low\n    // distance makes more consistent blends but the can look more like anti-aliasing than blurring.\n    float passDistance = 0.005;\n\n    vec3 worldReflection = getWorldReflection();\n    vec4 accumulatedColor = vec4(0.0);\n    float totalWeight = 0.0;\n\n    // Generate coordinate system for varying the normal for blur sampling\n    vec3 helper = abs(worldReflection.x) < 0.99 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);\n    vec3 axis1 = normalize(cross(worldReflection, helper));\n    vec3 axis2 = normalize(cross(worldReflection, axis1));\n\n    // Make pseudorandom seed to offset the pass origin, avoiding visible patterns showing\n    // up in the reflections.\n    float randomSeed = fract(sin(dot(worldReflection.xy, vec2(12.9898,78.233))) * 43758.5453);\n\n    for (int i = 0; i < samplePasses; ++i) {\n        float ringAngle = float(i + 1) * passDistance;\n        // Adjusting constants in this calc affects the weights being applied to each sample\n        float ringWeight =  exp(-0.5 * (ringAngle * ringAngle) / 0.25);\n\n        // Randomize the start angle for each ring to avoid visible patterns\n        float baseAngle = randomSeed * TWO_PI + float(i) * 0.37;\n\n        for (int n = 0; n < samplesPerPass; ++n) {\n            float angle = baseAngle + float(n) * (TWO_PI / float(samplesPerPass));\n            // sample direction on this ring\n            vec3 offsetDir = normalize(\n                worldReflection +\n                axis1 * (cos(angle) * ringAngle) +\n                axis2 * (sin(angle) * ringAngle)\n            );\n\n            vec4 sampleColor = TEXTURE_2D(uEnvironmentTexture, getLatLong(offsetDir));\n            accumulatedColor += (sampleColor * ringWeight);\n            totalWeight += ringWeight;\n        }\n    }\n\n    return accumulatedColor / totalWeight;\n}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    if (uForceDefaultLighting) {\n        FRAG_COLOR = lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n        return;\n    }\n\n    vec4 diffuseColor;\n    if (uEnvironmentBlurEnabled) {\n        diffuseColor = getBlurredSample();\n    } else {\n        diffuseColor = TEXTURE_2D(uEnvironmentTexture, getLatLong(getWorldReflection()));\n    }\n\n    FRAG_COLOR = lightFragment(diffuseColor.rgb, diffuseColor.rgb, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n}\n"},23077:function(e,t){"use strict";t.Z="\n{{{compatibility}}}\n\nDECLARE_FRAG_COLOR\n\nuniform mediump vec4 uViewport;\n\nFRAG_IN lowp vec4 vColor;\nFRAG_IN mediump float vLineWidth;\nFRAG_IN mediump float vDistance;\nFRAG_IN mediump float vLength;\nFRAG_IN mediump float vSilhouetteTest;\nFRAG_IN highp vec3 vPosition;\n\n{{{utilityFunct