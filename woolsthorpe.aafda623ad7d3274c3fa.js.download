r) {\n    // Add the components of the pick id to get a number in the range 0-4\n    float index = pickColor.r + pickColor.g + pickColor.b + pickColor.a;\n    if (index == 0.0) {\n      return vec4(0.0, 0.0, 0.0, 1.0);\n    }\n\n#define modulus 64.0\n\n    // Spread out the range of possible values from 0-4 to a larger range, then mod it to differentiate the number from\n    // other values that were close to it in the 0-4 range.\n    float hashed = mod(index * 12312.0, modulus);\n\n    // Finally, put the hashed number into a 0-1 range and use it for the hue channel in a hsv->rgb function\n    vec3 rgb = hsv2rgb_smooth(vec3(hashed / modulus, 1.0, 1.0));\n    return vec4(rgb, 1.0);\n}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    vec4 color = TEXTURE_2D(uPickBuffer, vTextureCoordinate);\n    FRAG_COLOR = hashColor(color);\n}\n"},93245:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nFRAG_IN vec3 vPositionForSection;\nFRAG_IN FRAGMENT_PRECISION vec2 vPositionZW;\n\n{{{depthNormalFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPositionForSection);\n\n    FRAG_COLOR = packDepthIntoRGBA(vPositionZW[0], vPositionZW[1]);\n}\n"},73348:function(e,t){"use strict";t.Z="\n{{{compatibility}}}\n\nFRAG_IN vec3 vPositionForSection;\nFRAG_IN FRAGMENT_PRECISION vec2 vPositionZW;\n\nDECLARE_FRAG_COLOR\n\n{{{depthNormalFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPositionForSection);\n\n    FRAG_COLOR = packDepthIntoRGBA(vPositionZW[0], vPositionZW[1]);\n}\n"},26910:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nFRAG_IN vec3 vPositionForSection;\nFRAG_IN FRAGMENT_PRECISION vec2 vPositionZW;\n\n{{{depthNormalFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPos