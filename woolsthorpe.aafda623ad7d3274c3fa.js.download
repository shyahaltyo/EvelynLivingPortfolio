engthForDescription} }})\n        <span ng-hide="ctrl.descriptionIsNotHtml" class="text-error"><br/>{{ "Description cannot contain HTML." | i18next}}</span>\n        <textarea rows="4" cols="40" class="form-control" placeholder="{{\'Description\' | i18next}}" ng-model="ctrl.description" ng-change="ctrl.validateTextForCreation()" maxlength="{{ctrl.maxInputLengthForDescription}}"></textarea>\n      </p>\n      <p ng-if="ctrl.showOpenOnCreateCheckbox">\n        <label class="checkbox">\n          <input class="open-on-create" type="checkbox" ng-model="ctrl.openOnCreate"/> {{ "Open new workspace" | i18next}}\n        </label>\n      </p>\n      <p ng-if="ctrl.showPartStudiosOrAssembliesMergeMessage()">\n        <span class="version-or-workspace-dialog-label">{{ "Note:" | i18next}} </span>\n        <span>{{ "Merging feature changes is only supported for Part Studio and Assembly tabs" | i18next}} </span>\n      </p>\n      <p ng-show="!ctrl.isDoneWithOutOfDateCheck">\n        {{ "Checking workspace for out of date tabs…" | i18next }}\n      </p>\n      <p ng-show="ctrl.updatingInProgress">\n        {{ "Updating drawings…" | i18next }}\n      </p>\n      <p ng-show="ctrl.hasOutOfDateElements && ctrl.isDoneWithOutOfDateCheck && !ctrl.updatingInProgress" class="alert alert-warning version-or-workspace-dialog-out-of-date-element-warning">\n        <button class="os-button" type="button" ng-show="ctrl.hasOutOfDateElements && !ctrl.microversionId"\n          ng-disabled="ctrl.updatingInProgress" data-bs-original-title="{{\'Update drawings.\' | i18next}}"\n          ng-click="ctrl.updateOutOfDateDrawings()">\n          <os-svg icon="drawing-update"></os-svg>\n        </button>\n        {{ "These drawings should be updated before creating a version" | i18next }}:\n        <span ng-repeat="element in ctrl.outOfDateElements">\n          <a ng-if="!ctrl.microversionId" href="/documents/{{ctrl.documentId}}/w/{{ctrl.workspaceId}}/e/{{element.id}}" target="_blank">{{element.name}}{{$la