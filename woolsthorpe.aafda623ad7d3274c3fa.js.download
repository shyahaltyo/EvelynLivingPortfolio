tDefinition()">\n                        <a class="dropdown-item" ng-click="configurationTable.editInputDefinition()">{{ "Edit definition…" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getCanEditFeatureScriptIdentifiers()">\n                        <a class="dropdown-item" ng-click="configurationTable.editFeatureScriptIdentifiers()">{{configurationTable.getEditIndentifiersLabel()}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getCanSetCosmetic()">\n                        <a class="dropdown-item" ng-click="configurationTable.setIsCosmetic()">{{ "Exclude from properties" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getCanSetNotCosmetic()">\n                        <a class="dropdown-item" ng-click="configurationTable.setIsNotCosmetic()">{{ "Include in properties" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getCanEditVisibilityConditions()">\n                        <a class="dropdown-item" ng-click="configurationTable.openVisibilityConditionDialog()">{{ "Visibility conditions…" | i18next}}</a>\n                      </li>\n                      <li ng-if="configurationTable.getCanDeleteConfigurationParameter()">\n                        <a class="dropdown-item" ng-click="configurationTable.deleteConfigurationParameter()">{{ "Delete" | i18next}}</a>\n                      </li>\n                    </ul>\n                  </li>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div ng-if="!configurationTablesController.isTableVisible(configurationTable) && configurationTablesController.filteredConfigurationTables.length > 0" class="draggable-header drag-skip" data-parameter-id="{{ configurationTable.parameterId }}"\n          ng-show="!configurationTablesController.shouldHidePlaceholderDiv(configurationTable.parameterId)">\n          <div class="os-no-shrink os-wrap os-justify-between os-table-description" data-bs-original-title="{{ configurationTablesController.getPlaceholderDivTooltip(configurationTable.parameterId) }}">\n            {{ "..." }}\n          </div>\n        </div>\n        <div ng-show="configurationTablesController.isTableVisible(configurationTable) && configurationTable.isExpanded">\n          <os-table ng-if="configurationTable.getHasTable()" resizable="true"\n                    bt-table="configurationTable.btTable" class="os-table-wrapper"\n                    context-menu-manager="configurationTable.contextMenuManager"\n                    highlight-manager="configurationTable.highlightManager"\n                    cell-parameter-manager="configurationTable.cellParameterManager"\n                    add-row-manager="configurationTable.addRowManager"\n                    move-row-manager="configurationTable.moveRowManager"\n                    rename-callback="configurationTable.onColumnRenamed"\n                    validate-name-callback="configurationTable.validateNewColumnName">\n          </os-table>\n          <div ng-if="!configurationTable.getHasTable() && configurationTable.getHasUsages()" class="os-row os-table-wrapper os-configuration-input-usages">\n            <div class="os-table">\n              <div class="os-colgroup-fluid">\n                <div class="os-thead">\n                  <div class="os-tr">\n                    <div class="os-th table-cell--header">\n                      <div class="column-header-text"><strong>{{ \'Usages\' | i18next}}</strong></div>\n                      <div class="badge rounded-pill">{{configurationTable.getUsageCount()}}</div>\n                    </div>\n                  </div>\n                </div>\n                <div class="os-tbody">\n                  <div class="os-tr" ng-repeat="usage in configurationTable.btTable.getTableColumns()">\n                    <div os-robust-hover-highlight-elem