e\' | i18next}}</div>\n                          <div class="small text-muted permission-name-text">{{option.displayPermissionName}}</div>\n                        </div>\n                      </ui-select-choices>\n                    </ui-select>\n                  </span>\n                  <span>\n                    <button type="button" class="btn btn-primary os-project-role-invite-btn float-end" ng-click="ctrl.addGuestUserListToRoleMap()" ng-disabled="!ctrl.isGuestUserEmailsValid()">{{"Invite" | i18next}}</button>\n                  </span>\n                </div>\n                <div>\n                  <p class="helper-text">{{ "Add multiple users by entering emails separated by comma or space" | i18next}}</p>\n                </div>\n                <div class="guests-share-message text-muted small">\n                  <span>{{"Inviting a guest will add them to your enterprise. Guests have access only to data shared directly with them." | i18next}}</span>\n                </div>\n              </div>\n              <div ng-if="ctrl.canInviteGuests() && ctrl.availableSeats < 1" class="form-group os-project-role-input-container">\n                <div class="invite-guests-not-allowed">{{"No subscriptions available to invite guests. Contact your administrator if you need to share data with people outside your enterprise." | i18next}}</div>\n              </div>\n              <div ng-if="!ctrl.canInviteGuests()" class="form-group os-project-role-input-container">\n                <div class="invite-guests-not-allowed">{{"You do not have permission to share data with guests. Contact your administrator if you need to share data with people outside your enterprise." | i18next}}</div>\n              </div>\n            </div>\n            <div class="os-project-role-list-container">\n              <div ng-repeat="roleEntry in ctrl.project.roleMapEntries">\n                <div class="os-row os-project-role-entry" ng-repeat="identity in roleEntry.identities">\n  