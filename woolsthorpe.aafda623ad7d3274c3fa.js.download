ck="changeSort(predicate)"\n              ng-repeat="predicate in predicates">\n            <span>{{predicate.label}}</span>\n          </li>\n        </ul>\n      </div>\n      <button class="os-button os-clear tab-manager-filter-button"\n              ng-class="{\'os-active\': getViewState(\'filterButtonsVisible\')}"\n              ng-click="setViewState(\'filterButtonsVisible\', \'toggle\')"\n              data-bs-original-title="{{TabCtrl.displayText.filterText}}">\n        <os-svg ng-if="!TabCtrl.someFilterActive()" icon="filter-results-button"></os-svg>\n        <os-svg ng-if="TabCtrl.someFilterActive()" icon="filter-collapsed-button"></os-svg>\n      </button>\n      <div class="view-icons">\n        <os-svg class="view-icon"\n                icon="view-list"\n                ng-click="setViewState(\'tabs\', \'list-view\')"\n                ng-class="{\'active\': view.tabs === \'list-view\'}"\n                data-bs-original-title="{{(\'List view\' | i18next)}}"></os-svg>\n        <os-svg class="view-icon"\n                icon="view-card"\n                ng-click="setViewState(\'tabs\', \'card-view\')"\n                ng-class="{\'active\': view.tabs === \'card-view\'}"\n                data-bs-original-title="{{\'Detail view\' | i18next}}"></os-svg>\n      </div>\n      <os-svg class="document-panel-close" icon="close-x" ng-click="TabCtrl.close()"></os-svg>\n    </div>\n  </div>\n\n  \x3c!-- Controls --\x3e\n  <div class="os-control-container tab-search-controls"\n       ng-class="{ \'remove-controls-padding\': removeControlsPadding(), \'remove-controls-border\': removeControlsBorder() }">\n    <div class="os-control-row tab-manager-search-bar-container" ng-show="getViewState(\'searchVisible\')">\n      <os-search-box class="os-search-box-container os-field os-grow "\n                     search-text="filters.searchText"\n                     placeholder="searchPlaceholder"\n                     initially-focused="false">\n      </os-search-box>\n    </d