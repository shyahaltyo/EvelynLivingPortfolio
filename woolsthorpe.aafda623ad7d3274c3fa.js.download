at\n    [use-decimal-comma]="$ctrl.useDecimalComma"\n    (update-user-settings)="$ctrl.updateUserSettings($event.params, $event.successMessage, $event.failureMessage)">\n  </osx-preference-decimal-format>\n\n  \x3c!-- Startup page section --\x3e\n  <div class="user-profile-section-header" ng-if="$ctrl.isEnterprise()">\n    <h4>{{ "Startup page" | i18next }}</h4>\n  </div>\n  <div class="user-settings" ng-if="$ctrl.isEnterprise()">\n    <osx-startup-page\n      [startup-page]="$ctrl.startupPage"\n      [startup-page-message]="$ctrl.startupPageMessage"\n      (update-startup-page)="$ctrl.updateStartupPage($event)">\n    </osx-startup-page>\n  </div>\n\n  \x3c!-- Unit section --\x3e\n  <div class="user-profile-section-header">\n    <h4>{{ "Units" | i18next }}</h4>\n  </div>\n  <div class="user-profile-sub-section">\n    <span>{{\'Change the default units for all newly created documents. Units for existing documents are not changed.\' | i18next}}\n      <a href="{{$ctrl.helpUrl}}" target="_blank">{{\'Learn more about default units.\' | i18next}}</a>\n    </span>\n  </div>\n  \x3c!-- Default Unit and precision section --\x3e\n  <div class="user-settings">\n    <div class="os-form-container">\n      <form class="form-horizontal" ng-submit="$ctrl.updateUserUnitAndDisplayPrecision()">\n        <osx-system-units\n          [is-for-user-settings]="true"\n          [is-for-new-user-setup]="false"\n          [user-settings]="$ctrl.userSettings"\n          (on-unit-change)="$ctrl.onUnitChange($event)"\n          (on-precision-change)="$ctrl.onPrecisionChange($event)">\n        </osx-system-units>\n        <div>\n          <table class="os-units-display-precision-table">\n            <tbody>\n            \x3c!-- Time format --\x3e\n            <tr>\n              <td class="os-units-display-heading">\n                <label>{{"Time format" | i18next}}</label>\n              </td>\n            </tr>\n            <tr>\n              <td class="os-units-display">\n                <select class="form-control" id="userAccountSettings-time-format-new"\n                        ng-model="$ctrl.use24HourTime"\n                        ng-options="o.value as o.label for o in $ctrl.timeFormatOptions">\n                </select>\n              </td>\n            </tr>\n            \x3c!-- end of time format options --\x3e\n            </tbody>\n          </table>\n        </div>\n        <div class="os-form-group">\n          <div class="os-units-display-precision-save">\n            <button ng-disabled="!$ctrl.getCanSaveUnitsAndPrecision()" class="btn btn-primary" id="btn-user-settings-save-units">{{ "Save changes" | i18next}}</button>\n          </div>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <osx-preference-mouse-controls\n    (update-user-settings)="$ctrl.updateUserSettings($event.params, $event.successMessage, $event.failureMessage, $event.isNewUserWalkthrough)">\n  </osx-preference-mouse-controls>\n\n  \x3c!-- Environment Profile --\x3e\n  <osx-preference-environment-profile></osx-preference-environment-profile>\n\n  \x3c!-- Assembly settings section --\x3e\n  <osx-preference-assembly-settings\n    [display-assembly-properties]="$ctrl.displayAssemblyProperties"\n    (update-user-settings)="$ctrl.updateUserSettings($event.params, $event.successMessage, $event.failureMessage)">\n  </osx-preference-assembly-settings>\n</div>\n\n<div class="user-settings-section-header" os-focus-view="customize-keyboard-shortcuts">\n  <h4 class="os-user-preference-inline-heading">{{"Keyboard shortcuts" | i18next}}</h4>\n  <div class="popover-container">\n    <span class="os-user-preference-info os-question-mark"\n          popover-trigger="\'mouseenter\'"\n          popover-append-to-body="true"\n          uib-popover=\'{{"Customize your keyboard shortcuts by clicking the pencil icon. If a shortcut combination contains operating system specific keys, this may result in unexpected behavior in different operating systems." | i18next}}\'\n          popover-placement="right">\n    </span>\n  </div>\n</div>\n<div class="user-settings">\n  <div class="os-form-container">\n    <customize-shortcuts class="os-row"></customize-shortcuts>\n  </div>\n</div>\n\n\x3c!-- mini toolbars --\x3e\n<div class="user-profile-section-header" id="mini">\n  <h4>{{"Shortcut toolbars" | i18next}}</h4>\n</div>\n<div class="user-settings">\n  <div class="os-form-container">\n    <form class="form-horizontal" ng-submit="$ctrl.updateShortcutToolbar()">\n      <div class="os-mini-toolbar-context-selection">\n        <select class="form-control"\n                ng-model="$ctrl.selectedMiniToolbarContext"\n                ng-change="$ctrl.setMiniToolbarCommands()"\n                ng-options="(setting.tabType | i18next) for setting in $ctrl.miniToolbarSettings">\n        </select>\n      </div>\n      <div class="os-mini-toolbar-commands-list float-start">\n          <div ng-repeat="commandSet in [$ctrl.selectedMiniToolbarContextCommands, $ctrl.selectedMiniToolbarContextGeneralCommands]">\n            <div class="mini-toolbar-settings-divider" ng-if="commandSet.length && !$first">\n              <hr class="left"/><span class="mini-toolbar-settings-divider-text">{{"General" | i18next}}</span><hr class="right" />\n            </div>\n            <span ng-repeat="command in commandSet">\n              <label class="os-mini-toolbar-commands-entries" ng-class="{\'os-mini-toolbar-commands-show\': command.display}">\n                <input type="checkbox" ng-model="command.display" ng-change="$ctrl.miniToolbarCheckboxChecked()" icon="{{command.icon}}" />\n                <os-svg ng-if="command.icon" icon="{{command.icon}}"></os-svg>\n                <span ng-if="command.iconInitials" class="os-tool-initials-icon">\n                  {{command.iconInitials}}\n                </span>\n                <span>{{(command.name) | i18next}}</span>\n              </label><br/>\n            </span>\n          </div>\n      </div>\n      <div class="os-mini-toolbar-preview">\n        <div class=\'os-mini-toolbar\'>\n          <div class="expanded-tool os-tool-item" ng-show="command.display" ng-repeat="command in $ctrl.selectedMiniToolbarContext.commands">\n            <div class="os-tool-button os-toolbar-button">\n              <div class="os-tool-command">\n                <div class="os-tool-command-icon" >\n                  <os-svg ng-if="command.icon" icon="{{command.icon}}"></os-svg>\n                  <span ng-if="command.iconInitials" class="os-tool-initials-icon">\n                    {{command.iconInitials}}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div ng-if="$ctrl.areCommandsEmptyForAContext($ctrl.selectedMiniToolbarContext)" class="os-mini-toolbar-empty-command">\n            <spa>{{"No tools added" | i18next}}</spa>\n          </div>\n        </div>\n      </div>\n      <div class="os-form-group">\n        <div>\n          <button ng-disabled="!$ctrl.miniToolbarDefinitionChanged || $ctrl.processingShortcutUpdate"\n                  class="btn btn-primary text-nowrap os-mini-toolbar-save-button">\n            {{ "Save shortcut toolbar settings" | i18next}}\n          </button>\n        </div>\n      </div>\n    </form>\n  </div>\n</div>\n\n<div>\n  <div class="user-profile-section-header">\n    <h4>{{\'Toolbars\' | i18next}}</h4>\n  </div>\n  <div class="user-settings">\n    <div class="os-form-container">\n      <button class="btn btn-primary" type="button" ng-disabled="$ctrl.processingResetToolbars" ng-click="$ctrl.resetCustomToolbars()">{{\'Reset to defaults\' | i18next}}</button>\n    </div>\n  </div>\n</div>\n\n\x3c!-- Drawings settings --\x3e\n<osx-preference-drawings\n  [drawing-background-mapping-choice-id]="$ctrl.drawingBackgroundMappingChoiceId"\n  (update-user-settings)="$ctrl.updateUserSettings($event.params, $event.successMessage, $event.failureMessage)">\n</osx-preference-drawings>\n\n\x3c!-- Material libraries --\x3