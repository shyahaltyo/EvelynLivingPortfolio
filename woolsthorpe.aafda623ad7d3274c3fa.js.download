ss="errorMessage error-no-name text-danger"\n        ng-show="eduRenewalForm.educationType.$error.required">{{ "This field is required." | i18next}}</span>\n      </div>\n    </div>\n    <div class="os-form-group width-2x">\n      <p>{{ "School level" | i18next}}</p>\n      <div>\n        <select class="form-control" ng-model="$ctrl.state.options.schoolLevel" name="schoolLevel" required>\n              <option disabled="" selected="" value="">- {{"School level" | i18next}} -</option>\n              <option value="Grade school (K-12)">{{"Grade school (K-12)" | i18next}}</option>\n              <option value="College or University">{{"College or University" | i18next}}</option>\n        </select>\n      <span class="text-danger errorMessage error-no-name"\n        ng-show="eduRenewalForm.schoolLevel.$error.required">{{ "School level is required." | i18next}}</span>\n      </div>\n    </div>\n    <div class="os-form-group width-2x" ng-if="$ctrl.state.options.educationType === \'Student\'">\n      <p>{{ "Graduation year" | i18next}}</p>\n      <div>\n        <select class="form-control" name="graduationYear" ng-model="$ctrl.state.options.graduationYear" required>\n        <option disabled="" selected="" value="">- {{"Graduation year" | i18next}} -</option>\n        <option ng-repeat="gradYear in $ctrl.state.graduationYears" value="{{gradYear}}">{{gradYear}}</option>\n        </select>\n      <span class="errorMessage error-no-name text-danger" ng-show="eduRenewalForm.graduationYear.$error.required">{{\n        "Graduation year is required." | i18next}}</span>\n\n      </div>\n    </div>\n    <div class="os-form-group wide-form-group">\n      <div class="consent-checkbox">\n        <label for="educationConsentAccepted" id="education_consent_text">\n          <input type="checkbox" ng-model="$ctrl.state.options.educationConsentAccepted" name="educationConsentAccepted"\n            required id="educationConsentAccepted" />\n          <span class="os-radio-or-checkbox-text"