need attention\' | i18next}}"\n    ><os-svg icon="list-error-inside"></os-svg></button>\x3c!-- prevent whitespace\n    --\x3e<button type="button" class="btn btn-sm btn-secondary overflow" data-bs-toggle="dropdown">\n      <os-svg icon="overflow"></os-svg>\n    </button>\n    <ul class="dropdown-menu dropdown-menu-end" menu-width="none">\n      <li><button class="btn dropdown-item" type="button" ng-click="ctrl.openAuditLogInNewTab()">{{\'View audit log\' |\n          i18next}}</button></li>\n      <li><button class="btn dropdown-item" type="button" ng-click="toggleWorkflowDiagram($event)"\n          ng-if="!ctrl.candidate.workflow.isDiscarded && workflowDefinition">{{\'View workflow\' | i18next}}</button></li>\n    </ul>\n  </div>\n  <span class="is-discarded badge badge-secondary rounded-pill" ng-if="ctrl.candidate.workflow.isDiscarded">{{\'Discarded\' | i18next}}</span>\n</div>\n<form name="releaseForm" class="release-form" autocomplete="off" novalidate="novalidate" ng-model-options="{updateOn: \'default blur\', debounce: {\'default\': 300, \'blur\': 0} }" ng-class="{\'editing-release\': !ctrl.editingAllProperties, \'is-setup\': ctrl.candidate.isSetup}">\n  <os-spinner ng-class="{\'loading-metadata\': spinner.show}" spinner="spinner" min-duration="200"></os-spinner>\n  \x3c!-- root, contains top and bottom --\x3e\n  <os-layout os-axis="y" resize-last="true" os-disabled="{{panels.root.disabled}}" class="layout-root">\n    \x3c!-- top contains left and right --\x3e\n    <os-layout class="top-row" os-axis="x" os-disabled="{{panels.top.disabled}}" on-resize="onResize()" os-min-size="150" os-size="false">\n      \x3c!-- trees when comments aren\'t visible --\x3e\n      <os-layout class="metadata-item-selector" ng-if="ctrl.doShowTree()" os-hidden="{{panels.trees.hidden}}" os-min-size="280" os-size="32%" storage-id="{{panels.trees.storageId}}">\n        <div class="os-col os-grow" ng-class="{\'no-scroll\': !ctrl.editingAllProperties && !ctrl.isAddingItems}">\n          <div class="os-control-container search-controls">\n            <div class="os-control-row" ng-if="showSearchUi">\n              <div class="os-search-box-container os-field os-grow">\n                <input\n                  type="text"\n                  class="os-search-box-input os-grow"\n                  ng-change="onSearchTextChange()"\n                  ng-model-options="{debounce: 300}"\n                  ng-model="filters.searchText"\n                  ng-disabled="ctrl.errorFilterManager.active || ctrl.editorMode === 0 && ctrl.isFormInvalid(releaseForm)"\n                  placeholder="{{\'Search\' | i18next}}"\n                >\n                <a class="os-search-box-clear-button" ng-show="!!filters.searchText" ng-click="clearSearch()" data-bs-original-title="{{\'Clear search\' | i18next}}">\n                  <os-svg icon="clear-field-button"></os-svg>\n                </a>\n              </div>\n              <button type="button"\n                      class="toggle-filters os-button os-clear os-pin-center"\n                      ng-show="itemTypes.all.length > 1"\n                      ng-click="toggleFilters()"\n                      ng-class="{\'os-active\': filtersVisible}"\n                      data-bs-original-title="{{\'Toggle filters\' | i18next}}"\n                      data-bs-placement="top">\n                <div class="button-content" ng-if="!filtersActive() || filtersVisible">\n                  <os-svg icon="filter-results-button" class="os-icon wide-icon"></os-svg>\n                </div>\n                <div class="button-content" ng-if="!filtersVisible && filtersActive()">\n                  <os-svg icon="filter-collapsed-button" class="os-icon wide-icon"></os-svg>\n                </div>\n              </button>\n              <div class="add-to-release-spacer" ng-if="itemTypes.all.length > 1 && ctrl.canAddItems()"></div>\n              <button type="button"\n                      class="os-button os-clear add-all-drawings-btn"\n                      ng-if="ctrl.shouldShowAddAllDrawingsButton()"\n                      ng-click="ctrl.handleAddDrawingsClick()"\n                      ng-class="{\'os-active\': ctrl.candidate.addAllDrawingsActive}"\n                      ng-disabled="ctrl.changeDetectionInProgress"\n                      data-bs-original-title="{{\'Include associated drawings\' | i18next}}"\n              >\n                <os-svg icon="release-drawings"></os-svg>\n              </button>\n              <button type="button"\n                      class="os-button os-clear add-items-btn"\n                      ng-if="!ctrl.isAddingItems && ctrl.canAddItems()"\n                      ng-click="ctrl.showAddItems()"\n                      data-bs-original-title="{{ctrl.getPlusButtonTooltip()}}"\n              >\n                <os-svg icon="plus-button"></os-svg>\n              </button>\n            </div>\n            <div class="os-row os-wrap search-filters" ng-show="filtersVisible && itemTypes.all.length > 1 && !isFilteredSelection()">\n              <div class="os-control-row os-grow">\n                <div class="os-row os-grow os-wrap filter-buttons">\n                  <button type="button"\n                          ng-repeat="type in itemTypes.all"\n                          ng-class="{\'os-active\': (type.active)}"\n                          ng-click="toggleTypeFilter(type.label)"\n                          class="os-button os-clear"\n                          data-bs-original-title="{{type.label}}"\n                          ng-disabled="ctrl.errorFilterManager.active || ctrl.editorMode === 0 && ctrl.isFormInvalid(releaseForm)"\n                          data-bs-placement="bottom">\n                    <div class="button-content">\n                      <os-svg icon="{{type.iconUrl}}" class="button-icon" alt="{{type.label}}"></os-svg>\n                    </div>\n                  </button>\n                </div>\n                <button type="button"\n                        ng-click="clearFilter()"\n                        ng-disabled="!filters.active.length || ctrl.editorMode === 0 && ctrl.isFormInvalid(releaseForm)"\n                        class="btn btn-sm btn-secondary me-2">\n                  <span>{{::(\'Clear\' | i18next)}}</span>\n                </button>\n              </div>\n            </div>\n          </div>\n          <div class="tree-container os-col">\n            <release-tree\n              nodes="ctrl.candidate.items"\n              can-item-be-removed="ctrl.candidate.canItemBeRemoved(node)"\n              active-workflow="ctrl.activeWorkflow"\n              should-show-item-version-icon="ctrl.shouldShowItemVersionIcon(node)"\n              filters="filters"\n              disabled="ctrl.editorMode === 0 && ctrl.isFormInvalid(releaseForm)"\n              is-selectable="ctrl.editingAllProperties"\n              form-ctrl="releaseForm"\n              inner-tmpl-url="\'/project/web/ts/release-management/inner-node.html\'"\n              clear-all="clearAll()"\n              get-more="ctrl.getMore(item)"\n              tree-ready="ctrl.onTreeReady()"\n              no-deselect-all="ctrl.requireSelection"\n              remove-node="ctrl.removeItem(node, true)"\n              class="document-tab-list tab-tree"\n              rebuild-event="rebuildMetadataTree"\n              has-config-tooltips="ctrl.hasConfigurationParams"\n              should-highlight-item="ctrl.shouldHighlightItem(item)"\n              style="margin-right: -{{scrollbarWidth}}px"\n              scroll-sync="{selector: \'releasable-property-sheet .table-body-wrap\', syncY: true, twoWay: true, disabled: ctrl.editingAllProperties}"\n              is-obsoletion-workflow="ctrl.isObsoletionWorkflow"\n            ></release-tree>\n          </div>\n        </div>\n      </os-layout>\n\n      <os-layout os-hidden="{{panels.selectItem.hidden}}" os-size="400px">\n        <div class="insert-item-container" ng-show="ctrl.isAddingItems">\n          <div class="insert-item-holder"></div>\n        </div>\n      </os-layout>\n\n      \x3c!-- property sheets --\x3e\n      <os-layout\n        os-hidden="{{panels.sheets.hidden}}"\n        os-min-size="25%"\n        os-size="false"\n        data-layout-id="property-sheet-panel"\n      >\n        <releasable-property-sheet\n          ng-if="!ctrl.editingAllProperties"\n          class="releasable-metadata-panel"\n          items="ctrl.selected.releaseItems"\n          editor="ctrl.editor"\n          placeholders="placeholders"\n          form-ctrl="releaseForm"\n          is-visible="ctrl.isItemVisible(item)"\n          on-change="ctrl.onPropertyChange(propertyId, value, itemId, modifyPreviousUpdate)"\n          validate="ctrl.validate(propertyId, value, itemId)"\n          hide-metadata-toggle="ctrl.isObsoletionWorkflow"\n          show-transition-arrow="!ctrl.isObsoletionWorkflow"\n          change-detection-enabled="ctrl.changeDetectionEnabled()"\n          change-detection-in-progress="ctrl.changeDetectionInProgress"\n          revert-unchanged="ctrl.revertUnchanged(items)"\n          part-number-val-gen-config="ctrl.partNumberGenConfig"\n          active-workflow="ctrl.activeWorkflow"\n          gen-part-nums="ctrl.genPartNumbers(items, skip)"\n          is-setup="ctrl.candidate.isSetup"\n          ordering="ctrl.ordering"\n          column-names="ctrl.columnNames"\n          should-highlight-item="ctrl.shouldHighlightItem(item)"\n          drawing-can-duplicate-part-number="ctrl.drawingCanDuplicatePartNumber"\n          company-policies="ctrl.companyPolicies"\n          uses-external-plm="ctrl.candidate.workflow.usesExternalPlm"\n          company-id="ctrl.companyId"\n          is-obsoletion-workflow="ctrl.isObsoletionWorkflow"\n        >\n        </releasable-property-sheet>\n        <metadata-property-sheet\n          ng-if="ctrl.editingAllProperties"\n          property-editable="ctrl.isItemPropertyEditable(prop)"\n          selected="ctrl.selected"\n          editor="ctrl.editor"\n          on-btn-click="ctrl.onPropertySheetBackBtn()"\n          btn-disabled="ctrl.isFormInvalid(form)"\n          icon-name="back-tab"\n          show-btn="true"\n          show-edit-path="true"\n          btn-title="\'Back to Release properties\' | i18next"\n          form-ctrl="releaseForm"\n          placeholders="placeholders"\n          skip-props="ctrl.propsToExclude"\n          on-change="ctrl.onPropertyChange(propertyId, value)"\n          has-load-failure="ctrl.failedToRetrieveMetadataProperties"\n          company-id="ctrl.companyId"\n          document-id="ctrl.documentId"\n          is-version="!ctrl.candidate.workspaceId"\n          wv-id="ctrl.candidate.workspaceId ? ctrl.candidate.workspaceId : ctrl.candidate.versionId"\n          fetch-computed="ctrl.loadComputed()"\n        ></metadata-property-sheet>\n      </os-layout>\n\n      <os-layout ng-if="!panels.selectItem.hidden" os-disabled="true" class="select-item-column">\n        <selected-item ng-if="ctrl.isAddingItems" additions="ctrl.additions.additions" deselect="ctrl.additions.deselect(item)" os-disabled="true"></selected-item>\n      </os-layout>\n\n      <os-layout ng-if="!panels.comments.hidden">\n        <div class="release-comments-view">\n          \x3c!-- The metadata-edit-path class has css for a header with a back button --\x3e\n          <div class="metadata-edit-path">\n            <h4>\n              <button class="os-button" ng-click="ctrl.setShowingComments(false)" data-bs-original-title="{{\'Back to Release properties\' | i18next}}">\n                <os-svg icon="back-tab"></os-svg>\n              </button>\n              <span>&nbsp;{{\'Comments\' | i18next}}</span>\n            </h4>\n          </div>\n          <div class="release-comments">\n            <metadata-property\n              prop="ctrl.getCommentProp()"\n              item="ctrl.candidate"\n              ctrl="ctrl.commentCtrl"\n              metadata-form="::releaseForm"\n            ></metadata-property>\n            <comment-list\n              comments="ctrl.candidate.comments"\n              readonly="true"\n              no-replies="true"\n            ></comment-list>\n            <os-disclosure class="parent-comments" ng-repeat="parent in ctrl.candidate.parentComments">\n              <os-disclosure-title>\n                <div class="parent-comments-header">\n                  <div class="parent-comments-title">{{ "Comments from __parentName__" | i18next:{parentName: parent.rpName} }}</div>\n                  <button class="btn btn-link parent-comments-link" ng-click="ctrl.changeToRelease(parent.rpId)">{{ "View release" | i18next }}</button>\n                </div>\n              </os-disclosure-title>\n              <os-disclosure-content>\n                <comment-list\n                  comments="parent.comments"\n                  readonly="true"\n                  no-replies="true"\n                >\n                </comment-list>\n              </os-disclosure-content>\n            </os-disclosure>\n          </div>\n        </div>\n      </os-layout>\n    </os-layout>\n\n    <os-layout\n      os-hidden="{{panels.bottom.hidden}}"\n      os-size="180px"\n      os-min-size="150px"\n      storage-id="{{panels.bottom.storageId}}"\n    > \x3c!-- bottom half  os-size="168px" --\x3e\n      <div class="release-package-panel">\n        <release-package-property-sheet\n          class="container-fluid"\n          form-ctrl="releaseForm"\n          placeholders="placeholders"\n          candidate="ctrl.selected.candidate"\n          on-change="ctrl.onPropertyChange(propertyId, value, itemId)"\n          opened-for-setup="ctrl.candidate.isSetup"\n          ng-if="ctrl.selected.candidate"\n          show-full-comments="ctrl.toggleComments"\n        >\n        </release-package-property-sheet>\n      </div>\n    </os-layout>\n  </os-layout>\n\n  <div class="modal-footer">\n    <div ng-if="!ctrl.isAddingItems" class="os-row footer-row flex-fill">\