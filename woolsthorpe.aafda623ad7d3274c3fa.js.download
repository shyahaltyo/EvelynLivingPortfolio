Edge()">\n              <img ng-src="/images/arrow-right.svg"/>\n            </span>\n          </div>\n          <div class="os-flex-col os-item-auto-version" ng-if="!ctrl.isFilterHistoryMode"></div>\n          <div class="os-flex-col os-item-workspace-or-version-name" ng-if="!ctrl.isFilterHistoryMode">\n            <span>{{ "Name" | i18next}}</span></div>\n          <div class="os-flex-col os-item-workspace-or-version-description"\n               ng-class="{\'history-search-results-header\': ctrl.isFilterHistoryMode}"\n               ng-if="!insideDocumentDetailPane || ctrl.isFilterHistoryMode">\n            <span>{{ "Description" | i18next}}</span>\n          </div>\n          <div class="os-flex-col os-item-modified-by" ng-show="!ctrl.isFilterHistoryMode">\n            <span>{{ "Modified" | i18next}}</span></div>\n          <div class="os-flex-col os-item-modified-date"\n               ng-class="{\'history-search-results-header\': ctrl.isFilterHistoryMode}"\n               ng-if="!insideDocumentDetailPane || ctrl.isFilterHistoryMode">\n            <span>{{ "Modified by" | i18next}}</span>\n          </div>\n          <div class="os-flex-col os-item-workspace-or-version-actions" ng-if="!insideDocumentDetailPane"></div>\n        </div>\n\n        \x3c!-- Table body --\x3e\n        <div class="versions-history-table-body">\n          <div ng-repeat="graphItem in ctrl.getDisplayedGraphItems()" ng-class="{selected: graphItem.isSelected(),\n                      \'click-disabled\': isLoadingMoment,\n                      \'compare-target\': graphItem.isCompareTarget(),\n                      \'separator\': graphItem.isSeparator(),\n                      \'change\': graphItem.isChange() || graphItem.isMoreFilteredRecords(),\n                      \'branch-point\': graphItem.isBranchPoint(),\n                      \'collapsed-changes\': graphItem.isCollapsedChanges(),\n                      \'no-filter-results\': graphItem.isNoFilterResults(),\n                      \'history-search-result\': ctrl.isFilterHistoryMode,\n                      \'nonloaded-changes\': graphItem.isNonloadedChanges()}"\n               class="os-flex-table-row"\n               ng-mouseover="setChangeHovered(graphItem, true)"\n               ng-mouseleave="setChangeHovered(graphItem, false)"\n               os-context-menu="getActionMenu(graphItem)"\n               os-context-menu-close-event="COLLAPSE_FLYOUT"\n               data-bs-html="true"\n               data-bs-original-title="{{getShortTooltip(graphItem)}}"\n               data-bs-expanded-content="{{graphItem.getExpandedTooltip()}}"\n               data-bs-placement="{{insideDocumentDetailPane ? \'left\' : \'right\'}}"\n               tooltip-expand-delay="0">\n            <div class="os-flex-col os-item-workspace-or-version-graph"\n                 ng-if = "!ctrl.isFilterHistoryMode"\n                 style="flex: 0 0 {{getSvgContainerWidth(graphItem)}}px; -webkit-flex: 0 0 {{getSvgContainerWidth(graphItem)}}px"\n                 ng-click="setWorkspaceOrVersionSelected(graphItem)"></div>\n            <div class="os-flex-col os-item-auto-version"\n                 ng-if="graphItem.isChainUpdateVersion()"\n                 ng-click="setWorkspaceOrVersionSelected(graphItem)">\n              <os-svg icon="auto-version"/>\n            </div>\n            \x3c!-- Name --\x3e\n            <div ng-if="graphItem.isWorkspace()"\n                 class="os-flex-col os-item-workspace-or-version-name"\n                 ng-click="setWorkspaceOrVersionSelected(graphItem)">\n              <span class="workspace-name workspace-or-version-name {{graphItem.getBranchColorClass()}}">\n                <span ng-if="graphItem.isLocked()">\n                  <os-svg icon="lock-icon_static" class="branch-lock-icon"></os-svg>\n                </span>\n                {{graphItem.name}}\n              </span><br>\n              <span class="change-details"\n                    ng-click="toggleWorkspaceOrVersionExpanded($ev