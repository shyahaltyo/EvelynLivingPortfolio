lass="link view" ng-click="$ctrl.handleViewBtnClick($event, $ctrl.getObsoletionPackageId(rev), rev)" ng-if="::(rev.isObsolete)">{{ 'View obsoletion' | i18next }}</a>\n          </div>\n          <div class="alert alert-danger revision-alert" ng-if="!!rev.errorMessage">{{ rev.errorMessage }}</div>\n          <div class="package-info">\n            <div class="title">{{"Release name" | i18next}}</div>\n            <div class="rev os-row">\n              <span class="ellipseOverflowText">{{::rev.releaseName}}</span>\n              <a class="link" ng-click="$ctrl.handleViewBtnClick($event, rev.releaseId, rev)">{{ 'View release' | i18next }}</a>\n            </div>\n          </div>\n          <div class="package-info">\n            <div class="title" ng-if="rev.approvers && rev.approvers.length > 0">\n              {{"Approved by" | i18next}}\n            </div>\n            <div style="margin-bottom: 5px;"\n              ng-repeat="approver in rev.approvers">\n              <div class="rev ellipseOverflowText">\n                <span>{{::($ctrl.getUserPrettyName(approver))}}</span>\n              </div>\n              <div class="rev">{{::approver.date | prettyDate}}</div>\n            </div>\n            <div class="title">{{"Submitted by" | i18next}}</div>\n            <div class="rev ellipseOverflowText">\n              <span>{{::($ctrl.getUserPrettyName(rev.releasedBy))}}</span>\n            </div>\n            <div class="rev">{{::rev.createdAt | prettyDate}}</div>\n          </div>\n          <div class="package-info" ng-if="::rev.description">\n            <div class="title">{{ "Revision description" | i18next }}</div>\n            <os-show-more class="rev rev-multiline" message="::rev.description" char-limit="100"></os-show-more>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n`.trim(),bindings:{compact:"<",inPanel:"<",hideObsolete:"<",message:"<",selectedItem:"<",revisions:"<",rowClass:"<",revisionTitleClass:"<",revisionSubtitleClass:"<"