e.configurationParameterNameBtParameter.getPendingStringValue()}}</span>\n                <div class="title-parameter"\n                    ng-class="{\'configuration-parameter-variable-name\': !configurationTable.getHasTable()}"\n                    os-parameter="configurationTable.configurationParameterNameBtParameter">\n                </div>\n              </div>\n              <div class="configuration-parameter-variable-id-name os-param-not-editing" ng-if="configurationTable.getHasTable()">\n                <span class="default-value-text" data-bs-original-title="{{configurationTable.configurationParameter.getDefaultValueText()}}">\n                  {{configurationTable.configurationParameter.getDefaultValueText()}}\n                </span>\n              </div>\n            </div>\n            <div class="os-table-header-responsive-last-row">\n              <div class="configuration-parameter-variable-id-name os-param-not-editing" ng-if="!configurationTable.getHasTable()">\n                <span class="configuration-parameter-variable-id-text">\n                  (#{{configurationTable.parameterId}})\n                </span>\n                <span class="default-value-text" data-bs-original-title="{{configurationTable.configurationParameter.getDefaultValueText()}}">\n                  {{configurationTable.configurationParameter.getDefaultValueText()}}\n                 </span>\n              </div>\n              <div ng-if="configurationTable.getHasTable()" class="os-configuration-table-button">\n                <button ng-if="configurationTable.getShouldShowConfigureFeaturesButton()"\n                        type="button"\n                        class="btn btn-secondary btn-sm small-secondary-btn os-configure-features-btn ellipseOverflowText"\n                        ng-click="configurationTablesController.configureFeatures(configurationTable)"\n                        ng-disabled="configurationTable.getIsConfiguringFeaturesForThisConfiguration()"\n                        data-bs-original-title="{{ configurationTablesController.getConfigureFeatureModeButtonTooltip() }}"\n                        data-bs-placement="bottom">\n                  <os-svg icon="add-button"></os-svg>{{configurationTablesController.getConfigureFeatureButtonLabel()}}\n                </button>\n              </div>\n              <div class="d-flex">\n                <div ng-if="configurationTable.getCanShowVisibilityConditionIcon()"\n                  class="os-no-shrink d-flex align-items-center show-visibility-condition-icon"\n                  data-bs-original-title="{{ configurationTable.getVisibilityConditionTooltip() }}" data-bs-placement="bottom">\n                  <a ng-click="configurationTable.openVisibilityConditionDialog()">\n                    <os-svg icon="configuration-visibiliity"/>\n                  </a>\n                </div>\n                \x3c!-- Use ng-show nested inside an ng-if to solve BEL-79834 (each dropdown needs its own angular scope which is provided by ng-if but also needs the ng-show so that the dropdown isn\'t removed (so it can get all of its events) --\x3e\n                <div ng-if="true" class="os-no-shrink">\n                  <li class="dropdown os-table-more-button-container"\n                      ng-show="configurationTable.getCanEditDefinition() || configurationTable.getCanCopyTable()">\n                    <a data-bs-toggle="dropdown"\n                      class="os-table-more-button-control"\n                      ng-click="$parent.removeContextMenuStyle(true)">\n                      <os-svg icon="overflow"></os-svg>\n                    </a>\n\n                    <ul class="dropdown-menu dropdown-menu-end os-table-more-menu">\n                      <li ng-if="configurationTable.getCanCopyTable()">\n                        <a class="dropdown-item" os-clipboard\n                          os-generate-clipboard-text="configurationTable.copyTableDataForClipboard()"\n                          