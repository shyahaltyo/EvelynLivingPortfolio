n">\n              <os-svg icon="{{ ctrl.getMergeStrategyIcon(overallStrategy, ctrl.IconSizeEnum.LARGE, ctrl.sourceTabChangesCount > 0) }}" class="icon"></os-svg>\n            </div>\n            <div class="overall-preview-strategy-text">\n              <p ng-bind-html="ctrl.getOverallKeepTitleHtml()" class="overall-preview-strategy-title"></p>\n              <p ng-if="ctrl.targetTabChangesCount !== 1" class="overall-change-count">{{ \'__count__ tabs have changes\' | i18next:{ count: ctrl.targetTabChangesCount } }}</p>\n              <p ng-if="ctrl.targetTabChangesCount === 1" class="overall-change-count">{{ \'1 tab has changes\' | i18next }}</p>\n              <p class="compare-with-base-link">\n                <a class="btn-link" ng-click="ctrl.compareWithBase(ctrl.targetWorkspace)">\n                  {{ \'Compare with base\' | i18next }}<os-svg icon="arrow-up-right" class="new-tab-icon"></os-svg>\n                </a>\n              </p>\n            </div>\n          </div>\n          <div ng-if="overallStrategy === ctrl.MergeStrategyEnum.MERGE" class="overall-preview-strategy overall-preview-strategy-merge">\n            <div class="overall-preview-strategy-icon">\n              <os-svg icon="{{ ctrl.getMergeStrategyIcon(overallStrategy) }}" class="icon"></os-svg>\n            </div>\n            <div class="overall-preview-strategy-text">\n              <div class="overall-preview-strategy-title">{{ \'Merge changes\' | i18next }}</div>\n              <div ng-if="ctrl.elementsWithChanges.length !== 1" class="overall-change-count overall-merge-changes-count">{{ \'Combine all changes to __count__ tabs\' | i18next:{ count: ctrl.elementsWithChanges.length } }}</div>\n              <div ng-if="ctrl.elementsWithChanges.length === 1" class="overall-change-count overall-merge-changes-count">{{ \'Combine all changes to 1 tab\' | i18next }}</div>\n            </div>\n          </div>\n          <div ng-if="overallStrategy === ctrl.MergeStrategyEnum.REPLACE" class="overall-preview-strategy overall-preview-strategy-replace">\n            <div class="overall-preview-strategy-icon">\n              <os-svg icon="{{ ctrl.getMergeStrategyIcon(overallStrategy, ctrl.IconSizeEnum.LARGE, ctrl.targetTabChangesCount > 0) }}" class="icon"></os-svg>\n            </div>\n            <div class="overall-preview-strategy-text">\n              <div ng-bind-html="ctrl.getOverallReplaceTitleHtml()" class="overall-preview-strategy-title"></div>\n              <div ng-if="ctrl.sourceTabChangesCount !== 1" class="overall-change-count">{{ \'__count__ tabs have changes\' | i18next:{ count: ctrl.sourceTabChangesCount } }}</div>\n              <div ng-if="ctrl.sourceTabChangesCount === 1" class="overall-change-count">{{ \'1 tab has changes\' | i18next }}</div>\n              <div class="compare-with-base-link">\n                <a class="btn-link" ng-click="ctrl.compareWithBase(ctrl.sourceWorkspaceOrVersion)">\n                  {{ \'Compare with base\' | i18next }}<os-svg icon="arrow-up-right" class="new-tab-icon"></os-svg>\n                </a>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <h4 class="modal-title">{{ \'Tabs\' | i18next }}</h4>\n    <div class="element-preview-strategy-table" os-select-dropdown-bounds prevent-scrolling="true">\n      <div class="table-head">\n        <div class="table-row">\n          <div ng-if="ctrl.elementsWithChanges.length !== 1" class="tab-name">{{ \'__count__ tabs have changes\' | i18next:{ count: ctrl.elementsWithChanges.length} }}</div>\n          <div ng-if="ctrl.elementsWithChanges.length === 1" class="tab-name">{{ \'1 tab has changes\' | i18next }}</div>\n          <div ng-repeat="branch in ctrl.branchOrder" class="tab-changes selective-merge-tab-changes" ng-bind-html="ctrl.getBranchChangesTitleHtml(branch)"></div>\n          <div class="tab-strategy selective-merge-tab-strategy">{{ \'Tab merge strategy\' | i18next }}</div>\n        </div>\n      </div>\n      <div class="table-body">\n        <div ng-repeat="elementMergeConfig in ctrl.elementsWithChanges" class="table-row table-changes table-row-{{ $index }}" ng-class="{ \'row-even\': $even }">\n          <div class="tab-name">\n            <os-svg ng-if="elementMergeConfig.useSvgElementIcon()" icon="{{ elementMergeConfig.getElementIconSrc() }}" alt="{{ elementMergeConfig.getElementIconAlt() }}" class="icon"></os-svg>\n            <img ng-if="!elementMergeConfig.useSvgElementIcon()" ng-src="{{ elementMergeConfig.getElementIconSrc() }}" alt="{{ elementMergeConfig.getElementIconAlt() }}" class="icon">\n            <span class="tab-name-{{ $index }}" data-bs-original-title="{{ elementMergeConfig.elementTooltip }}">{{ elementMergeConfig.elementName }}</span>\n            <os-svg ng-if="elementMergeConfig.showInfoIcon"\n                    icon="performance-info"\n                    class="icon"\n                    data-bs-original-title="{{ elementMergeConfig.infoIconTooltipHtml }}"\n                    data-bs-html="true"\n                    data-bs-placement="top">\n            </os-svg>\n            <os-svg ng-if="elementMergeConfig.showErrorIcon"\n                    icon="error"\n                    class="icon"\n                    data-bs-original-title="{{ elementMergeConfig.errorIconTooltipHtml }}"\n                    data-bs-html="true"\n                    data-bs-placement="top">\n            </os-svg>\n            <a ng-if="elementMergeConfig.showOpenIcon" href="{{ ctrl.getSourceElementUrl(elementMergeConfig.getElementId()) }}" target="_blank">\n              <os-svg icon="open-icon"\n                      class="icon"\n                      data-bs-original-title="{{ elementMergeConfig.openIconTooltipText }}"\n                      data-bs-placement="top">\n              </os-svg>\n            </a>\n          </div>\n          <div ng-repeat="branch in ctrl.branchOrder"\n               class="tab-changes selective-merge-tab-changes"\n               ng-class="{ \'tab-target\': branch === ctrl.BranchEnum.TARGET, \'tab-source\': branch === ctrl.BranchEnum.SOURCE }">\n            <os-svg icon="{{ elementMergeConfig.getBranchStatusIcon(branch) }}" class="icon"></os-svg>\n            <span ng-bind="elementMergeConfig.getBranchStatusString(branch)"\n                  data-bs-original-title="{{ elementMergeConfig.getBranchStatusTooltip(branch) }}"\n                  ng-class="{ \'no-changes\': elementMergeConfig.getBranchStatus(branch) === ctrl.ElementBranchStatusEnum.NO_CHANGES }"></span>\n            <os-svg ng-if="elementMergeConfig.shouldShowDiscardedTabWarning(branch)"\n                    icon="error"\n                    class="icon"\n                    data-bs-original-title="{{ \'tooltips:::Tab will not exist in __targetname__ after merge\' | i18next:{ targetname: ctrl.escapedTargetName } }}"\n                    data-bs-placement="top"></os-svg>\n          </div>\n          <div class="tab-strategy selective-merge-tab-strategy">\n            <os-select ng-model="elementMergeConfig.strategy"\n                       ng-change="elementMergeConfig.onStrategyChanged()"\n                       ng-disabled="ctrl.protectedWorkspace"\n                       class="element-strategy-select element-strategy-container-{{ $index }}"\n                       backspace-reset="false"\n                       enter-activate="true">\n              <os-select-match>\n                <os-svg icon="{{ elementMergeConfig.getStrategyIcon(elementMergeConfig.strategy) }}" class="icon"></os-svg>\n                <span ng-bind-html="elementMergeConfig.getStrategyString()"></span>\n                <div ng-if="elementMergeConfig.isCustomized" class="element-strategy-triangle"></div>\n              </os-select-match>\n              <os-select-choices repeat="option.value.value as (key, option) in elementMergeConfig.dropdownOptions | osSelectParameterSearch:$select.search:true">\n                <os-svg icon="{{ elementMergeConfig.getStrat