c3 sampleLocation(mat4 matrix) {\n    vec4 position = matrix * vec4(vWorldPosition, 1.0);\n    vec3 positionInNdcSpace = (1.0 / position.w) * vec3(position);\n    return 0.5 * positionInNdcSpace + 0.5;\n}\n\n\nfloat getCenterUndercutColorWeightSteep(float normalDotDraftDirection) {\n// Apply a larger sampling radius on steep fragments, since there tend to be more areas on them\n#define FILTER_RADIUS 3.0\n// Since there are more errors on such fragments, we have a fairly large sample bias factor to increase the number\n// of samples that need to be considered undercut before shading them as such\n#define SAMPLE_BIAS_FACTOR 0.75\n{{{undercutWeightFunction}}}\n}\n\nfloat getCenterUndercutColorWeight(float normalDotDraftDirection) {\n#undef FILTER_RADIUS\n#undef SAMPLE_BIAS_FACTOR\n// We use a smaller radius for oblique fragments in order to increase rendering efficiency\n#define FILTER_RADIUS 1.0\n// We can use also use a lower sample bias threshold\n#define SAMPLE_BIAS_FACTOR 0.5\n{{{undercutWeightFunction}}}\n}\n\n// If the fragment is steeper than this value relative to the pull direction, than we will take more samples to\n// apply a large filter around the fragment location.  This is needed because there could be a large amount of\n// variance between samples that are orthogonal to the cut direction.  (See BEL-75539, BEL-76191, for example)\n// 0.0871557 = cos(85 degrees)\n#define STEEP_UNDERCUT_THRESHOLD  0.0871557\n\nfloat getUndercutColorWeight(vec3 normal) {\n  float normalDotDraftDirection = abs(dot(uDraftAnalysisDirection, normal));\n  if (normalDotDraftDirection < STEEP_UNDERCUT_THRESHOLD) {\n    return getCenterUndercutColorWeightSteep(normalDotDraftDirection);\n  } else {\n    return getCenterUndercutColorWeight(normalDotDraftDirection);\n  }\n}\n\nvec4 getDraftColor(vec3 normal) {\n  float draft = acos(dot(uDraftAnalysisDirection, normal));\n  bool passesDraft = !(PI_2 + DRAFT_TOLERANCE - uMinimumDraftAngle < draft && draft < PI_2 - DRAFT_TOLERANCE + uMinimumDraftAngle);\n  if (!passesDraft) {\n    return uSteepDraftColor;\n  } else if (draft - DRAFT_TOLERANCE < PI_2) {\n    return uWithDirectionColor;\n  } else {\n    return uAgainstDirectionColor;\n  }\n}\n\nvec4 getLitColor() {\n  return lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    if (uDoDraftAnalysis == 0) {\n      FRAG_COLOR = getLitColor();\n    } else {\n      vec3 normal = normalize(vNormal);\n      vec4 color = getDraftColor(normal * getNormalSign(normal, vPosition));\n      if (uShowUndercut != 0) {\n        color = mix(color, uUndercutColor, getUndercutColorWeight(normal));\n      }\n      FRAG_COLOR = color;\n    }\n}\n"},84529:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nDECLARE_FRAG_COLOR\n\nFRAG_IN lowp vec4 vColor;\nFRAG_IN mediump vec4 vLineStipple;\nFRAG_IN mediump float vLineWidth;\nFRAG_IN mediump float vDistance;\nFRAG_IN highp float vLength;\nFRAG_IN highp vec3 vPosition;\n\n{{{utilityFunctions}}}\n{{{edgeFragmentUtilityFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n  DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n  FRAG_COLOR = edgeColor(vColor, vLineWidth, vDistance);\n  FRAG_COLOR.a *= getStippleAlphaMultiplier(vLength, vLineStipple);\n}\n"},60886:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nuniform vec4 uViewport;\nuniform sampler2D uEndcapMaskTexture;\nuniform sampler2D uEdgeDetectTexture;\nuniform vec4 uPlaneSelector;\n\nFRAG_IN FRAGMENT_PRECISION vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{depthNormalFunctions}}}\n{{{sectionPlaneEndcapMedianFilter}}}\n\nvec2 maskTextureCoordinates(vec2 screenCoordinates) {\n    vec2 ndc;\n    ndc.x = screenCoordinates.x / uViewport.z;\n    ndc.y = screenCoordinates.y / uViewport.w;\n    return ndc;\n}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_ALL_BUT_ONE_SECTION_PLANE_CLIPPING_TEST(vPosition, uPlaneSelector);\n\n    vec4 sample0 = TEXTURE_2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy + vec2(-1.0, 0.0)));\n    vec4 sample1 = TEXTURE_2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy));\n    vec4 sample2 = TEXTURE_2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy + vec2(1.0, 0.0)));\n\n    vec4 selectedSample = medianFilterEndcapSamples(sample0, sample1, sample2);\n    float edgeAlpha = TEXTURE_2D(uEdgeDetectTexture, maskTextureCoordinates(gl_FragCoord.xy)).a;\n\n    // This test uses a soft threshold to deal with possible numerical imprecision where adding and subtracting\n    // the same values doesn't result in a zero. The threshold value is chosen to be an invisible alpha level.\n    if (selectedSample.a < 0.001) {\n        if (edgeAlpha > 0.01) {\n            FRAG_COLOR = vec4(0.0, 0.0, 0.0, 1.0);\n        } else {\n            discard;\n        }\n    } else {\n        FRAG_COLOR = vec4(0.0, 0.0, 0.0, 1.0);\n    }\n}\n"},51080:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nuniform vec4 uViewport;\nuniform sampler2D uEndcapMaskTexture;\nuniform sampler2D uEdgeDetectTexture;\nuniform float uDiscardPatternBackground;\nuniform vec4 uPlaneSelector;\n\nFRAG_IN vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{sectionPlaneEndcapPatternFunctions}}}\n{{{sectionPlaneEndcapMedianFilter}}}\n\nvec2 maskTextureCoordinates(vec2 screenCoordinates) {\n    vec2 ndc;\n    ndc.x = screenCoordinates.x / uViewport.z;\n    ndc.y = screenCoordinates.y / uViewport.w;\n    return ndc;\n}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_ALL_BUT_ONE_SECTION_PLANE_CLIPPING_TEST(vPosition, uPlaneSelector);\n\n    vec4 sample0 = TEXTURE_2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy + vec2(-1.0, 0.0)));\n    vec4 sample1 = TEXTURE_2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy));\n   