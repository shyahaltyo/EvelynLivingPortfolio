ntent --\x3e\n  <div ng-include="\'/project/web/ts/versions-and-history/versionsAndHistoryContent.html\'"\n       class="document-panel-main-content">\n  </div>\n\n  \x3c!-- Version and history footer --\x3e\n  <div class="document-panel-footer">\n    <span>{{ "Right-click on a row to perform actions" | i18next }}</span>\n    <div ng-if="canShowHelpButton()" class="os-row os-pin-right view-icons">\n      <os-vue-help-link-component v-props="{helpContextKey: \'versionshistorymanager\'}"></os-vue-help-link-component>\n    </div>\n  </div>\n</div>\n')}]),e.exports=n},1518:function(e,t,i){var n="/project/web/ts/where-used/whereUsedPane.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="document-detail-where-used document-panel-where-used os-col">\n  <where-used-container is-document-panel="true"\n                        source-item-document-id=""\n                        source-item-version-or-workspace=""\n                        source-item-version-workspace-id=""\n                        source-item-version-workspace-name=""\n                        source-item-element-id=""\n                        source-item-element-type="0"\n                        source-item-part-id=""\n                        source-item-part-number=""\n                        source-item-name=""\n                        source-item-type=""\n                        container-css="ctrl.getWhereUsedContainerCss()"\n                        show-title="true"\n                        right-align="false"\n                        class="os-col os-grow"></where-used-container>\n</div>\n')}]),e.exports=n},72319:function(e,t,i){var n="/project/web/ts/windchill/plm-context-map-template.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'\x3c!-- Component to query Windchill contexts and display in a Selection --\x3e\n<div class="form-group">\n<div style="display: flex; gap: 15px;">\n<label ng-style="$ctrl.customStyle" class="control-label">{{ $ctrl.contextLabel | i18next}}</label>\n<div ng-if="$ctrl.isLoading">\n  <div class="os-spinner-small os-spinner-spinning">\n  </div>\n</div>\n</div>\n<div ng-style="$ctrl.customStyle">\n  <ui-select name="projectPlmContext" ng-click="$ctrl.getWindchillContexts()"\n    ng-change="$ctrl.onSelectPLMContext()" ng-model="$ctrl.plmContext" required theme="bootstrap" append-to-body="false" skip-focusser="true">\n  <ui-select-match placeholder="{{$ctrl.plmContext.name || \'Search contexts\'}}"> {{ $select.selected.name || $ctrl.plmContext.name }}</ui-select-match>\n  <ui-select-choices repeat="option in $ctrl.plmContexts | filter: $select.search track by option.id">\n    <div data-bs-original-title="{{option.type + \' : \' + option.name}}">\n    <div>\n    <os-svg icon="{{ $ctrl.plmContextIcons[option.type] }}"></os-svg>\n    <span>{{ option.name }}</span>\n    </div>\n    <div class="small text-muted permission-name-text">{{option.description}}</div>\n    </div>\n  </ui-select-choices>\n  </ui-select>\n</div>\n</div>')}]),e.exports=n},78916:function(e,t,i){var n="/project/web/ts/woolsthorpeNavbar/woolsthorpe-navbar.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="disable-user-select navbar-container">\n  <div ng-if="NavbarController.showNavbar()">\n    <nav role="navigation" class="fixed-top" ng-class="[\'navbar\', \'navbar-light\', {\'is-enterprise\': NavbarController.visibilityControls.showEnterpriseMenu}]">\n      \x3c!-- Document banners (Floating) --\x3e\n      <div class="document-banner-placeholder">\n        <div class="document-banners-container"></div>\n      </div>\n\n      \x3c!-- NAVBAR: LEFT REGION --\x3e\n      <div class="navbar-left nav-navbar os-row os-no-shrink">\n\n        \x3c!-- Logo --\x3e\n        <span class="btn nav-item navbar-logo-btn"\n              ng-if="(NavbarController.isUserLoggedIn || NavbarController.isAnonymousGranted || NavbarController.isExportEmailLinkDownload)">\n          <osx-navbar-logo-component\n            [logo-url]="NavbarController.logoUrl"\n            [routing-state]="NavbarController.logoRouting"\n            [is-export-email-link-download]="NavbarController.isExportEmailLinkDownload">\n          </osx-navbar-logo-component>\n        </span>\n\n        \x3c!-- Hamburger menu --\x3e\n        <div ng-if="NavbarController.visibilityControls.hamburgerMenu" ng-controller="Woolsthorpe.AppNavbar.DocumentMenuController as DocumentMenuController" uib-dropdown class="dropdown hamburger-menu" bt-right-click="NavbarController.onContextMenu()">\n          <div uib-dropdown-toggle class="btn nav-item nav-hamburger-menu">\n            <os-svg icon="hamburger-button"></os-svg>\n          </div>\n          <ul ng-if="!NavbarController.isPublication()" uib-dropdown-menu class="dropdown-menu document-dropdown-menu" role="menu" ng-include="\'/project/web/woolsthorpe/app/partials/documentMenu.html\'"></ul>\n          <ul ng-if="NavbarController.isPublication()" uib-dropdown-menu class="dropdown-menu document-dropdown-menu" role="menu" ng-include="\'/project/web/woolsthorpe/app/partials/publicationMenu.html\'"></ul>\n        </div>\n      </div>\n\n      \x3c!-- NAVBAR: SEARCH BOX --\x3e\n      <div class="os-searchbox-container os-grow" ng-if="NavbarController.visibilityControls.searchBox">\n        <os-document-search></os-document-search>\n      </div>\n      <div class="os-searchbox-container os-grow" ng-if="NavbarController.visibilityControls.changeSearchBox">\n        <change-search></change-search>\n      </div>\n\n      \x3c!-- NAVBAR: CENTER REGION --\x3e\n      <div ng-if="NavbarController.visibilityControls.modelName" class="navbar-document-and-workspace-names os-row os-grow os-align-center" ng-class="{\'connection-document-center-region\' : openDocument && NavbarController.visibilityControls.connectionDocument}">\n\n        \x3c!-- Document and workspace/version name --\x3e\n        <div class="navbar-block-wrapper">\n          <div class="document-name-container os-row os-align-baseline" ng-class="{\'can-rename\': NavbarController.canOpenRenameDialog(), \'dialog-open\': NavbarController.isDialogOpen()}">\n            <div class="navbar-document-name"\n                  ng-style="{\'width\': documentNameWidth}"\n                  ng-mousedown="NavbarController.onDocumentNameMouseDown($event)"\n                  ng-click="NavbarController.renameDocument($event)"\n                  data-bs-original-title="{{openDocument.name}}"\n                  data-bs-placement="bottom">\n              <div class="navbar-document-name-overlay-wrapper">\n                <div class="navbar-document-name-overlay"></div>\n              </div>\n              {{openDocument.name}}\n            </div>\n            <span ng-if="NavbarController.visibilityControls.workspaceOrVersionName && !NavbarController.isPublication()" class="workspace-or-version-name navbar-document-version d-none d-sm-block" data-bs-original-title="{{openWorkspace.name}}" data-bs-placement="bottom">{{openWorkspace.name}}</span>\n            <span ng-if="NavbarController.visibilityControls.workspaceOrVersionName && NavbarController.isPublication()" class="navbar-document-version d-none d-sm-block" data-bs-original-title="{{openDocument.description}}" data-bs-placement="bottom">{{openDocument.description}}</span>\n            <os-svg ng-if="NavbarController.isPublication()" icon="publication" class="publication-icon os-no-shrink"></os-svg>\n          </div>\n        </div>\n\n      \x3c!-- Connection icon --\x3e\n      <div class="external-connection-badge-container" ng-if="openDocument && NavbarController.visibilityControls.connectionDocument"\n            data-bs-original-title="{{NavbarController.connectionSharedDocumentTooltip}}"\n            data-bs-placement="bottom" ng-class="{\'publication-connection-badge\' : NavbarController.isPublication()}">\n        <div class="external-connection-owner-indication" ng-if="openDocument.isExternalConnectionResource">\n          <os-svg icon="external-connection-badge" class="document-link-icon"></os-svg>\n          <span class="external-connection-document-owned-by">{{ "Owned by" | i18next }} {{openDocument.owner.prettyName}}</span>\n        </div>\n        <os-svg icon="external-connection-badge" class="document-link-icon" ng-if="!openDocument.isExternalConnectionResource"></os-svg>\n      </div>\n\n       \x3c!-- copy document icon --\x3e\n       <div class="navbar-header-btn-container" ng-controller="Woolsthorpe.AppNavbar.SocialButtonsController as SocialButtonsController">\n        <div class="btn document-copy-link-btn nav-item"\n              ng-if="openDocument"\n              ng-click="SocialButtonsController.createParameterisedLink()"\n              data-bs-original-title="{{ NavbarController.getCopyLinkTooltip() }}"\n              data-bs-expanded-content="{{ NavbarController.getExtendedCopyLinkTooltip() }}"\n              data-bs-placement="bottom">\n              <os-svg icon="document-links" class="document-link-icon"></os-svg>\n        </div>\n      </div>\n\n        \x3c!-- parent folder large/small screen --\x3e\n        <div ng-if="(NavbarController.isInFolder() || NavbarController.isInProject()) && !NavbarController.isParentResourceCompany()">\n          <a ng-href="{{NavbarController.goToFolderOrProject()}}" target="_blank" data-bs-placement="bottom" class="os-row folder"\n             data-bs-original-title="{{ \'Go to __folderName__\' | i18next:{folderName: NavbarController.getParentFolderName()} }}">\n            <os-svg icon="folder" class="lg-svg" ng-if="NavbarController.isInFolder()"></os-svg>\n            <os-svg icon="project" class="lg-svg" ng-if="NavbarController.isInProject()"></os-svg>\n            <span class="name ellipseOverflowText d-none d-xl-block">\n              {{NavbarController.getParentFolderName()}}\n            </span>\n          </a>\n        </div>\n\n        \x3c!-- Inline public document icons (large screens) --\x3e\n        <div class="os-no-shrink d-none d-xl-block">\n          <span os-document-icon visibility-controls="NavbarController.visibilityControls" is-publication="NavbarController.isPublication()"></span>\n        </div>\n        <os-public-stats class="os-public-stats navbar-public-stats os-no-shrink d-none d-xl-block" document="openDocument" ng-if="openDocument.public"></os-public-stats>\n\n        \x3c!-- Public icons dropdown (small screens) --\x3e\n        <div class="os-no-shrink d-xl-none" uib-dropdown data-bs-original-title="{{\'tooltips:::Public stats\' | i18next}}" data-bs-placement="bottom" ng-if="openDocument.public">\n          <div uib-dropdown-toggle class="btn nav-item navbar-btn-container dropdown-toggle public-stats-toggle" data-bs-placement="bottom">\n            <span os-document-icon visibility-controls="NavbarController.visibilityControls"></span>\n          </div>\n          <ul uib-dropdown-menu class="dropdown-menu document-dropdown-menu" role="menu">\n            <li>\n              <os-public-stats class="os-public-stats navbar-public-stats os-no-shrink" document="openDocument" ng-if="openDocument.public"></os-public-stats>\n            </li>\n          </ul>\n        </div>\n        \x3c!-- Assignment Menu --\x3e\n        <div class="navbar-btn-container" ng-if="openDocument && NavbarController.visibilityControls.assignment">\n          <osx-document-submission-workflows [document-id]="openDocument.id"></osx-document-submission-workflows>\n        </div>\n      </div>\n\n      \x3c!-- NAVBAR: RIGHT REGION --\x3e\n      <div class="nav-navbar os-row os-no-shrink navbar-right-pinned">\n\n        \x3c!-- Collaborator icons --\x3e\n        <div class="clients" ng-show="NavbarController.visibilityControls.collaboratorList">\n          <osx-document-collaborators\n            [overflow-at]="4"\n            [show-all]="true"\n            [tooltip-placement]="\'bottom\'"\n          ></osx-document-collaborators>\n        </div>\n\n        \x3c!-- Debug menu --\x3e\n        <os-vue-debug-menu ng-if="NavbarController.visibilityControls.debugMenu && NavbarController.debugMenuEnabledForThisUser"></os-vue-debug-menu>\n\n        \x3c!-- FeatureScript notices--\x3e\n        <div ng-if="NavbarController.visibilityControls.noticesButton"\n            class="dropdown"\n            data-bs-original-title="{{\'tooltips:::FeatureScript notices\' | i18next}}"\n            data-bs-placement="bottom">\n          <div class="btn nav-item nav-notifications notice-pane-toggle-button"\n               ng-click="NavbarController.toggleNoticePane()">\n            <div class="flyout-toggle-button" ng-class="{\'os-expanded\': NavbarController.getIsNoticePaneOpen()}">\n              <div class="notices-toggle-content" ng-controller="ErrorFlyoutToggleController">\n                <os-svg icon="{{getErrorButtonIcon()}}"></os-svg>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \x3c!-- FeatureScript search --\x3e\n        <div ng-show="NavbarController.visibilityControls.crossElementSearchButton"\n            class="dropdown"\n            data-bs-original-title="{{\'tooltips:::Search Feature Studios (Ctrl-Shift-f / ⌘-Shift+f)\' | i18next}}"\n            data-bs-placement="bottom">\n          <div class="btn nav-item nav-notifications feature-script-search-toggle-button"\n               ng-click="NavbarController.toggleFeatureScriptSearch()">\n            <div class="flyout-toggle-button" ng-class="{\'os-expanded\': NavbarController.getIsSearchPaneOpen()}">\n              <div class="cross-element-search-toggle-content">\n                <os-svg icon="search"></os-svg>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \x3c!-- Explore Onshape--\x3e\n        <div class="navbar-btn-container" ng-if="NavbarController.visibilityControls.exploreOnshape">\n          <button class="btn btn-secondary explore-onshape-btn"\n            ng-click="NavbarController.goToExploreOnshape()"\n            data-bs-original-title="{{\'tooltips:::Go to Explore Onshape\' | i18next}}"\n            data-bs-placement="bottom">\n            <os-svg icon="explore-onshape"></os-svg>{{ "Explore Onshape" | i18next}}\n          </button>\n        </div>\n\n        \x3c!-- Notifications --\x3e\n        <div ng-show="NavbarController.isUserLoggedIn && !NavbarController.hideUserMenu && NavbarController.visibilityControls.notificationButton"\n             id="user-notification-status"\n             class="dropdown"\n             aria-label="{{\'tooltips:::Notifications\' | i18next}}"\n             role="button"\n             data-bs-original-title="{{\'tooltips:::Notifications\' | i18next}}"\n             data-bs-placement="bottom" tabindex="0">\n          <user-notifications-toggle></user-notifications-toggle>\n        </div>\n\n        \x3c!-- Action items button --\x3e\n        <div data-inapp-location="action-items-button" ng-if="NavbarController.visibilityControls.goToActionItems">\n          <div class="navbar-header-btn-container d-lg-block">\n            <button class="btn nav-item"\n                    ng-click="NavbarController.goToActionItems()"\n                    data-bs-original-title="{{\'tooltips:::View all Action items\' | i18next}}"\n                    data-bs-placement="bottom"\n                    data-identifier="Action items"\n                    type="button"\n                    aria-label="{{ \'Navigates you to Action items page in a new window.\' | i18next}}"\n                    role="link">\n              <os-svg aria-hidden="true" icon="navbar-action-items"></os-svg></button>\n          </div>\n        </div>\n\n        \x3c!-- Appstore button --\x3e\n        <div data-inapp-location="appstore-button" ng-if="NavbarController.visibilityControls.goToAppStore">\n          <div class="navbar-header-btn-container d-lg-block">\n            <button class="btn nav-invite nav-item" ng-click="NavbarController.goToAppStore()"\n                    data-bs-original-title="{{\'tooltips:::Go to App Store\' | i18next}}" data-bs-placement="bottom"\n                    type="button" aria-label="{{ \'Navigates you to Onshape app store in a new window.\'  | i18next}}" role="link">\n              <os-svg aria-hidden="true" icon="navbar-app-store"></os-svg></button>\n          </div>\n        </div>\n\n        \x3c!-- Learning center button --\x3e\n        <div data-inapp-location="learning-center-button" ng-if="NavbarController.visibilityControls.goToLearningCenter">\n          <div class="navbar-header-btn-container d-lg-block">\n            <button class="btn nav-invite nav-item" ng-click="NavbarController.goToLearningCenter()"\n                    data-bs-original-title="{{\'tooltips:::Go to Learning Center\' | i18next}}" data-bs-placement="bottom"\n                    type="button" aria-label="{{ \'Navigates you to Onshape Learning Center in a new window.\' | i18next}}" role="link">\n              <os-svg aria-hidden="true" icon="navbar-learning-center"></os-svg></button>\n          </div>\n        </div>\n\n        \x3c!-- Sharing and anonymous user buttons --\x3e\n        <div class="navbar-btn-container d-block" ng-controller="Woolsthorpe.AppNavbar.SocialButtonsController as SocialButtonsController">\n          <button class="btn btn-primary nav-share document-list-share-button os-navbar-share-button" tabindex="4"\n                  ng-if="openDocument && NavbarController.visibilityControls.shareButton"\n                  ng-class="{disabled: SocialButtonsController.disableShare}"\n                  ng-disabled="SocialButtonsController.disableShare"\n                  ng-click="SocialButtonsController.showShareDialog()"\n                  data-bs-original-title="{{SocialButtonsController.tooltip}}"\n                  data-bs-expanded-content="{{SocialButtonsController.expandedTooltip}}" data-bs-placement="bottom"\n                  type="button">\n            {{ "Share" | i18next}}</button>\n          <button class="btn os-create-account nav-share" tabindex="5"\n                  ng-show="NavbarController.visibilityControls.signUpButton"\n                  ng-click="SocialButtonsController.showSignUp()"\n                  data-bs-original-title="{{\'tooltips:::Sign up for Onshape\' | i18next}}" data-bs-placement="bottom"\n                  type="button">\n            {{ "Create account" | i18next}}</button>\n          <button class="btn os-sign-in nav-share" tabindex="6"\n                  ng-show="NavbarController.visibilityControls.signUpButton"\n                  ng-click="SocialButtonsController.showSignIn()"\n                  data-bs-original-title="{{\'tooltips:::Sign in to Onshape\' | i18next}}" data-bs-placement="bottom"\n                  type="button">\n            {{ "Sign in" | i18next}}</button>\n        </div>\n\n        \x3c!-- HELP MENU --\x3e\n        <div ng-show="NavbarController.visibilityControls.resourceCenter" ng-controller="Woolsthorpe.AppNavbar.HelpMenuController as HelpMenuController" uib-dropdown class="dropdown" id="help-menu" tabindex="0">\n          <div uib-dropdown-toggle class="dropdown-toggle btn nav-item nav-help" aria-label="{{\'tooltips:::Help menu\' | i18next}}" data-bs-original-title="{{\'tooltips:::Help menu\' | i18next}}" data-bs-placement="bottom" ng-click="HelpMenuController.collapseAllFlyouts()">\n            <os-svg aria-hidden="true" icon="navbar-help" class="os-help-btn"></os-svg>\n          </div>\n          <ul id="navbarHelpMenuDropdown" uib-dropdown-menu class="dropdown-menu help-menu" role="menubar">\n            <li role="menuitem"><a class="dropdown-item" href="{{HelpMenuController.helpUrl}}" target="_blank">{{ "Help" | i18next}}</a></li>\n            <li role="menuitem" ng-if="NavbarController.showExploreOnshapeInHelpMenu"><a class="dropdown-item" href="/documents/explore-onshape" target="_blank">{{ "Explore Onshape" | i18next}}</a></li>\n            <li role="menuitem"><a class="dropdown-item" href="/FsDoc" target="_blank" rel="noopener noreferrer">{{ "FeatureScript documentation" | i18next}}</a></li>\n            <li role="menuitem"><a role="button" class="dropdown-item hotkey-help-target" ng-click="HelpMenuController.showHotkeys()" ng-if="NavbarController.isUserLoggedIn">{{ "Keyboard shortcuts" | i18next}}</a></li>\n            <li class="dropdown-divider" role="separator"></li>\n            <li role="menuitem" ng-if="NavbarController.visibilityControls.forum"><a class="dropdown-item" href="{{HelpMenuController.forumLink}}" target="_blank" ng-click="HelpMenuController.trackWhatsNewForumLink()">{{ "What\'s new" | i18next}}</a></li>\n            <li role="menuitem" ng-if="NavbarController.visibilityControls.forum"><a class="dropdown-item" href="http://forum.onshape.com/sso" target="_blank">{{ "Forums" | i18next}}</a></li>\n            <li role="menuitem" ng-if="NavbarController.isUserLoggedIn"><a class="dropdown-item" role="button" ng-click="HelpMenuController.openContactSupportTool()">{{HelpMenuController.getFeedbackText()}}</a></li>\n            <li class="dropdown-divider" role="separator"></li>\n            <li role="menuitem" ng-if="NavbarController.visibilityControls.referAFriend" ><a class="dropdown-item" href="{{NavbarController.onshapeWebReferFriendUrl}}" target="_blank">{{ "Refer a friend" | i18next}}</a></li>\n            <li class="dropdown-divider" role="separator" ng-if="NavbarController.visibilityControls.referAFriend"></li>\n            <li role="menuitem"><a class="dropdown-item" href="/check" target="_blank">{{ "System check" | i18next}}</a></li>\n            <li class="dropdown-item" role="button" ng-click="HelpMenuController.showAboutModal(\'/about-onshape.html\')">{{ "About" | i18next}}</li>\n          </ul>\n        </div>\n\n        \x3c!-- ACCOUNT MENU --\x3e\n        <div ng-show="NavbarController.isUserLoggedIn && !NavbarController.hideUserMenu" ng-controller="Woolsthorpe.AppNavbar.UserMenuController as UserMenuController" uib-dropdown class="dropdown">\n          <div role="button" aria-haspopup="true" tabindex="0" uib-dropdown-toggle class="user-signin-name os-user-signin-name btn nav-item" ng-click="UserMenuController.collapseAllFlyouts()" data-automation="account-dropdown">\n            <span os-user-icon user-icon-info="UserMenuController.userDetails"></span>\n            <div class="username-ellipsis-container ellipseOverflowText">\n              <span class="navbar-dropdown-username-ellipsis d-none d-lg-block">{{UserMenuController.userDetails.name}}</span>\n            </div>\n            <b aria-hidden="true" class="caret"></b>\n          </div>\n          <ul id="navbarUserDropdown" uib-dropdown-menu class="dropdown-menu account" role="menu" data-automation="account-dropdown-menu">\n            <li ng-if="NavbarController.visibilityControls.publicProfiles"><a class="dropdown-item" os-ui-sref="woolsthorpe.publicProfile" os-ui-sref-data=\'{"handle": "{{NavbarController.getCurrentUserForumId()}}"}\'>{{ "View my profile" | i18next}}</a></li>\n            <li><a class="dropdown-item" os-ui-sref="woolsthorpe.userAccount.profile">{{ "My account" | i18next}}</a></li>\n            <li ng-if="NavbarController.shouldShowEnterpriseNavbar() && NavbarController.isManageUsers()">\n              <a class="dropdown-item"\n                os-ui-sref="{{NavbarController.getEnterpriseManageUsersStateName()}}">{{ "Enterprise settings" | i18next}}</a>\n            </li>\n            <li ng-if="NavbarController.shouldShowEnterpriseNavbar() && !NavbarController.isManageUsers()"><a class="dropdown-item" ui-sref="main.manage.company.details" ui-sref-active="os-active">{{ "Enterprise settings" | i18next}}</a></li>\n            <li ng-repeat="company in UserMenuController.userCompanies" ng-if="NavbarController.visibilityControls.showCompanySettings && !NavbarController.visibilityControls.showEnterpriseMenu">\n              <a class="dropdown-item" ui-sref="woolsthorpe.companySettings.users({ companyId: company.id })" ui-sref-active="os-active">{{company.name}} {{ "__companyType__ settings" | i18next:{companyType: NavbarController.getCompanyType()} }}</a>\n            </li>\n            <li><a class="dropdown-item" ng-href="{{UserMenuController.getSuportTicketLink()}}" target="_blank">{{ "View support tickets" | i18next }}</a></li>\n            <li class="dropdown-divider" ng-if="UserMenuController.devPortalUrl"></li>\n            <li ng-if="UserMenuController.devPortalUrl"><a class="dropdown-item" ng-href="{{UserMenuController.devPortalUrl}}" target="_blank" ng-click="UserMenuController.trackDevPortalLinkClick()">{{ "App Store dev portal" | i18next }}</a></li>\n            <li ng-if="UserMenuController.adminPortalUrl"><a class="dropdown-item" ng-href="{{UserMenuController.adminPortalUrl}}" target="_blank">{{ "App Store admin portal" | i18next }}</a></li>\n            <li class="dropdown-divider" ng-if="UserMenuController.hasAdminConsoleAccess"></li>\n            <li ng-if="UserMenuController.hasAdminConsoleAccess"><a class="dropdown-item" href="/admin" target="_self">{{ "Admin tools" | i18next}}</a></li>\n            <li class="dropdown-divider" ng-if="UserMenuController.userEnterpriseDomains.length"></li>\n            <li ng-if="UserMenuController.userEnterpriseDomains.length">\n              <a class="dropdown-item" ng-repeat="enterprise in UserMenuController.userEnterpriseDomains | orderBy : \'name\'" ng-click="UserMenuController.switchToEnterprise(enterprise)">{{"Switch to" | i18next}} <strong>{{enterprise.name}}</strong></a>\n            </li>\n            <li class="dropdown-divider" ng-if="NavbarController.shouldShowEnterpriseEduNavbar() && !NavbarController.isPasswordSignInDisabled()"></li>\n            <li ng-if="NavbarController.shouldShowEnterpriseEduNavbar() && !NavbarController.isPasswordSignInDisabled()">\n              <a class="dropdown-item" ng-click="UserMenuController.showSwitchToPersonalDialog()" ng-i18next="[html:i18next] Switch to Onshape account"></a>\n            </li>\n            <li class="dropdown-divider" ng-if="UserMenuController.canShowSwitchLanguage()"></li>\n            <li ng-if="UserMenuController.canShowSwitchLanguage()">\n              <a class="dropdown-item" ng-if="UserMenuController.isPigLatin()" ng-click="UserMenuController.resetLocaleToDefault()">{{"Switch to English" | i18next}}</a>\n              <a class="dropdown-item" ng-if="!UserMenuController.isPigLatin()" ng-click="UserMenuController.changeLocaleToPigLatin()">{{"Switch to Pig Latin" | i18next}}</a>\n            </li>\n            <li class="dropdown-divider"></li>\n            <li class="dropdown-item clickable" ng-click="$event.stopPropagation()">\n              <div class="form-check form-switch form-check-reverse text-start">\n                <input class="form-check-input user-select-auto" type="checkbox" role="button" id="darkModeSwitch" ng-checked="UserMenuController.darkModeToggled" ng-click="UserMenuController.toggleTheme($event)">\n                <label class="form-check-label mb-0 clickable" for="darkModeSwitch">{{ "View in dark mode" | i18next }} <span class="badge rounded-pill bg-primary">beta</span></label>\n              </div>\n            </li>\n            <li class="dropdown-divider"></li>\n            <li><a class="dropdown-item" ng-click="UserMenuController.logout()" data-automation="sign-out-button">{{ "Sign out" | i18next}}</a></li>\n          </ul>\n        </div>\n      </div>\n    </nav>\n    <div class="navbar-offset"> </div>\n    <div class="ai-advisor-container" ng-if="NavbarController.visibilityControls.aiAdvisor">\n      <button id="onshapeAdvisorButton" class="advisor-toggle" ng-click="NavbarController.toggleAiAdvisor()">\n        <img src="/images/ai/ai-advisor-logo.svg"/>\n      </button>\n      <div id="advisor-overlay" class="advisor-overlay" ng-if="NavbarController.shouldShowAiAdvisor()">\n        <div class="advisor-container">\n          <osc-ai-advisor location="popup" context="none"></osc-ai-advisor>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>\n')}]),e.exports=n},16897:function(e,t,i){var n="/project/web/ts/workflow/workflow-picker.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="workflow-picker" ng-if="$ctrl.initialLoadComplete">\n  <div class="os-form-container">\n    <div class="wide-form-group">\n      <div class="workflow-selection">\n        <div class="os-row workflow-select-row">\n          <select class="form-control workflow-selector no-margin"\n                ng-model="$ctrl.selectedWorkflow"\n                ng-options="$ctrl.getDisplayName(option) for option in $ctrl.workflowOptions | filter: {usesExternalPlm: $ctrl.useExternalPlmWorkflows}"\n                ng-change="$ctrl.selectedWorkflowsChanged(false)"\n                ng-disabled="!$ctrl.editable"\n          ></select>\n          <a ng-if="$ctrl.showDocLink" target="_blank" ng-href="{{$ctrl.getLinkToSourceDocument()}}">{{\'View in document\' | i18next}}</a>\n        </div>\n        <osx-workflow-details ng-if="!$ctrl.hideWorkflowDetails"\n                          [workflow]="$ctrl.selectedWorkflow"\n                          [show-name]="false"\n        ></osx-workflow-details>\n      </div>\n    </div>\n  </div>\n</div>\n')}]),e.exports=n},30097:function(e,t,i){var n="/project/web/woolsthorpe/app/partials/about-page-modal.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="modal-body about-onshape" id="custom-modal-body">\n  <button type="button" class="btn-close" id="custom-modal-close" data-bs-dismiss="modal" aria-hidden="true" ng-click="hide()"></button>\n  <iframe id="modal-iframe" ng-src="{{modal.url}}"></iframe>\n</div>\n<div class="modal-footer" id="custom-modal-footer">\n  <div id="about-version-text">{{modal.productVersion}}</div>\n</div>')}]),e.exports=n},18417:function(e,t,i){var n="/project/web/woolsthorpe/app/partials/compatibilityCheck.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="os-content-between-navbar-footer-container" ng-class="{\'left-navbar-visible\': ctrl.isEnterpriseAccount()}" ng-show="ctrl.isCheckComplete === true">\n  <div id="view-container" ng-if="!ctrl.performanceResult">\n    <div id="view-message">{{"Measuring performance" | i18next}}</div>\n  </div>\n  <h3 ng-if="ctrl.allChecksPassed()" class="text-center os-compatibility-message">{{ \'Your browser is compatible with Onshape\' | i18next }}</h3>\n  <h3 ng-if="!ctrl.allChecksPassed()" class="text-center os-compatibility-message">{{ \'Your browser is not fully compatible with Onshape\' | i18next }}</h3>\n  <div class="os-compatibility">\n    <div class="os-filler"></div>\n    <div class="os-compatibility-sections" id="accordion">\n      <div class="card os-compatibility-section browser-check">\n        <div class="card-header">\n          <h4 class="card-title">\n            <a data-bs-toggle="collapse" data-target="#browserPanel"\n               href="#browserPanel" class="collapsed">\n              {{"Browser" | i18next}}\n            </a>\n          </h4>\n          <div class="os-panel-image user-agent-indicator">\n            <img ng-if="ctrl.isSupportedDesktopBrowser() && ctrl.browserSupportInfo.isLocalStorageAvailable" src="/images/iconDone.svg">\n            <img ng-if="!ctrl.browserSupportInfo.isLocalStorageAvailable" src="/images/iconWarning.svg">\n            <img ng-if="!ctrl.isSupportedDesktopBrowser()" src="/images/iconFailed.svg">\n          </div>\n        </div>\n        <div id="browserPanel" class="accordion-collapse collapse show browser-panel">\n          <div class="card-body">\n            <div class="os-check-item ">\n              <div class="os-sub-item-name">{{ \'User agent\' | i18next}}</div>\n              <div class="os-sub-item-value">\n                {{ctrl.browserSupportInfo.userAgent}}\n              </div>\n            </div>\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'Platform\' | i18next}}</div>\n              <div class="os-sub-item-value">\n                <img ng-if="!ctrl.browserSupportInfo.isPlatformSupported" src="/images/iconFailed.svg">\n                {{ctrl.browserSupportInfo.platform}}\n              </div>\n            </div>\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'Browser\' | i18next}}</div>\n              <div class="os-sub-item-value">\n                <img ng-if="!ctrl.browserSupportInfo.isBrowserSupported" src="/images/iconFailed.svg">\n                {{ctrl.browserSupportInfo.browser}}\n              </div>\n            </div>\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'Browser Version\' | i18next}}</div>\n              <div class="os-sub-item-value">\n                <img ng-if="!ctrl.browserSupportInfo.isVersionSupported" src="/images/iconFailed.svg">\n                {{ctrl.browserSupportInfo.version}}\n              </div>\n            </div>\n\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'Local storage\' | i18next}}</div>\n              <div class="spinner os-spinner-small os-spinner-spinning" ng-if="!ctrl.browserSupportInfo.isLocalStorageCheckDone"></div>\n              <div class="os-sub-item-value os-sub-item-value-padding" ng-if="!ctrl.browserSupportInfo.isLocalStorageCheckDone">{{\'Evaluating…\' | i18next}}</div>\n              <div class="os-sub-item-value" ng-if="ctrl.browserSupportInfo.isLocalStorageCheckDone">\n                <img ng-if="!ctrl.browserSupportInfo.isLocalStorageAvailable" src="/images/iconWarning.svg">\n                <span class="os-sub-item-value" ng-if="ctrl.browserSupportInfo.isLocalStorageAvailable">{{ \'Present\' | i18next}}</span>\n                <span class="os-sub-item-value" ng-if="!ctrl.browserSupportInfo.isLocalStorageAvailable">{{ \'Missing\' | i18next}}</span>\n              </div>\n            </div>\n\n            <div class="os-check-message" ng-if="ctrl.browserSupportInfo.bitMismatch">\n              <p><img src="/images/iconWarning.svg"> {{ \'You are running a 32-bit browser on a 64-bit operating system.  For better performance, install the 64-bit version of your browser.\' | i18next }}</p>\n            </div>\n            <div class="os-check-message" ng-if="ctrl.isSafariVersionOnMacSupported()">\n              <p><img src="/images/iconWarning.svg">{{ \'Your Safari browser version is supported but you will need to enable WebGL in the developer options.\' | i18next }}</p>\n            </div>\n            <div class="os-check-message" ng-if="!ctrl.browserSupportInfo.isBrowserSupported" ng-bind-html="ctrl.browserMessage"></div>\n            <div class="os-check-message" ng-if="!ctrl.browserSupportInfo.isVersionSupported" ng-bind-html="ctrl.browserVersionMessage"></div>\n            <div class="os-check-message" ng-if="ctrl.isMobilePlatform()" ng-bind-html="ctrl.mobileBrowserMessage"></div>\n          </div>\n        </div>\n      </div>\n\n      <div class="card os-compatibility-section web-gl-check" ng-if="ctrl.isSupportedDesktopBrowser()">\n        <div class="card-header">\n          <h4 class="card-title">\n            <a data-bs-toggle="collapse" data-target="#webGLPanelBody"\n               href="#webGLPanelBody">\n              {{"WebGL and extensions" | i18next}}\n            </a>\n          </h4>\n          <div  class="os-panel-image web-gl-indicator">\n            <img ng-if="ctrl.doAllWebGLChecksPass()" src="/images/iconDone.svg">\n            <img ng-if="!ctrl.isCoreWebGLSupported()" src="/images/iconFailed.svg">\n            <img ng-if="ctrl.areExtensionsMissing()" src="/images/iconWarning.svg">\n          </div>\n        </div>\n        <div id="webGLPanelBody" class="accordion-collapse collapse show">\n          <div class="card-body">\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'Core WebGL\' | i18next}}</div>\n              <div class="os-sub-item-image core-web-gl-indicator">\n                <img ng-if="ctrl.isCoreWebGLSupported()" src="/images/iconDone.svg">\n                <img ng-if="!ctrl.isCoreWebGLSupported()" src="/images/iconFailed.svg">\n              </div>\n            </div>\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'Float textures\' | i18next}}</div>\n              <div class="os-sub-item-image float-texture-indicator">\n                <img ng-if="ctrl.webGlSupport.floatTexture === true" src="/images/iconDone.svg">\n                <img ng-if="ctrl.webGlSupport.floatTexture === false" src="/images/iconFailed.svg">\n              </div>\n            </div>\n            <p ng-if="ctrl.webGlSupport.floatTexture === false">{{ ctrl.getCompatibilityChecksService().FLOAT_TEXTURE_UNSUPPORTED }}</p>\n\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'Float buffer blending\' | i18next}}</div>\n              <div class="os-sub-item-image float-buffer-blend-indicator">\n                <img ng-if="ctrl.webGlSupport.floatBufferBlending === true" src="/images/iconDone.svg">\n                <img ng-if="ctrl.webGlSupport.floatBufferBlending === false" src="/images/iconFailed.svg">\n              </div>\n            </div>\n            <p ng-if="ctrl.webGlSupport.floatBufferBlending === false">{{ ctrl.getCompatibilityChecksService().FLOAT_BUFFER_BLENDING_UNSUPPORTED }}</p>\n\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'Anisotropic texture filtering\' | i18next}}</div>\n              <div class="os-sub-item-image anistropic-indicator">\n                <img ng-if="ctrl.webGlSupport.anisotropicTextureFiltering === true" src="/images/iconDone.svg">\n                <img ng-if="ctrl.webGlSupport.anisotropicTextureFiltering === false" src="/images/iconFailed.svg">\n              </div>\n            </div>\n            <p ng-if="ctrl.webGlSupport.anisotropicTextureFiltering === false">{{ ctrl.getCompatibilityChecksService().ANISOTROPIC_TEXTURE_UNSUPPORTED }}</p>\n\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'32-bit indices\' | i18next}}</div>\n              <div class="os-sub-item-image bit32-indicator">\n                <img ng-if="ctrl.webGlSupport.indicesWith32Bits === true" src="/images/iconDone.svg">\n                <img ng-if="ctrl.webGlSupport.indicesWith32Bits === false" src="/images/iconFailed.svg">\n              </div>\n              <br/>\n            </div>\n            <p ng-if="ctrl.webGlSupport.indicesWith32Bits === false">{{ ctrl.getCompatibilityChecksService().INDICES_32BIT_UNSUPPORTED }}</p>\n\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'High precision fragment shaders\' | i18next}}</div>\n              <div class="os-sub-item-image highp-indicator">\n                <img ng-if="ctrl.webGlSupport.highPrecisionFragmentShader === true" src="/images/iconDone.svg">\n                <img ng-if="ctrl.webGlSupport.highPrecisionFragmentShader === false" src="/images/iconFailed.svg">\n              </div>\n              <br/>\n            </div>\n            <p ng-if="ctrl.webGlSupport.highPrecisionFragmentShader === false">{{ ctrl.getCompatibilityChecksService().HIGH_PRECISION_SHADER_UNSUPPORTED }}</p>\n\n            <div class="os-check-message" ng-show="ctrl.webGLMessage !== null">\n              <p>\n                {{ctrl.webGLMessage}}\n                <br/>\n                <a ng-if="ctrl.coreWebGLSupportMissingOrIncomplete()" ng-click="ctrl.openWebGLHelp()" href="">{{"Click here to learn more about the system requirements." | i18next}} </a>\n                <a ng-if="ctrl.coreWebGLSupportHasOtherProblem()" ng-click="ctrl.openWebGLHelp()" href="">{{"Click here to learn more about the system requirements." | i18next}} </a>\n              </p>\n              <p class="os-check-sub-message" ng-if="ctrl.coreWebGLSupportMissingOrIncomplete()">\n                {{ \'You may use the link below to check if your graphics card is blocklisted, which may block WebGL support on this browser.\' | i18next}}\n                <br/>\n                <a target="_blank" href="https://www.khronos.org/webgl/wiki/BlacklistsAndWhitelists">{{"Graphics driver black and white lists." | i18next}} </a>\n              </p>\n              <p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class="card os-compatibility-section" ng-if="ctrl.isSupportedDesktopBrowser() && ctrl.rendererInfo !== null">\n        <div class="card-header">\n          <h4 class="card-title">\n            <a data-bs-toggle="collapse" data-target="#renderingSupportPanel"\n               href="#renderingSupportPanel" class="collapsed">\n              {{"Renderer" | i18next}}\n            </a>\n          </h4>\n        </div>\n        <div id="renderingSupportPanel" class="accordion-collapse collapse show renderer-panel">\n          <div class="card-body">\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'GL renderer\' | i18next}}</div>\n              <div class="os-sub-item-value">{{ ctrl.getRenderInfoString(ctrl.rendererInfo.glRenderer, true)}}</div>\n            </div>\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'GL vendor\' | i18next}}</div>\n              <div class="os-sub-item-value">{{ ctrl.getRenderInfoString(ctrl.rendererInfo.glVendor, false)}}</div>\n            </div>\n\n            <div class="os-check-message" ng-if="ctrl.getIsIntegratedGpu(ctrl.rendererInfo.glRenderer)">\n              <div><img src="/images/iconWarning.svg"> {{ \'Your system is running an integrated GPU. If you have a dual-GPU system with a discrete chipset (NVIDIA or AMD) you can get better performance by forcing the browser to use the discrete GPU. See\' | i18next}} <a href="{{ctrl.webGlHelpPage}}" target="help">{{ \'Graphics Performance Recommendations\' | i18next }}</a> {{ \'for more information.\' | i18next }}</div>\n            </div>\n\n            <div class="os-check-message" ng-if="ctrl.getIsFirefox()">\n              <div>{{ \' ⃰ Firefox hides GPU details from browser applications.\' | i18next}} </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class="card os-compatibility-section performance-check" ng-if="ctrl.isPerformanceCheckEnabled()">\n        <div class="card-header">\n          <h4 class="card-title">\n            <a data-bs-toggle="collapse" data-target="#performanceCheckBody"\n               href="#performanceCheckBody">\n              {{"Performance check" | i18next}}\n            </a>\n          </h4>\n          <img ng-if="ctrl.performanceResult && ctrl.performanceResult.testSkippedDueToLowRefreshRate === false" src="/images/iconDone.svg">\n          <img ng-if="ctrl.performanceResult && ctrl.performanceResult.testSkippedDueToLowRefreshRate === true" src="/images/iconFailed.svg">\n        </div>\n        <div id="performanceCheckBody" class="accordion-collapse collapse show">\n          <div class="card-body">\n            <div class="os-check-item" ng-if="!ctrl.performanceResult && !ctrl.performanceError">\n              <div class="os-sub-item-name">\n                <div class="spinner os-spinner-small os-spinner-spinning"></div> {{"Measuring performance. For best results: keep tab in focus until performance check is complete." | i18next}}\n              </div>\n            </div>\n            <div ng-if="ctrl.performanceResult">\n              <div ng-if="ctrl.performanceResult.testSkippedDueToLowRefreshRate">\n                <div class="os-sub-item-name">\n                  {{"The performance test was not run because the browser is refreshing below 60 frames per second.  (Measured rate: " | i18next}}{{ctrl.performanceResult.refreshRate | number:1}}{{" frames/second) Verify that the browser is using the expected GPU and your display is refreshing at 60hz or greater.\n                  Ensure that the browser tab is in focus until the performance check is complete. For information on graphics performance, visit: " | i18next}}\n                  <a href="{{ctrl.webGlHelpPage}}" target="help">{{"Troubleshooting the performance check" | i18next}}</a>\n                </div>\n                <br />\n              </div>\n              <div ng-if="!ctrl.performanceResult.testSkippedDueToLowRefreshRate">\n                <div class="os-check-item">\n                  <div class="os-sub-item-name">{{"Overall performance*" | i18next}}</div>\n                  <div class="os-sub-item-value">\n                    <div class="performance-gauge">\n                      <div class="performance-gauge-indicator" style="margin-left: {{ctrl.performanceResult.scorePercent}}%"></div>\n                    </div>\n                  </div>\n                </div>\n                <div class="os-check-item">\n                  <div class="os-sub-item-name">{{"Measured triangles per second" | i18next}}</div>\n                  <div class="os-sub-item-value">{{ctrl.performanceResult.millionTrianglesPerSecond | number:1}} {{"million" | i18next}}{{ctrl.performanceResult.trianglesPerSecondMeasurementHaltedEarly ? "+" : ""}}</div>\n                </div>\n                <div class="os-check-item">\n                  <div class="os-sub-item-name">{{"Measured lines per second" | i18next}}</div>\n                  <div class="os-sub-item-value">{{ctrl.performanceResult.millionLinesPerSecond | number:1}} {{"million" | i18next}}{{ctrl.performanceResult.linesPerSecondMeasurementHaltedEarly ? "+" : ""}}</div>\n                </div>\n                <div class="os-check-item" ng-if="ctrl.isDebugCapabilityEnabled">\n                  <div class="os-sub-item-name">Measurement time (debug)</div>\n                  <div class="os-sub-item-value">{{ctrl.performanceResult.executionTimeMs / 1000 | number:1}} seconds</div>\n                </div>\n                <div class="os-check-item" ng-if="ctrl.isDebugCapabilityEnabled">\n                  <div class="os-sub-item-name">Browser Refresh Rate (debug)</div>\n                  <div class="os-sub-item-value">{{ctrl.performanceResult.refreshRate | number:1}} frames/second</div>\n                </div>\n                <div ng-if="ctrl.isAnyInteractiveGraphicsSettingForceDisabled()">\n                  <br/>\n                  {{ctrl.getInteractiveGraphicsSettingForceDisabledMessage()}}\n                </div>\n                <br />\n                <div>{{"*For information on graphics performance, visit:" | i18next}} <a href="{{ctrl.webGlHelpPage}}" target="help">{{"Graphics Performance Recommendations" | i18next}}</a></div>\n              </div>\n            </div>\n            <p ng-if="ctrl.performanceError">{{ctrl.performanceError}}</p>\n          </div>\n        </div>\n      </div>\n\n      <div class="card os-compatibility-section websockets-check" ng-if="ctrl.isSupportedDesktopBrowser()">\n        <div class="card-header">\n          <h4 class="card-title">\n            <a data-bs-toggle="collapse" data-target="#websocketsPanelBody"\n               href="#websocketsPanelBody">\n              {{"WebSockets" | i18next}}\n            </a>\n          </h4>\n          <div class="os-panel-image websockets-indicator">\n            <img ng-if="ctrl.websocketResult && ctrl.websocketResult.websocketSuccess === true" src="/images/iconDone.svg">\n            <img ng-if="ctrl.websocketResult && ctrl.websocketResult.websocketSuccess === false" src="/images/iconFailed.svg">\n          </div>\n        </div>\n        <div id="websocketsPanelBody" class="accordion-collapse collapse show">\n          <div class="card-body">\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'WebSocket connection\' | i18next}}</div>\n              <div class="os-sub-item-image websocket-indicator">\n                <div ng-if="!ctrl.websocketResult" class="spinner os-spinner-small os-spinner-spinning"></div>\n                <img ng-if="ctrl.websocketResult && ctrl.websocketResult.websocketSuccess === true" src="/images/iconDone.svg">\n                <img ng-if="ctrl.websocketResult && ctrl.websocketResult.websocketSuccess === false" src="/images/iconFailed.svg">\n              </div>\n            </div>\n            <p ng-if="ctrl.websocketResult && ctrl.websocketResult.websocketSuccess === false">{{ \'There was a problem creating a WebSocket to Onshape\\\'s servers.  This usually means you are using an HTTP proxy which does not support WebSockets.\' | i18next}}</p>\n          </div>\n        </div>\n      </div>\n\n      <div class="card os-compatibility-section">\n        <div class="card-header">\n          <h4 class="card-title">\n            <a data-bs-toggle="collapse" data-target="#regionPanel"\n               href="#regionPanel" class="collapsed">\n              {{"Geographical data" | i18next}}\n            </a>\n          </h4>\n        </div>\n        <div id="regionPanel" class="accordion-collapse collapse show region-panel">\n          <div class="card-body">\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'Location\' | i18next }}</div>\n              <div class="os-sub-item-value">{{ ctrl.clientLocation }}</div>\n            </div>\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'Onshape server region\' | i18next }}</div>\n              <div class="os-sub-item-value">{{ ctrl.region }}</div>\n            </div>\n            <div class="os-check-item">\n              <div class="os-sub-item-name">{{ \'Expected server region\' | i18next}}</div>\n              <div class="os-sub-item-value">{{ ctrl.expectedRegion }}</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if="!ctrl.allChecksPassed()" class="card os-compatibility-section reportPanel">\n        <div class="card-header">\n          <h4 class="card-title">\n            {{"Report" | i18next}}\n          </h4>\n        </div>\n        <div class="card-body">\n          <os-download-link id="downloadReport" file-name="OnshapeCompatibilityReport.json" link-text="{{ \'Download report\' | i18next}}" download-method="ctrl.getReport()" ng-if="ctrl.isReportReady()"></os-download-link>\n        </div>\n      </div>\n      <div class="os-check-button-container" ng-if="ctrl.allChecksPassed()">\n        <span class="os-check-goto-button"><a class="btn btn-primary" href="/documents">{{ \'Go to Onshape\' | i18next }}</a></span>\n      </div>\n    </div>\n    <div class="os-filler"></div>\n  </div>\n  <canvas id="testCanvas" data-view-shown="unknown"></canvas>\n</div>\n')}]),e.exports=n},3054:function(e,t,i){var n="/project/web/woolsthorpe/app/partials/confirmDeleteDialog.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="delete-documents-container">\n    <div class="modal-header">\n        <h4 class="modal-title">{{ctrl.messageTitle}}</h4>\n        <button type="button" class="btn-close" aria-hidden="true" ng-click="$dismiss()"></button>\n    </div>\n    <div class="modal-body">\n        <strong>\n            <span class="info-message-margin">{{ ctrl.infoMessageForDeletableItems }}</span>\n        </strong>\n        <a class="btn-link" ng-click="ctrl.toggleShowDetailsOfDeletableItems()" ng-if="!ctrl.isInTrash">\n            <span ng-if="ctrl.hideDetailsOfDeletableItems">{{\'Show details\' |i18next}}</span>\n            <span ng-if="!ctrl.hideDetailsOfDeletableItems">{{\'Hide details\' |i18next}}</span>\n        </a>\n    </div>\n    <div ng-hide="ctrl.hideDetailsOfDeletableItems && !ctrl.isInTrash" class="overflow-documents overflow-documents-border">\n        <div ng-repeat="tempDocument in ctrl.deletableDocuments" class="os-row temp-document-rows">\n            <span ng-if="tempDocument.typeIcon">\n                <osc-svg-icon icon="{{tempDocument.typeIcon}}" class="osc-svg-