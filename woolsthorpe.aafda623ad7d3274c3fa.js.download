entPropertiesController.configureElementProperty(property)"\n                  ng-class="{ \'disabled\' : configuredElementPropertiesController.getIsPropertyAlreadyConfigured(property) }">\n                  <span>{{ configuredElementPropertiesController.getPropertyDisplayName(property) }}</span>\n                </a>\n              </li>\n            </ul>\n          </div>\n        </div>\n        \x3c!-- Use ng-show nested inside an ng-if to solve BEL-79834 (each dropdown needs its own angular scope which is provided by ng-if but also needs the ng-show so that the dropdown isn\'t removed (so it can get all of its events) --\x3e\n        <div ng-if="true" class="os-row">\n          <li class="dropdown os-table-more-button-container"\n              ng-show="configuredElementPropertiesController.getShouldShowTableMenu()">\n            <a data-bs-toggle="dropdown"\n               class="os-table-more-button-control"\n               ng-click="$parent.removeContextMenuStyle(true)">\n              <os-svg icon="overflow"></os-svg>\n            </a>\n            <ul class="dropdown-menu dropdown-menu-end os-table-more-menu">\n              <li ng-if="configuredElementPropertiesController.getCanCopyActiveTable()">\n                <a class="dropdown-item" os-clipboard\n                   os-generate-clipboard-text="configuredElementPropertiesController.copyActiveTableToClipboard()"\n                   os-clipboard-success="configuredElementPropertiesController.onCopyTableSuccess();"\n                   os-clipboard-error="configuredElementPropertiesController.onCopyTableFailed(e);">{{ "Copy table" | i18next}}</a>\n              </li>\n              <li ng-if="configuredElementPropertiesController.getCanDeleteActiveTable()">\n                <a class="dropdown-item" ng-click="configuredElementPropertiesController.deleteActiveTable()">{{ \'Delete table for __assemblyName__\' | i18next:{assemblyName: configuredElementPropertiesController.getPropertiesMenuLabel()} }}</a>\n   