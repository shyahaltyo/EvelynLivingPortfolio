"/project/web/ts/variables/variableTables.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'\x3c!-- Tables if available. --\x3e\n<div class="tables-container variable-tables-container variable-tables" os-table-container>\n  <div class="single-table-container single-variable-table-container disable-select"\n        ng-repeat="variableTable in variableTableController.variableTables">\n    \x3c!-- Table header. --\x3e\n    <div class="draggable-header" data-table-id="{{ variableTable.getReferenceId() }}"\n         ng-class="{\'is-draggable\': variableTable.getCanMoveReference()}">\n      <div class="os-table-header os-no-shrink os-justify-between os-table-description"\n          ng-style="variableTable.getHeaderStyle()">\n        <div class="os-table-header-responsive-first-row"\n            ng-class="{\'is-editing-title\': variableTable.nameBtParameter.getIsInFocus()}">\n          <div class="compact-table-row-clickable"\n              ng-click="variableTable.toggleIsExpanded($event)">\n            <os-svg\n              class="os-icon-xsmall"\n              icon="{{variableTable.isExpanded ? \'expanded\' : \'collapsed\'}}">\n            </os-svg>\n          </div>\n          \x3c!-- Indicators for variable studio references: entire, partial, automatic. --\x3e\n          <div class="table-header-icon reference-icon" ng-if="variableTable.isVariableStudioReference()"\n               data-bs-original-title="{{ variableTable.getTooltip() }}"\n               data-bs-placement="left">\n            <os-svg icon="{{ variableTable.getIcon() }}"></os-svg>\n          </div>\n          \x3c!-- If we can rename the table, show a string parameter. --\x3e\n          <div class="editable-title" ng-if="variableTable.getCanRenameTable()">\n            <span class="os-table-title-sizer os-table-display-name">{{variableTable.nameBtParameter.getPendingStringValue()}}</span>\n            <div class="title-parameter"\n                os-parameter="variableTable.nameBtParameter"\n                data-bs-original-title="{{ variableTable.nameBtParameter.getParameterError() }}">\n            </div>\n          </div>\n          \x3c!-- Else, just show a title. --\x3e\n          <div class="os-table-title variable-table-title"\n              ng-if="!variableTable.getCanRenameTable()"\n              ng-class="{\'title-error\': variableTable.isFailedReference()}">\n            {{variableTable.getTableDisplayName()}}\n          </div>\n          \x3c!-- referenced variable studio version and update --\x3e\n          <div class="table-header-icon version-icon" ng-if="variableTableController.getShouldShowVersionInfo(variableTable)"\n              ng-click="variableTableController.revisionIconClick(variableTable)"\n              data-bs-original-title="{{ variableTable.getVersionTooltip() }}">\n            <os-svg icon="{{ variableTableController.getVersionIcon(variableTable) }}"></os-svg>\n          </div>\n          <div class="os-table-title os-table-header-addon" ng-if="variableTable.getHasLocationString()">\n            {{ variableTable.locationString }}\n          </div>\n          <div class="table-header-icon reference-icon status-icon"\n               ng-if="variableTable.getHasStatus()">\n            <os-svg icon="{{ variableTable.getStatusIcon() }}"\n                    class="os-icon-small"\n                    data-bs-original-title="{{ variableTable.getStatusMessage() }}"></os-svg>\n          </div>\n        </div>\n\n        \x3c!-- variable table more button --\x3e\n        \x3c!-- Use ng-show nested inside an ng-if to solve BEL-79834 (each dropdown needs its own angular scope which is provided by ng-if but also needs the ng-show so that the dropdown isn\'t removed (so it can get all of its events) --\x3e\n        <div ng-if="true" class="os-no-shrink">\n          <li class="dropdown os-table-more-button-container"\n              ng-show="variableTable.getShouldShowTableMenu()">\n            <a data-bs-toggle="dropdown"\n              class="os-table-more-button-control"\n              ng-click="$parent.removeContextMenuStyle(true)">\n              <os-svg icon="overflow"></os-svg>\n            </a>\n\n            <ul class="dropdown-menu dropdown-menu-end os-table-more-menu"\n                ng-class="variableTable.getThreeDotMenuClass($index)">\n              <li ng-if="variableTable.getCanCopyTable()">\n                <a class="dropdown-item" os-clipboard\n                  os-generate-clipboard-text="variableTable.copyTableDataForClipboard()"\n                  os-clipboard-success="variableTable.onCopyTableSuccess();"\n                  os-clipboard-error="variableTable.onCopyTableFailed(e);">{{ "Copy table" | i18next}}</a>\n              </li>\n\n              <li ng-if="variableTable.getCanRenameTable()">\n                <a class="dropdown-item" ng-click="variableTable.startTableRename()">{{ "Rename" | i18next }}</a>\n              </li>\n              <li ng-if="variableTable.getCanGoToVariableStudio()">\n                <a class="dropdown-item" ng-click="variableTable.goToVariableStudio()">{{ variableTable.getGoToVariableStudioLabel() }}</a>\n              </li>\n              <li ng-if="variableTable.getCanShowUpdateLinkedDocument()">\n                <a class="dropdown-item" ng-click="variableTableController.revisionIconClick(variableTable)">{{ "Update linked document…" | i18next }}</a>\n              </li>\n              <li ng-if="variableTableController.moveVariableTableManager.getCanMoveTableUp(variableTable.getReferenceId())">\n                <a class="dropdown-item" ng-click="variableTableController.moveVariableTableManager.moveTableUp(variableTable.getReferenceId())">{{ "Move up" | i18next }}</a>\n              </li>\n              <li ng-if="variableTableController.moveVariableTableManager.getCanMoveTableDown(variableTable.getReferenceId())">\n                <a class="dropdown-item" ng-click="variableTableController.moveVariableTableManager.moveTableDown(variableTable.getReferenceId())">{{ "Move down" | i18next }}</a>\n              </li>\n              <li ng-if="variableTableController.getCanExpandAllTables()">\n                <a class="dropdown-item" ng-click="variableTableController.expandAllVariableTables()">{{ "Expand all tables" | i18next}}</a>\n              </li>\n              <li ng-if="variableTableController.getCanCollapseAllTables()">\n                <a class="dropdown-item" ng-click="variableTableController.collapseAllVariableTables()">{{ "Collapse all tables" | i18next}}</a>\n              </li>\n              <li ng-if="variableTable.getCanEditReference()">\n                <a class="dropdown-item" ng-click="variableTableController.editVariableTableReference(variableTable)">{{ "Edit reference…" | i18next }}</a>\n              </li>\n              <li ng-if="variableTable.getCanRemoveReference()">\n                <a class="dropdown-item" ng-click="variableTable.removeReference()">{{ "Remove reference" | i18next }}</a>\n              </li>\n              <li ng-if="variableTableController.getCanShowCreateTaskMenuItem()">\n                <a class="dropdown-item" ng-click="variableTableController.showTaskDialog(variableTable.fullTableId)">{{ "Create task…" | i18next }}</a>\n              </li>\n            </ul>\n          </li>\n        </div>\n      </div>\n    </div>\n    \x3c!-- Table. --\x3e\n    <div ng-show="variableTable.isExpanded">\n      <os-table ng-if="!variableTable.isFailedReference()"\n                bt-table="variableTable.btTable"\n                resizable="true"\n                data-parameter-id="{{variableTable.btTable.getTableId()}}"\n                context-menu-manager="variableTable.contextMenuManager"\n                cell-parameter-manager="variableTable.cellParameterManager"\n                add-row-manager="variableTable.addRowManager"\n                highlight-manager="variableTable.highlightManager"\n                move-row-manager="variableTable.moveRowManager"\n           