\' | i18next}}</span></div>\n                <div class="company-details-body company-seat-count">\n                  <company-seat-component company-name="ctrl.companyName" purchase-details="ctrl.purchaseDetails" user-seat-desc="ctrl.userSeatDescription" change-seats="ctrl.changeSeats(seatsVal)" disable-submit="ctrl.disablePurchase()" confirm-purchase="ctrl.doConfirmPurchase(osForm)"></company-seat-component>\n                </div>\n              </div>\n              <div class="os-form-group">\n                <osx-payment-options ng-if="ctrl.shouldShowPaymentOptions()"></osx-payment-options>\n                <div class="clearfix"></div>\n              </div>\n              <div ng-if="ctrl.currentPlan && !ctrl.processingPayment && !ctrl.purchaseComplete" class="purchase-action">\n                <button class="btn btn-primary"\n                        ng-if="ctrl.isFreePurchase || ctrl.isReviewShow()"\n                        ng-click="ctrl.doConfirmPurchase(osForm)"\n                        type="submit"\n                        ng-disabled="osForm.$invalid || ctrl.disablePurchase() || ctrl.isServerError || ctrl.isInitError">\n                  {{ ctrl.getPurchaseButtonValue() }}\n                </button>\n                <button class="btn btn-secondary" ng-if="ctrl.isFreePurchase" ng-click="ctrl.cancel()">\n                  {{ "Cancel" | i18next }}\n                </button>\n              </div>\n            </div>\n          </os-form>\n        </div>\n        <div ng-if="ctrl.showConfirmation" class="os-payment-options-container">\n          <osx-payment-confirmation\n            [account-details]="ctrl.accountDetails"\n            [current-plan]="ctrl.currentPlan"\n            [owner-included-as-subscriber]="ctrl.ownerIncludedAsSubscriber"\n            [purchase-details]="ctrl.purchaseDetails"\n            [show-prorated-message]="ctrl.showProratedMessage()"\n            [show-company-option]="ctrl.showCompanyOption"\n            (cancel-subscription-e