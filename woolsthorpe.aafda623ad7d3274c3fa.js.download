ion.document.id}}"\n                        workspace-id=""\n                        version-id="{{anOption.version.id}}"\n                        element-id="{{anOption.elementId}}"\n                        api-configuration="{{$ctrl.getApiconfigForThumbnail(anOption)}}"\n                        ideal-height="170"\n                        ideal-width="300"\n                        document-thumbnail-stamp="{{}}"\n                        fallback-image="{{$ctrl.getFallBackImage(anOption)}}"\n                        require-config-match="true"\n                        watch-changes="true">\n                      </os-thumbnail>\n                    </span>\n                  </div>\n                </li>\n                <div ng-if="$ctrl.canShowConfigFilterMore()" class="show-more-less dropdown-item" ng-click="$ctrl.stopPropagation($event)">\n                  <span\n                    ng-if="!$ctrl.showingMoreConfigFilters"\n                    ng-click="$ctrl.toggleMoreConfigFilters($event)">\n                    {{\'Show more\' | i18next}}\n                  </span>\n                  <span ng-if="$ctrl.showingMoreConfigFilters"\n                    ng-click="$ctrl.toggleMoreConfigFilters($event)">\n                    {{\'Show less\' | i18next}}\n                  </span>\n                  </div>\n              </ul>\n            </div>\n          </div>\n          \x3c!-- end configuration filter dropdown --\x3e\n          \x3c!-- configuration versions dropdown --\x3e\n          <div ng-if="!$ctrl.isNewSource && $ctrl.canShowConfigVersionFilter()" class="os-row filter-container">\n            <div class="os-row">\n              <div id="where-used-source-filter">\n                <div ng-if="$ctrl.deDupeVersionFilters.length === 0" class="os-where-used-filter-dropdown os-row os-grow">\n                  <div class="ellipseOverflowText selected-filter-name">\n                    <span ng-if="\'all\' !== $ctrl.selectedConfigVersion.id">\n                      