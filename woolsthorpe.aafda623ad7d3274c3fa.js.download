olor(float value, vec4 normalColor) {\n  vec4 outColor = normalColor;\n  if (uUseMinColor && value < 0.0) {\n    outColor = uMinColor;\n  } else if (uUseMaxColor && 1.0 < value) {\n    outColor = uMaxColor;\n  }\n  return outColor;\n}\n\nvec4 sampleBlendedHighlightColor(float value, vec4 normalColor) {\n  float blendDistance = 0.0;\n\n  // Convert blend distance to absolute distance\n  float blendMaxDistance = uHighlightRegionBlendDistance * uScalarOutputMagnitudeInverse;\n  vec4 outColor = normalColor;\n\n  // Use a highlight color if a given value is within `uHighlightRegionBlendDistance` of its\n  // target value. If it's within `uHighlightRegionBlendDistance`, but outside of the true range,\n  // then we calculate what percent of the way it is towards the true value, then use that to\n  // blend between the background color and the highlight color.\n  if (uUseMinColor && value < blendMaxDistance) {\n    // Min region (-Inf, 0.0 + blendDistance)\n    blendDistance = max(0.0, value);\n    outColor = uMinColor;\n  } else if (uUseMaxColor && 1.0 < value + blendMaxDistance) {\n    // Max region (1.0 - blendDistance, Inf)\n    blendDistance = max(0.0, 1.0 - value);\n    outColor = uMaxColor;\n  }\n\n  if (blendDistance > 0.0) {\n    float blendMaxWidthInverse = uHighlightRegionBlendDistanceInverse * uScalarOutputMagnitude;\n    float blendProgress = min(blendDistance * blendMaxWidthInverse, 1.0);\n\n    // Use `sampleBackgroundColor` here to ensure that we blend from one highlight region to\n    // another if they are adjacent, rather than relying on the potentially incorrect normal color.\n    vec4 backgroundColor = sampleBackgroundColor(value, normalColor);\n    vec4 blendedColor = mix(outColor, backgroundColor, blendProgress);\n    return blendedColor;\n  }\n\n  return outColor;\n}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    float toBeVisualized = vTextureCoordinate[0];\n\n    // By default we don't visualize. Instead, set the color as we would in the shaded mode.\n    // The toBeVisualized should only be 0.0 (not visualized) or 1.0 (visualized).  However,\n    // there are some precision issues that arise on nvidia drivers in perspective mode (BEL-193801),\n    // hence we make the comparison more tolerant by not directly comparing to those values.\n    if (toBeVisualized < 0.5) {\n      FRAG_COLOR = lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n      return;\n    }\n\n    float scalarValue = vTextureCoordinate[1];\n    if (uMakeUnsigned) {\n      scalarValue *= sign(scalarValue);\n    }\n\n    // Here we map the vertex's scalar value (stored in the texture coordinate) to a texture coordinate\n    // value mapped to 0-1.  This mapping is based on the scalar output range, which can be dynamically adjusted\n    // by the user.\n    float normalizedValue = (uScalarOutputMax - scalarValue) * uScalarOutputMagnitudeInverse;\n    vec2 shiftedCoordinate = vec2(0.0, clamp(normalizedValue, 0.0, 1.0));\n\n    vec4 color = uUseDimColor ? uDimColor : TEXTURE_2D(uAmbientTexture, shiftedCoordinate);\n    vec4 blendedColor = sampleBlendedHighlightColor(1.0 - normalizedValue, color);\n\n    if (uOutsideIsolation) {\n      blendedColor.a *= uIsolateContextOpacity;\n    }\n\n    FRAG_COLOR = blendedColor;\n}\n"},7273:function(e,t){"use strict";t.Z="{{{compatibility}}}\n\nFRAG_IN highp vec3 vPosition;\nFRAG_IN lowp vec3 vNormal;\nFRAG_IN mediump vec2 vTextureCoordinate;\nFRAG_IN lowp vec3 vAmbient;\nFRAG_IN lowp vec3 vDiffuse;\nFRAG_IN lowp vec3 vSpecular;\nFRAG_IN lowp float vOpacity;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n\nDECLARE_FRAG_COLOR\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    FRAG_COLOR = lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n}\n"},10705:func