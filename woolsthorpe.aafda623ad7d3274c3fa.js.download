/app/partials/exportPartsStl.html\'"></div>\n      <div class="form-group" ng-show="options.format.name === \'GLTF\' || options.format.name === \'OBJ\' || options.format.name === \'3MF\'" ng-include="\'/project/web/woolsthorpe/app/partials/exportPartsWithResolution.html\'"></div>\n      <div class="form-group form-check" ng-show="options.format.name === \'IGES\'">\n        <label class="checkbox os-export-checkbox-label form-check-label">\n          <input class="form-check-input" type="checkbox" ng-model="options.useIgesCompatibilityMode" value="individual">{{ "Use compatibility mode for surfaces and curves" | i18next }}\n        </label>\n      </div>\n      <div class="form-check" ng-show="isElementNative && options.format.name === \'GLTF\' && isUseGltfCompressionEnabled">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n        <input id="compression-checkbox" class="form-check-input" type="checkbox" ng-model="options.useGltfCompression">{{"Compress" | i18next}}</label>\n      </div>\n      <div class="form-group">\n        <label class="control-label">{{ "Options" | i18next }}</label>\n        <select class="form-control" id="export-options-dropdown" tabindex="3" ng-model="download.option"\n                ng-options="n as n.label disable when n.disabled for n in download.options | filter:{disabled:false}" ng-change="onChangeExportOption()"></select>\n      </div>\n      <div class="form-group form-check" ng-if="!isCAMToolPathExport() && !isUrdfExport()" id="export-multiple-file-checkbox" ng-show="!isSinglePartExport">\n        <label class="checkbox form-check-label os-export-checkbox-label">\n          <input class="form-check-input" type="checkbox" ng-model="download.shouldExportPartsAsIndividualFiles" ng-change="onShouldExportPartsAsIndividualFilesChanged()" value="individual">{{ "Export unique parts as individual files" | i18next }}\n        </label>\n      </div>\n        \x3c!-- Duplicated the "Apply Export Rule to Contents" check box for the case of Multi Part export,\n        so that it appears as a child option of "Export unique parts as individual files" BEL-162020--\x3e\n        <div ng-if="!isCAMToolPathExport() && download.shouldExportPartsAsIndividualFiles && canApplyMultiElementOrMultiPartExportRule() && isMultiPartExport()">\n            <div class="form-group form-check multi-part-export" id="export-rule-for-multiple-part-checkbox">\n                <label class="checkbox form-check-label os-export-checkbox-label">\n                    <input class="form-check-input" type="checkbox" ng-model="download.applyExportRulesForContents" value="individual">{{ "Apply export rules to contents" | i18next }}\n                </label>\n                <a class="export-rules-link multi-export-rules-link" href="{{ exportRulesSettingsLink }}" target="_blank">{{ "View export rules" | i18next }}</a>\n            </div>\n        </div>\n      <div ng-show="!isCAMToolPathExport() && allowHiddenEntitiesExport()">\n        <div class="form-group form-check">\n          <label class="checkbox form-check-label os-export-checkbox-label">\n            <input ng-disabled="isUrdfExport()" id="export-hidden-entities-checkbox" class="form-check-input" type="checkbox" ng-model="options.includeHiddenEntities">{{ "Include hidden instances in export" | i18next }}\n          </label>\n        </div>\n        <div class="alert alert-warning" ng-if="!!hiddenEntitiesWarning && !options.includeHiddenEntities">\n          <os-svg icon="performance-warning"></os-svg>\n          <span class="error-message">\n            {{ hiddenEntitiesWarning }}\n          </span>\n        </div>\n      </div>\n      <div ng-if="!isCAMToolPathExport() && isMultiElementExport() && canApplyMultiElementOrMultiPartExportRule()">\n        <div class="form-group form-check" id="export-rule-for-multiple-file-checkbox">\n          <label class="checkbox form-check-label os-export-checkbox-label">\n            <input class="form-check-input" type="checkbox" ng-model="download.applyExportRulesForContents" value="individual">{{ "Apply export rules to contents" | i18next }}\n          </label>\n          <a class="export-rules-link multi-export-rules-link" href="{{ exportRulesSettingsLink }}" target="_blank">{{ "View export rules" | i18next }}</a>\n        </div>\n      </div>\n      <div ng-if="isEmailAttachmentOptionSelected()">\n        <div class="form-group" id="export-email-to">\n          <label class="control-label">{{ "To" | i18next }}<span class="text-danger"  data-bs-original-title="{{\'Required\' | i18next}}" data-bs-placement="right">*</span></label>\n          <os-suggestions class="add-email"\n            get-suggestions="findFriends(query)"\n            is-valid-new-suggestion="isValidEmail(query)"\n            os-input-tokens\n            on-suggestion-selected="TokenController.addToken(suggestion)"\n            placeholder="{{ \'Add recipients\' | i18next }}">\n          </os-suggestions>\n        </div>\n\n        <div class="form-group">\n          <label class="control-label">{{ "Subject" | i18next }}</label>\n          <input class="form-control" type="text" ng-trim="true" maxlength="{{ MAX_INPUT_LENGTHS.name }}" ng-model="emailAsAttachment.subject">\n        </div>\n\n        <div class="form-group">\n          <label class="control-label">{{ "Message" | i18next }}</label>\n          <span ng-if="exportForm.message.$error.maxlength" class="fst-italic text-danger">{{"Character limit exceeded" | i18next}}</span>\n          <textarea class="form-control" ng-model-options="{ allowInvalid: true }" ng-maxlength="MAX_INPUT_LENGTHS.description" ng-class="{\'border-danger\' : exportForm.message.$error.maxlength}" rows="3" cols="40" ng-model="emailAsAttachment.message" name="message" placeholder="{{ \'Optional: include a personal message\' | i18next }}" ng-trim="false"></textarea>\n          <span class="d-flex justify-content-end" ng-class="{\'text-danger\' : exportForm.message.$error.maxlen