>\n                <div class="dropdown-menu dropdown-menu-end">\n                  <a class="dropdown-item" href="/c/manage/windchill/jobs" target="_blank">{{\'Job queue\' | i18next}}</a>\n                </div>\n              </div>\n                <button class="os-button billofmaterials-open-bom-in-plm-button"\n                        ng-if="bomController.showSyncedItemLinkBtn()"\n                        ng-click="bomController.onSyncedItemLinkBtnClick()"\n                        ng-disabled="bomController.isSyncedItemLinkBtnDisabled()"\n                        data-bs-original-title="{{ \'tooltips:::Open in __pLMName__\' | i18next:{ pLMName: bomController.activeWorkflow.pLMName } }}">\n                    <os-svg icon="{{bomController.openSyncedItemIcon()}}" data-bs-original-title="{{bomController.syncedItemLinkBtnTooltip()}}"></os-svg>\n                </button>\n            </div>\n            <div class="os-table-header-responsive-last-row bom-header-flex-wrap">\n              <div ng-if="bomController.allowItemsManagement"\n                   class="billofmaterials-insert-items-button"\n                   data-bs-original-title="{{\'tooltips:::Insert items\' | i18next}}"\n                   data-bs-placement="right"\n                   ng-click="bomController.openInsertItemsDialog()">\n                <os-svg icon="insert-item-button"></os-svg>\n              </div>\n              <div class="dropdown os-add-property-dropdown add-bom-column" auto-close="outsideClick"\n                     data-bs-original-title="{{\'tooltips:::Add columns to the BOM table\' | i18next}}"\n                     data-bs-placement="left">\n                <div data-bs-toggle="dropdown"\n                     class="dropdown-toggle btn btn-secondary btn-sm small-secondary-btn manage-columns-button"\n                     data-bs-offset="0,0"\n                     ng-click="bomController.retrieveColumns()"\n                     >{{ "Add column" | i18next }}&ensp;\n                <