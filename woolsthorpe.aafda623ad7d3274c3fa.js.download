      <span ng-if="$ctrl.isProAccount() && !$ctrl.isTrialAccountExpiring()" ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})Upgrade now to continue working with your team after __trialEndDate__ or <a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>contact us</a>."> </span>\n          <span ng-if="!$ctrl.isProAccount() && !$ctrl.isTrialAccountExpiring()" ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})<a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>Contact us</a> to continue editing private documents after __trialEndDate__ or for more information."> </span>\n          <span ng-if="$ctrl.isTrialAccountExpiring()" ng-i18next="[html:i18next]Need more time? <a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>Request a trial extension</a>."></span>\n        </span>\n        <upgrade-component ng-if="!$ctrl.isAccountSidePanelAngular19Enabled" class="os-pin-right try-upgrade-button"></upgrade-component>\n        <osx-plan-upgrade ng-if="$ctrl.isAccountSidePanelAngular19Enabled" class="os-pin-right try-upgrade-button"></osx-plan-upgrade>\n      </span>\n\n      <span class="os-row" id="pro-limits-indicator" ng-if="!$ctrl.isTrialAccountExpired() && $ctrl.isQualifiedForDiscoveryProgram() && !$ctrl.isProDiscoveryTrialRejected()">\n        <span class="os-grow">\n          <span ng-i18next="[html:i18next]({remainingDays:$ctrl.getRemainingTrialPeriod(), trialPlanName:$ctrl.getPlanName(), remainingDaysText:$ctrl.getRemainingTrialPeriodText()})You have <strong>__remainingDays__ __remainingDaysText__</strong> left in your __trialPlanName__ Trial."></span>\n          <span ng-if="$ctrl.isProAccount() && !$ctrl.isStandardPlanBeforeProTrial()" ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})Your company may qualify for up to <strong>6 months</strong> of Onshape Professional at <strong>no cost</strong> through the Onshape Discovery Program."> </span>\n          <span ng-if="$ctrl.isProAccount() && $ctrl.isStandardPlanBeforeProTrial()" ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})Upgrade now to continue working with your team after __trialEndDate__ or <a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>contact us</a>."> </span>\n          <span ng-if="!$ctrl.isProAccount()" ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})<a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>Contact us</a> to continue editing private documents after __trialEndDate__ or for more information."> </span>\n        </span>\n        <button class="btn btn-secondary" ng-if="!$ctrl.isStandardPlanBeforeProTrial()" ng-click="$ctrl.goToGetDiscoveryProgram()" data-bs-original-title=\'{{"Apply for Onshape Discovery Program" | i18next}}\'>\n          {{"Extend Trial" | i18next}}\n        </button>\n        <upgrade-component class="os-pin-right try-upgrade-button" ng-if="!$ctrl.isAccountSidePanelAngular19Enabled && $ctrl.isStandardPlanBeforeProTrial()"></upgrade-component>\n        <osx-plan-upgrade ng-if="$ctrl.isAccountSidePanelAngular19Enabled && $ctrl.isStandardPlanBeforeProTrial()" class="os-pin-right try-upgrade-button"></osx-plan-upgrade>\n      </span>\n\n      <span class="os-grow"\n          id="pro-limits-indicator"\n          ng-if="$ctrl.isTrialAccountExpired() && !$ctrl.isAwaitingDiscoveryApproval()"\n          data-bs-original-title="{{$ctrl.proTrialExpiredWarning}}"\n          data-bs-placement="bottom"\n          ng-i18next="[html:i18next] Your Professional Trial has ended and your team\'s documents are view only. Upgrade now to continue editing or <a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>contact us</a>.">\n      </span>\n\n      <span class="os-grow"\n          id="awaiting-discovery-approval-indicator"\n          ng-if="$ctrl.isAwaitingDiscoveryApproval()"\n          data-bs-original-title="{{$ctrl.awaitingDoscoveryApprovalMessage}}"\n          data-bs-placement="bottom"\n          ng-i18next="[html:i18next] Your application for Onshape Discovery Program is under review. Enjoy this free trial of Onshape Professional while you wait.&nbsp;<a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>Contact us</a>&nbsp;if you have questions or need help.">\n      </span>\n\n      <span class="os-row" id="pro-limits-indicator" ng-if="$ctrl.isProDiscoveryTrialRejected() && $ctrl.isDiscoveryPlanEnabled">\n        <span class="os-grow">\n          <span ng-i18next="[html:i18next]({remainingDays:$ctrl.getRemainingTrialPeriod(), trialPlanName:$ctrl.getPlanName(), remainingDaysText:$ctrl.getRemainingTrialPeriodText() })You have <strong>__remainingDays__ __remainingDaysText__</strong> left in your __trialPlanName__ Trial."></span>\n          <span ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDate() | date }}\'})Upgrade now to continue working with your team after __trialEndDate__ or <a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>contact us</a>."> </span>\n        </span>\n        <upgrade-component ng-if="!$ctrl.isAccountSidePanelAngular19Enabled" class="os-pin-right try-upgrade-button"></upgrade-component>\n        <osx-plan-upgrade ng-if="$ctrl.isAccountSidePanelAngular19Enabled" class="os-pin-right try-upgrade-button"></osx-plan-upgrade>\n      </span>\n    </div>\n    <div class="clearfix"></div>\n  </div>\n\n  \x3c!-- Free User\'s banners --\x3e\n  <div class="os-billing-banner" ng-if="$ctrl.showFreeUserBanner()">\n    <div class="os-plan-area os-row info-message" ng-if="(!$ctrl.hasBeenOnAnyTrial() || $ctrl.hasBeenOnProDiscoveryTrial()) && !$ctrl.isPaidCustomerInPast() && !$ctrl.showTryProfessionalBanner() && !$ctrl.showInactiveCompanyBanner()">\n        <span ng-i18next="[html:i18next]Your <strong>Free</strong> subscription only allows public data. Try Onshape Professional to create, edit and share private data with your team."></span>\n        <div class="try-upgrade-button"><button class="btn btn-secondary" ng-click="$ctrl.goToGetTrial()" data-bs-html="true" data-bs-original-title="{{ $ctrl.trialButtonTooltip }}">{{ $ctrl.trialButtonName }}</button></div>\n    </div>\n    <div class="os-plan-area os-grow os-row info-message" ng-if="(!$ctrl.hasBeenOnAnyTrial() || $ctrl.hasBeenOnProDiscoveryTrial()) && !$ctrl.isPaidCustomerInPast() && $ctrl.showTryProfessionalBanner()">\n      <span ng-i18next="[html:i18next]Your <strong>Free</strong> subscription only allows public data. Try Onshape Professional to create, edit and share private data with your team."></span>\n      <div class="try-upgrade-button"><button class="btn btn-secondary" ng-click="$ctrl.goToGetTrial()" data-bs-html="true" data-bs-original-title="{{ \'Try Onshape Professional\' | i18next }}">{{ "Try Professional" | i18next }}</button></div>\n    </div>\n    <div class="os-plan-area warning-message" ng-if="$ctrl.hasBeenOnAnyTrial() && !$ctrl.hasBeenOnProDiscoveryTrial() && !$ctrl.isPaidCustomerInPast() && !$ctrl.showEducationDowngradeBanner() && !$ctrl.showInactiveCompanyBanner() && $ctrl.showAnyExpiryMessage() && $ctrl.isTrialAccountExpired()">\n      <span\n        ng-i18next="[html:i18next]({onshapeLearnMoreUrl: $ctrl.onshapeLearnMoreUrl})Your Professional Trial has ended and you are now on the Free plan. All your documents are now read-only. Upgrade now to continue editing, or <a class=\'inline-link\' ng-href=\'__onshapeLearnMoreUrl__\' target=\'_blank\'>learn more</a> about this transition.">\n      </span>\n      <upgrade-component ng-if="!$ctrl.isAccountSidePanelAngular19Enabled" class="try-upgrade-button btn-secondary"></upgrade-component>\n      <osx-plan-upgrade ng-if="$ctrl.isAccountSidePanelAngular19Enabled" class="try-upgrade-button btn-secondary"></osx-plan-upgrade>\n    </div>\n    <div class="os-plan-area error-message" ng-if="$ctrl.hasBeenOnAnyTrial() && !$ctrl.isPaidCustomerInPast() && $ctrl.showEducationDowngradeBanner() && $ctrl.showAnyExpiryMessage() && $ctrl.showEducationDowngradeBanner()">\n      <span ng-i18next="[html:i18next] Your Student subscription has ended. You have been downgraded to a Free subscription. If you are still a student, renew your subscription for another year.">\n      </span>\n      <span class="try-upgrade-button"><button class="btn btn-secondary professional-button" ng-click="$ctrl.goToRenewStudentPlan()"\n          data-bs-html="true" data-bs-original-title="{{$ctrl.getEduButtonTooltip()}}">{{"Renew" | i18next}}</button>\n      </span>\n    </div>\n    <div class="os-plan-area info-message" ng-if="$ctrl.isPaidCustomerInPast() && !$ctrl.showInactiveCompanyBanner()">\n      <span ng-i18next="[html:i18next]Your <strong>Free</strong> subscription only allows public data. Upgrade to Onshape Professional to create, edit and share private data with your team."></span>\n      <upgrade-component ng-if="!$ctrl.isAccountSidePanelAngular19Enabled" class="try-upgrade-button" button-style="\'secondary\'"></upgrade-component>\n      <osx-plan-upgrade ng-if="$ctrl.isAccountSidePanelAngular19Enabled" class="try-upgrade-button" button-style="btn-secondary"></osx-plan-upgrade>\n    </div>\n    <div class="os-plan-area os-grow warning-message" ng-if="$ctrl.showInactiveCompanyBanner()">\n      <span ng-i18next="[html:i18next]({companyType: $ctrl.getCompanyType()})Your __companyType__ is <strong>inactive</strong> and all your documents are read-only. To continue editing your documents, upgrade your Onshape subscription or downgrade to a free account."> </span>\n      <div class="try-upgrade-button" ng-if="$ctrl.isCompanyAccountInactive() && $ctrl.isUserProOwner()"><button class="btn btn-secondary" ng-click="$ctrl.manageOnshapeSubscription()" data-bs-original-title=\'{{"Manage Onshape subscription" | i18next}}\'>{{"Manage Onshape subscription" | i18next}}</button></div>\n    </div>\n    <div class="clearfix"></div>\n  </div>\n\n  \x3c!-- Selected Inactive Company Banner --\x3e\n  <div class="os-billing-banner" ng-if="$ctrl.showCompanyInactiveBanner()">\n    <div class="os-plan-area os-grow warning-message">\n      <span ng-i18next="[html:i18next]({companyType: $ctrl.getCompanyType()})Your __companyType__ is <strong>inactive</strong> and all your documents are read-only. To continue editing your documents, upgrade your Onshape subscription or downgrade to a free account."> </span>\n      <div class="try-upgrade-button" ng-if="$ctrl.isCompanyAccountInactive() && $ctrl.isUserProOwner()"><button class="btn btn-secondary" ng-click="$ctrl.manageOnshapeSubscription()" data-bs-original-title=\'{{"Manage Onshape subscription" | i18next}}\'>{{"Manage Onshape subscription" | i18next}}</button></div>\n    </div>\n    <div class="clearfix"></div>\n  </div>\n\n  \x3c!-- Discovery plan banners --\x3e\n  <div class="os-billing-banner" ng-if="$ctrl.showDiscoveryPlanBanner()">\n    <span class="os-plan-area os-row" ng-class="{\'warning-message\': $ctrl.isTrialAccountExpiring(), \'info-message\': !$ctrl.isTrialAccountExpiring()}">\n      <span class="os-grow">\n        <span ng-i18next="[html:i18next]({remainingDays:$ctrl.getRemainingTrialPeriod(), trialPlanName:$ctrl.getPlanName(), remainingDaysText:$ctrl.getRemainingTrialPeriodText() })You have <strong>__remainingDays__ __remainingDaysText__</strong> left in the Onshape Discovery Program."></span>\n        <span ng-if="$ctrl.isOwnerAccountTrialAccount()"><span ng-i18next="[html:i18next]({trialEndDate:\'{{$ctrl.getTrialEndDateFromTrialInfo() | date }}\'})Buy now to continue working with your team after __trialEndDate__ or"></span>&nbsp;<a class="inline-link" ng-click="$ctrl.openDriftWidgetForDiscoveryUser()">{{ "contact us." | i18next}}</a></span>\n        <span  ng-if="!$ctrl.isOwnerAccountTrialAccount()" ng-i18next="[html:i18next]({companyName: $ctrl.getCurrentCompanyName(), trialEndDate:\'{{$ctrl.getTrialEndDateFromTrialInfo() | date }}\'})Contact the owner of <b>__companyName__</b> to buy now to continue working with your team after __trialEndDate__."> </span>\n      </span>\n      <div class="expired-dismiss">\n        <button type="button" class="close" ng-click="$ctrl.dismissProDiscoveryExpiringBanner()" ng-if="!$ctrl.isTrialAccountExpiring()"\n                data-bs-original-title="{{\'Dismiss\' | i18next}}" data-bs-placement="left" aria-hidden="true">×</button>\n        <button ng-if="$ctrl.isOwnerAccountTrialAccount()" class="btn btn-secondary" ng-click="$ctrl.goToUpgrade()">{{"Buy now" | i18next}}</button>\n      </div>\n    </span>\n    <div class="clearfix"></div>\n  </div>\n\n\n  \x3c!-- Edu Standard banners --\x3e\n  <div class="os-billing-banner"\n    ng-if="!$ctrl.showCreditCardBanner && $ctrl.isEducationStandardUser() && ($ctrl.isTrialAccountExpiring() || $ctrl.isTrialAccountExpired()) ">\n    <div class="os-plan-area os-plan-area-flexible os-grow warning-message" ng-if="$ctrl.isTrialAccountExpiring()">\n      <span class="os-grow">\n        <span\n          ng-i18next="[html:i18next]({remainingDays:$ctrl.getRemainingTrialPeriod(), trialPlanName:$ctrl.getPlanName(), remainingDaysText:$ctrl.getRemainingTrialPeriodText() })You have <strong>__remainingDays__ __remainingDaysText__</strong> left in your __trialPlanName__ subscription.">\n        </span>\n        <span\n          ng-i18next="[html:i18next]({planInfoUrl:$ctrl.planInfoUrl})If you are still a student or an educator, renew your subscription for another year. You will be downgraded to the <a class=\'inline-link\' href=\'__planInfoUrl__\' target=\'_blank\'>Free plan</a> at the end of subscription period.">\n        </span>\n      </span>\n      <span class="try-upgrade-button"><button class="btn btn-secondary" ng-click="$ctrl.goToRenewStudentPlan()"\n        data-bs-html="true" data-bs-original-title="{{$ctrl.getEduButtonTooltip()}}">{{"Renew" | i18next}}</button>\n      </span>\n    </div>\n    <div class="clearfix"></div>\n  </div>\n\n  \x3c!-- Show banner to users with \'Educator\' role --\x3e\n  <div class="os-billing-banner" ng-if="$ctrl.showUpgradeToEducatorPlanBanner()">\n    <div class="os-plan-area os-grow info-message">\n      <span class="os-grow">\n        <span ng-i18next="[html:i18next] Our records show that you are an <strong>educator</strong> and may be eligible to upgrade to the Onshape Educator plan."></span>\n      </span>\n      <a class="btn btn-secondary upgrade-for-free-button" ng-href=\'{{$ctrl.upgradeToEducatorPlanUrl}}\' target=\'_blank\'\n        data-bs-original-title="{{\'Upgrade to Educator plan\' | i18next}}" data-bs-placement="left">\n          {{"Upgrade for free" | i18next}}\n      </a>\n    </div>\n  </div>\n\n  \x3c!-- Standard User\'s banners --\x3e\n  <div class="os-billing-banner" ng-if="!$ctrl.showCreditCardBanner && $ctrl.isStandardAccount() && $ctrl.showAnyExpiryMessage() && $ctrl.hasBeenOnProTrial() && $ctrl.isStandardPlanBeforeProTrial() && !$ctrl.isProTrialExpiredBannerDismissed">\n    <div class="os-plan-area os-plan-area-flexible os-grow error-message">\n      <span ng-i18next="[html:i18next]Your Onshape Professional Trial has ended and your account has been downgraded to your previous subscription plan. To continue using our Professional features, upgrade now or <a class=\'inline-link\' href=\'#\' ui-sref=\'onshapeContact\' target=\'_blank\'>contact us</a>.">\n      </span>\n      <div class="expired-dismiss">\n        <button type="button" class="close" ng-click="$ctrl.dismissProTrialExpiredBanner()"\n                data-bs-original-title="{{\'Dismiss\' | i18next}}" data-bs-placement="left" aria-hidden="true">×</button>\n        <upgrade-component ng-if="!$ctrl.isAccountSidePanelAngular19Enabled" class="try-upgrade-button"></upgrade-component>\n        <osx-plan-upgrade ng-if="$ctrl.isAccountSidePanelAngular19Enabled" class="try-upgrade-button"></osx-plan-upgrade>\n      </div>\n    </div>\n    <div class="clearfix"></div>\n  </div>\n</div>\n')}]),e.exports=n},65161:function(e,t,i){var n="/project/web/ts/billing/paymentSidebar.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<div ng-show="ctrl.currentPlan">\n  <div class="os-pro-intro">{{"Subscription summary" | i18next}}</div>\n  <div class="os-pro-heading">\n    <span class="sidebar-heading">{{ ctrl.selectedApp.name }}</span> <span class="sidebar-heading">{{ ctrl.currentPlan.description }}</span>\n  </div>\n  <div class="os-payment-sidebar-separator"></div>\n  <div class="os-payment-summary">\n    <div class="os-pro-subtext os-order-details">{{"Details" | i18next}}</div>\n    <div class="os-payment-sidebar-spacer"></div>\n    <div class="os-payment-sidebar-item plan-details">\n      <span ng-if="ctrl.purchaseDetails.seats > 1">\n        {{ "Seats:" | i18next}} <b>{{ ctrl.purchaseDetails.seats }}</b>\n      </span>\n      <div class="clearfix"></div>\n        <span ng-if="ctrl.currentPlan.planType !== 2">{{\'Paid:\' | i18next}} <b>{{ ctrl.currentPlan.interval }}</b></span>\n        <div class="clearfix"></div>\n        <span>\n          {{"Price:" | i18next}}\n          <b>\n            {{ (ctrl.currentPlan.amountCents / 100) | currency:"$" | currencyDecimalSeparator }} <span>{{"USD "}}</span>\n            <span ng-if="ctrl.currentPlan.planType !== 2">{{ "user / __interval__" | i18next:{interval: ctrl.prettyInterval(ctrl.currentPlan.interval)} }}</span>\n          </b>\n        </span>\n        <div class="clearfix"></div>\n        <span ng-if="ctrl.getPlanType()">{{\'Purchase type:\' | i18next}} <b>{{ ctrl.getPlanType() }}</b></span>\n      <div class="clearfix"></div>\n    </div>\n    <table class="os-payment-summary-table">\n      <tbody>\n      <tr>\n        <td>{{"Subtotal" | i18next}}</td>\n        <td>{{ (ctrl.summary.subtotal) | currency:"$" | currencyDecimalSeparator }}</td>\n      </tr>\n      <tr>\n        <td>{{"Discount" | i18next}}</td>\n        <td><span ng-if="ctrl.currentPlan.discountInfo.amount > 0">-</span>{{ ctrl.summary.discount || 0 | currency:"$" | currencyDecimalSeparator }}</td>\n      </tr>\n      <tr>\n        <td>\n          <span ng-if="!ctrl.hasNoPaymentOption()">{{"Taxes" | i18next}}</span>\n          <span ng-if="ctrl.hasNoPaymentOption()">{{"Taxes*" | i18next}}</span>\n        </td>\n        <td>\n          <span ng-if="!ctrl.calculatingPaymentDetails">{{ ctrl.summary.taxes | currency:"$" | currencyDecimalSeparator }}</span>\n          <span ng-if="ctrl.calculatingPaymentDetails">{{"Calculating…" | i18next}}</span>\n        </td>\n      </tr>\n      <tr>\n        <td>\n          <h4 ng-if="!ctrl.showProratedMessage()">{{"Total" | i18next}}</h4>\n          <h4 ng-if="ctrl.showProratedMessage()">{{"Total*" | i18next}}</h4>\n        </td>\n        <td>\n          <h4 ng-if="!ctrl.calculatingPaymentDetails">{{ (ctrl.summary.subtotal + ctrl.summary.taxes - ctrl.summary.discount) | currency:"$" | currencyDecimalSeparator }}</h4>\n          <h4 ng-if="ctrl.calculatingPaymentDetails">{{"Calculating…" | i18next}}</h4>\n        </td>\n      </tr>\n      </tbody>\n    </table>\n    <div class="small text-padding currency-message">{{"Prices are in $ USD" | i18next}}</div>\n    <div class="small text-padding" ng-if="ctrl.showProratedMessage()">{{"* Your final charged amount will prorate any time left on your existing subscription and may be less than the amount indicated here." | i18next}}</div>\n    <div class="small text-padding" ng-if="ctrl.hasNoPaymentOption()">{{"* Any applicable taxes will be displayed at payment confirmation." | i18next}}</div>\n </div>\n</div>\n')}]),e.exports=n},665:function(e,t,i){var n="/project/web/ts/billing/purchaseApp.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="os-content-scroll-container">\n  <div class="os-purchase-wrapper os-col">\n    <div class="os-purchase-header">\n      <div class="os-brand-logo-container">\n        <osc-