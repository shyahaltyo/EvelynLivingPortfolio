tiesManager.unitOfMeasureLabel }}\n        </div>\n        <div class="percent-width-10">\n          {{ \'Status\' | i18next}}\n        </div>\n      </div>\n      \x3c!-- Item list --\x3e\n      <div class="item-list">\n        <div ng-repeat="item in $ctrl.itemList" ng-click="$ctrl.selectItem(item)">\n          <div class="os-profile-list-item os-selectable-item px-4"\n              ng-class="{\'os-selectable-item\': $ctrl.canAuthor, \'os-selected\': $ctrl.isItemSelected(item)}"\n              ng-dblclick="$ctrl.editItem(item)">\n            <div class="percent-width-25 ellipseOverflowText" data-bs-original-title="{{ item.name }}" overflow-tooltip="true">\n              \x3c!-- Admins (or those who have permission) can see and edit item details --\x3e\n              <a ng-if="$ctrl.canAuthor" class="open-document-link" ng-click="$ctrl.editItem(item)">\n                <os-svg icon="item-element"></os-svg>\n                <span ng-bind="item.name"></span>\n              </a>\n              \x3c!-- Read only (non-link) --\x3e\n              <span ng-if="!$ctrl.canAuthor" style="cursor: default">\n                <os-svg icon="item-element"></os-svg>\n                <span ng-bind="item.name"></span>\n              </span>\n            </div>\n            <div ng-show="$ctrl.propertiesManager.isDescriptionActive" class="percent-width-30 ellipseOverflowText"\n                data-bs-original-title="{{ $ctrl.getItemDescription(item) }}" overflow-tooltip="true">\n              {{ $ctrl.getItemDescription(item) }}\n            </div>\n            <div class="percent-width-5"></div>\n            <div ng-show="$ctrl.propertiesManager.isPartNumberActive" class="percent-width-20 ellipseOverflowText"\n                data-bs-original-title="{{ $ctrl.getItemPartNumber(item) }}" overflow-tooltip="true">\n              <span>{{ $ctrl.getItemPartNumber(item) }}</span>\n            </div>\n            <div ng-show="$ctrl.propertiesManager.isUnitOfMeasureActive" class="percent-wid