9679:function(e,t,i){var n="/project/web/ts/customProperties/propertyDetailsTemplate.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<form name="propertyDetailsForm" novalidate="novalidate" autocomplete="off" ng-show="$ctrl.initialized">\n  <div class="user-settings os-form os-form-container custom-properties os-profile-vertical-list">\n  \x3c!-- the following div is needed to support proper behavior of the computed-property-function selection dialog --\x3e\n  <div id="viewerdiv">\n\n    \x3c!-- Informational message that properties cannot be customzized in company == ONSHAPE --\x3e\n    <div\n      class="validation-message alert alert-minheight alert-info"\n      ng-if="$ctrl.initialized && $ctrl.isOwnerOnshape()">\n      {{\'Onshape company properties cannot be edited here.\' | i18next}}\n    </div>\n\n    <h4 class="section-header">{{ "Attributes" | i18next }}</h4>\n\n    \x3c!-- Name --\x3e\n    <div class="custom-properties-form-group">\n      <label for="nameFieldId" class="control-label">\n        {{ \'Name\' | i18next }}\n      </label>\n      <input\n        id="nameFieldId"\n        name="nameFieldName"\n        type="text"\n        class="form-control"\n        ng-class="{\'has-error\': propertyDetailsForm.nameFieldName.$invalid}"\n        ng-model="$ctrl.property.name"\n        placeholder="{{\'New property\' | i18next}}"\n        ng-maxlength="{{$ctrl.MAX_LEN_NAME}}"\n        ng-required="true"\n        ng-change="$ctrl.checkValidName()"\n        ng-model-options="{debounce: 300}"\n        ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n      />\n      <p ng-show="propertyDetailsForm.nameFieldName.$error.required" class="text-danger">\n        {{ "Required field must not be empty." | i18next}}\n      </p>\n      <p\n        class="text-danger"\n        ng-show="propertyDetailsForm.nameFieldName.$error.maxlength">\n          {{\'Length must not exceed __maxLength__ characters.\' | i18next:{maxLength: $ctrl.MAX_LEN_NAME} }}\n      </p>\n      <p\n        class="text-danger"\n        ng-show="propertyDetailsForm.nameFieldName.$error.validtext">\n          {{\' Field must contain at least one letter or number.\' | i18next}}\n      </p>\n    </div>\n\n    \x3c!-- Display Name --\x3e\n    <div class="custom-properties-form-group">\n      <label for="displayNameFieldId" class="control-label">\n        {{ \'Display name\' | i18next }}\n      </label>\n      <input\n        id="displayNameFieldId"\n        name="displayNameFieldName"\n        type="text"\n        class="form-control"\n        ng-class="{\'has-error\': propertyDetailsForm.displayNameFieldName.$invalid}"\n        ng-model="$ctrl.propertyConfig.displayName"\n        ng-maxlength="{{$ctrl.MAX_LEN_NAME}}"\n        ng-model-options="{debounce: 300}"\n        ng-disabled="$ctrl.readOnly"\n      />\n      <p\n        class="text-danger"\n        ng-show="propertyDetailsForm.displayNameFieldName.$error.maxlength">\n          {{\'Length must not exceed __maxLength__ characters.\' | i18next:{maxLength: $ctrl.MAX_LEN_NAME} }}\n      </p>\n      <p\n        class="text-danger"\n        ng-show="propertyDetailsForm.displayNameFieldName.$error.validtext">\n          {{\' Field must contain at least one letter or number.\' | i18next}}\n      </p>\n    </div>\n\n    <div ng-if="::(!$ctrl.computed)" class="standard-attributes">\n      \x3c!-- Value type --\x3e\n      <div class="clearfix">\n        <div class="custom-properties-form-group col-lg-4">\n          <label for="valueTypeId" class="control-label">\n            {{ \'Type\' | i18next }}\n          </label>\n          \x3c!-- For active or inactive state this field is always disabled  --\x3e\n          <span\n            ng-if="!$ctrl.isInitialPublishStatePending()"\n            id="valueTypeId"\n            name="valueTypeName"\n            ng-disabled="true"\n            class="form-control">\n              {{$ctrl.valueTypeName}}\n          </span>\n          <select\n            ng-if="$ctrl.isInitialPublishStatePending()"\n            id="valueTypeId"\n            name="valueTypeName"\n            ng-change="$ctrl.valueTypeChanged()"\n            ng-model="$ctrl.property.valueType"\n            ng-options="valueType.value as valueType.label for valueType in $ctrl.valueTypeEntries"\n            ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n            class="form-control">\n            <option\n              ng-repeat="valueTypeEntry in $ctrl.valueTypeEntries"\n              value="{{valueTypeEntry.value}}"\n              ng-selected="valueTypeEntry.value === $ctrl.property.valueType">\n              {{valueTypeEntry.label || valueTypeEntry.value}}\n            </option>\n          </select>\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.valueTypeName.$error.required">\n              {{\'Required field must not be empty.\' | i18next}}\n          </p>\n        </div>\n      </div>\n\n      \x3c!-- Unit type --\x3e\n      <div class="clearfix" ng-if="$ctrl.canHaveUnits()">\n        <div class="custom-properties-form-group col-lg-4">\n          <label for="quantityTypeId" class="control-label">\n            {{ \'Unit type\' | i18next }}\n          </label>\n          <select\n            id="quantityTypeId"\n            name="quantityTypeName"\n            ng-show="$ctrl.initialized"\n            ng-model="$ctrl.propertyConfig.quantityType"\n            ng-change="$ctrl.updateAggregatedAssemblyProperties()"\n            ng-options="quantityType.value as quantityType.label for quantityType in $ctrl.quantityTypeEntries"\n            ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n            class="form-control">\n          </select>\n        </div>\n      </div>\n\n      \x3c!-- Publish state --\x3e\n      <div class="clearfix">\n        <div class="custom-properties-form-group col-lg-4">\n          <label for="publishStateId" class="control-label">\n            {{ \'Publish state\' | i18next }}\n          </label>\n          <select\n            id="publishStateId"\n            name="publishStateName"\n            ng-init="validPublishStateEntries = $ctrl.getValidPublishStateEntries()"\n            ng-show="$ctrl.initialized"\n            ng-model="$ctrl.propertyConfig.publishState"\n            ng-change="$ctrl.updateAggregatedAssemblyProperties()"\n            ng-options="publishState.value as publishState.label for publishState in validPublishStateEntries"\n            ng-disabled="$ctrl.frozenPublishState || $ctrl.readOnly"\n            class="form-control">\n            <option\n              ng-repeat="publishStateEntry in validPublishStateEntries"\n              value="{{publishStateEntry.value}}"\n              ng-selected="publishStateEntry.value === $ctrl.propertyConfig.publishState">\n              {{publishStateEntry.label || publishStateEntry.value}}\n            </option>\n          </select>\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.publishStateName.$error.required">\n              {{\'Required field must not be empty.\' | i18next}}\n          </p>\n        </div>\n      </div>\n\n      \x3c!-- Existing EnumValues --\x3e\n      <div class="clearfix" ng-if="$ctrl.restricted">\n        <div class="custom-properties-form-group col-md-4"\n          ng-if="$ctrl.property.valueType === 5 && !$ctrl.isInitialPublishStatePending()">\n          <label for="enumExistingValuesId" class="control-label">\n            {{ \'Existing list values\' | i18next }}\n            <span class="control-label control-info os-user-preference-info os-question-mark os-svg-icon"\n                  popover-trigger="\'mouseenter\'"\n                  popover-append-to-body="true"\n                  uib-popover-html="$ctrl.getEnumExistingValuesPopoverHTML()"\n                  popover-placement="right"\n                  ng-if="!$ctrl.restricted">\n            </span>\n          </label>\n          <input ngclipboard\n                 ngclipboard-success="$ctrl.onEnumCopy()"\n                 id="old-copy-enums-button"\n                 data-clipboard-text="{{$ctrl.enumValuesForCopy}}"\n                 class="btn btn-primary form-control-spacer ng-isolate-scope clipboard-button"\n                 type="button"\n                 value="{{\'Copy to clipboard\' | i18next}}"\n                 ng-disabled="$ctrl.readOnly"\n          />\n          <div id="enumExistingValuesId"\n            class="form-control enum-value-display"\n            disabled="disabled">\n            <p ng-repeat="enumItem in $ctrl.propertyConfig.enumValues">\n              {{ enumItem.label ? enumItem.label : enumItem.value }}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      \x3c!-- New EnumValues --\x3e\n      <div class="clearfix">\n        <div class="custom-properties-form-group col-lg-10" ng-if="$ctrl.property.valueType === 5 && !$ctrl.restricted">\n          <div class="label-container">\n             <label for="enumValuesId" class="control-label">\n              {{ $ctrl.getListValuesLabel() }}\n              <span class="control-label control-info os-user-preference-info os-question-mark os-svg-icon"\n                    popover-trigger="\'mouseenter\'"\n                    popover-append-to-body="true"\n                    uib-popover-html="$ctrl.getEnumPopoverHTML()"\n                    popover-placement="right">\n              </span>\n            </label>\n            <label class="control-label enum">\n              <input type="checkbox"\n                 ng-checked="$ctrl.hideInactiveOptions"\n                 ng-click="$ctrl.toggleHideOrShowInactive()"\n                 data-bs-original-title="{{$ctrl.getHideShowTooltip()}}"\n                 ng-disabled="$ctrl.readOnly"\n              />\n              <span>{{\'Hide inactive values\' | i18next}}</span>\n            </label>\n            <input ngclipboard\n                   ngclipboard-success="$ctrl.onEnumCopy()"\n                   id="copy-enums-button"\n                   data-clipboard-text="{{$ctrl.enumValuesForCopy}}"\n                   class="btn btn-primary form-control-spacer ng-isolate-scope clipboard-button"\n                   type="button"\n                   value="{{\'Copy to clipboard\' | i18next}}"\n            />\n          </div>\n\n          <div class="enum-table-container">\n            <table class="table enum-value-table">\n              <thead>\n                <tr class="os-header enum-value-header">\n                  <th></th>\n                  <th class="enum-value-header">{{\'Value\' | i18next}}</th>\n                  <th class="enum-value-header">{{\'Display name\' | i18next}}</th>\n                  <th class="enum-value-header">{{\'Active\' | i18next}}</th>\n                  <th></th>\n                </tr>\n              </thead>\n              <tbody\n                dnd-list="$ctrl.propertyConfig.enumValues"\n                dnd-drop="$ctrl.onDndDrop(callback(), index)"\n                dnd-throttle-dragover="true"\n              >\n                <tr class="dndPlaceholder">\n                  <td colspan="5"></td>\n                </tr>\n                <tr data-id="custom-enum-{{::$ctrl.propertySummary.id}}-{{$index}}"\n                    class="item-row"\n                    ng-repeat="item in $ctrl.propertyConfig.enumValues track by $ctrl.getItemKey(item, $index)"\n                    ng-hide="$ctrl.hideInactiveOptions && item.state === $ctrl.enumValueStateInactive"\n                    dnd-draggable="item"\n                    dnd-effect-allowed="move"\n                    dnd-selected="propertyConfig.enumValues.selected = item"\n                    dnd-dragstart="$ctrl.onDragStart()"\n                    dnd-dragend="$ctrl.onDragEnd()"\n                    dnd-callback="$index"\n                    dnd-disable-if="::$ctrl.readOnly"\n                    ng-class="{\'selected\': propertyConfig.enumValues.selected === item}"\n                >\n                  <td class="enum-drag-handle-td"><div\n                    dnd-handle\n                    class="dnd-grip"\n                    /></td>\n                  <td class="enum-value-td" dnd-nodrag>\n                    <input ng-if="!$last"\n                           name="enumValue{{$index}}"\n                           type="text"\n                           class="form-control enum-input-value"\n                           ng-class="{\'enum-error\': item.hasValueLengthError || item.hasValueDuplicateError}"\n                           value="{{item.value}}"\n                           placeholder="{{\'New value\' | i18next}}"\n                           ng-model="item.value"\n                           ng-change="$ctrl.onTextChanged($index)"\n                           ng-disabled="::(!item.isNew && !$ctrl.isInitialPublishStatePending() || $ctrl.readOnly)"\n                           ng-maxlength="{{::$ctrl.MAX_LEN_NAME}}"\n                           ng-model-options="{debounce: 500, allowInvalid: true}"\n                           ng-click="$ctrl.selectText($event)"\n                           ng-focus="$ctrl.onEnumFocus($event)"\n                           required\n                    />\n                    <input ng-if="$last"\n                           name="enumValue{{$index}}"\n                           type="text"\n                           class="form-control enum-input-value"\n                           ng-class="{\'enum-error\': item.hasValueLengthError || item.hasValueDuplicateError}"\n                           value="{{item.value}}"\n                           placeholder="{{\'New value\' | i18next}}"\n                           ng-model="item.value"\n                           ng-change="$ctrl.onTextChanged($index)"\n                           ng-disabled="::(!item.isNew && !$ctrl.isInitialPublishStatePending() || $ctrl.readOnly)"\n                           ng-maxlength="{{::$ctrl.MAX_LEN_NAME}}"\n                           ng-model-options="{debounce: 500, allowInvalid: true}"\n                           ng-click="$ctrl.selectText($event)"\n                           ng-focus="$ctrl.onEnumFocus($event)"\n                           bt-focus="$ctrl.enumCursorFromInput && $ctrl.anyEnumHasAnError"\n                           required\n                    />\n                    <p\n                      class="text-danger"\n                      ng-show="propertyDetailsForm[\'enumValue\' + $index].$error.required">\n                      {{::$ctrl.getEnumErrorMessage($ctrl.errorTypeRequired)}}\n                    </p>\n                    <p\n                      class="text-danger"\n                      ng-show="propertyDetailsForm[\'enumValue\' + $index].$error.pattern">\n                      {{::$ctrl.getEnumErrorMessage($ctrl.errorTypePattern)}}\n                    </p>\n                    <p\n                      class="text-danger"\n                      ng-show="propertyDetailsForm[\'enumValue\' + $index].$error.maxlength">\n                      {{::$ctrl.getEnumErrorMessage($ctrl.errorTypeMaxLength)}}\n                    </p>\n                  </td>\n                  <td class="enum-label-td" dnd-nodrag>\n                    <input name="enumLabel{{$index}}"\n                           type="text"\n                           class="form-control enum-input-name"\n                           ng-class="{\'enum-error\': item.hasLabelLengthError  || item.hasLabelDuplicateError}"\n                           value="{{item.label}}"\n                           placeholder="{{item.state === $ctrl.enumValueStateActive ? (\'New display name\' | i18next) : \'\'}}"\n                           ng-model="item.label"\n                           ng-change="$ctrl.onTextChanged($index)"\n                           ng-disabled="$ctrl.getItemIsInactive(item) || $ctrl.readOnly"\n                           ng-maxlength="{{::$ctrl.MAX_LEN_NAME}}"\n                           ng-model-options="{debounce: 500, allowInvalid: true}"\n                           ng-click="$ctrl.selectText($event)"\n                           ng-focus="$ctrl.onEnumFocus()"\n                    />\n                    <p\n                      class="text-danger"\n                      ng-show="propertyDetailsForm[\'enumLabel\' + $index].$error.pattern">\n                      {{::$ctrl.getEnumErrorMessage($ctrl.errorTypePattern)}}\n                    </p>\n                    <p\n                      class="text-danger"\n                      ng-show="propertyDetailsForm[\'enumLabel\' + $index].$error.maxlength">\n                      {{::$ctrl.getEnumErrorMessage($ctrl.errorTypeMaxLength)}}\n                    </p>\n                  </td>\n                  <td class="enum-active-td" dnd-nodrag>\n                    <input type="checkbox"\n                           ng-disabled="$ctrl.readOnly"\n                           ng-checked="item.state === $ctrl.enumValueStateActive"\n                           ng-click="$ctrl.onValueStateToggle($index, item)"\n                           data-bs-original-title="{{$ctrl.getEnumStateTooltip(item)}}"\n                    />\n                  </td>\n                  <td class="enum-remove-td" dnd-nodrag>\n                    <button\n                      type="button"\n                      class="os-button os-clear remove-enum"\n                      ng-class="{\'hidden-button\': !item.canDelete}"\n                      ng-click="$ctrl.removeNewEnumItem(item, $index)"\n                      ng-disabled="::$ctrl.readOnly"\n                      data-bs-placement="right"\n                      data-bs-original-title="{{\'Remove new list value\' | i18next}}"\n                    >\n                      <os-svg icon="trash"></os-svg>\n                    </button>\n                  </td>\n                </tr>\n              </tbody>\n              <tfoot>\n                <tr>\n                  <td></td>\n                  <td class="enum-value-td">\n                    <textarea\n                      id="enumValueInput"\n                      enum-property-input\n                      name="enumValuesName"\n                      type="text"\n                      class="form-control enum-input-value in"\n                      placeholder="{{\'New value(s)\' | i18next}}"\n                      ng-model="$ctrl.enumValuesLabel"\n                      ng-model-options="{allowInvalid: true}"\n                      ng-keydown="$ctrl.enumValueTyped($event)"\n                      ng-paste="$ctrl.enumValuePasted($event)"\n                      ng-click="$ctrl.selectText($event)"\n                      ng-disabled="$ctrl.readOnly || $ctrl.anyEnumHasAnError"\n                      bt-focus="$ctrl.enumCursorFromInput"\n                      rows="1"\n                      nowrap="nowrap"\n                      wrap="off"\n                    ></textarea>\n                  </td>\n                  <td colspan="3"></td>\n                </tr>\n              </tfoot>\n            </table>\n          </div>\n          <p\n            class="text-danger"\n            ng-show="!!$ctrl.enumFieldDuplicates.size || $ctrl.enumValueWillBeADuplicate">\n            {{\'Duplicate values or display names are not allowed.\' | i18next}}\n          </p>\n        </div>\n      </div>\n\n      \x3c!-- Default value --\x3e\n      <div ng-if="$ctrl.canHaveDefaultValue()" class="custom-properties-form-group" ng-class="{\'col-lg-4\': !$ctrl.isStringValueType()}">\n        <label for="defaultValueId"\n              class="control-label">\n          {{\'Default value\' | i18next}}\n        </label>\n        \x3c!-- Default value for string types --\x3e\n        <span ng-if="$ctrl.isStringValueType()">\n          <input\n            id="defaultValueId"\n            name="defaultValueName"\n            type="text"\n            class="form-control"\n            ng-model="$ctrl.propertyConfig.defaultValue"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n            ng-maxlength="{{$ctrl.propertyConfig.maxLength || $ctrl.MAX_LEN_STRFIELD}}"\n            ng-minlength="{{$ctrl.propertyConfig.minLength}}"\n            ng-pattern="$ctrl.getPattern()"\n            ng-model-options="{debounce: 300}"\n            os-valid-text="true"\n          />\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.maxlength">\n              {{\'Length must not exceed __maxLength__ characters.\' | i18next:{maxLength: $ctrl.propertyConfig.maxLength || $ctrl.MAX_LEN_STRFIELD} }}\n          </p>\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.minlength && !propertyDetailsForm.defaultValueName.$error.required">\n              {{\'Length must be at least __minLength__ characters.\' | i18next:{minLength: $ctrl.propertyConfig.minLength} }}\n          </p>\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.pattern\n              && !propertyDetailsForm.defaultValueName.$error.required\n              && !propertyDetailsForm.defaultValueName.$error.minlength\n              && !propertyDetailsForm.defaultValueName.$error.maxlength">\n              {{\'Pattern must match __pattern__.\' | i18next:{pattern: $ctrl.propertyConfig.pattern} }}\n          </p>\n        </span>\n\n        \x3c!-- Default value for User types --\x3e\n        <span ng-if="$ctrl.isUserValueType()">\n          <os-suggestions class="add-email"\n            id="defaultValueId"\n            name="defaultValueName"\n            ng-model="$ctrl.defaultValueUser"\n            ng-model-options="{debounce: 300}"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n            max="{{$ctrl.propertyConfig.maxCount}}"\n            min="{{$ctrl.propertyConfig.minCount}}"\n            get-suggestions="$ctrl.findFriends(query)"\n            is-valid-new-suggestion="$ctrl.isValidEmail(query)"\n            os-input-tokens\n            on-suggestion-selected="TokenController.addToken(suggestion)"\n            placeholder="{{ \'Search users\' | i18next }}">\n          </os-suggestions>\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.max">\n              {{\'Number of users must be no greater than __maxLength__.\' | i18next:{maxLength: $ctrl.propertyConfig.maxCount} }}\n          </p>\n\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.min">\n              {{\'Number of users must be at least __minLength__.\' | i18next:{minLength: $ctrl.propertyConfig.minCount} }}\n          </p>\n        </span>\n\n        \x3c!-- Default value for boolean type --\x3e\n        <span ng-if="$ctrl.isBooleanValueType()">\n          <select\n            id="defaultValueId"\n            name="defaultValueName"\n            ng-model="$ctrl.propertyConfig.defaultValue"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n            ng-model-options="{debounce: 300}"\n            class="form-control">\n            <option\n              ng-repeat="boolEntry in $ctrl.BOOLEAN_ENTRIES"\n              value="{{boolEntry.value}}"\n              ng-selected="boolEntry.value === $ctrl.propertyConfig.defaultValue">\n                {{boolEntry.label || boolEntry.value}}\n            </option>\n          </select>\n        </span>\n\n        \x3c!-- Default value for int types --\x3e\n        <span ng-if="$ctrl.isIntValueType()">\n          <input\n            id="defaultValueId"\n            name="defaultValueName"\n            type="number"\n            class="form-control"\n            max="{{$ctrl.propertyConfig.maxValue}}"\n            min="{{$ctrl.propertyConfig.minValue}}"\n            ng-model="$ctrl.defaultValueNumber"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n            ng-model-options="{debounce: 300}"\n            os-int-value="true"\n            step="1"\n          />\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.max && !$ctrl.minMaxValueValidationConflict()">\n              {{\'Specify a value no greater than __maxValue__.\' | i18next:{maxValue: $ctrl.propertyConfig.maxValue} }}\n          </p>\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.min && !$ctrl.minMaxValueValidationConflict()">\n              {{\'Specify a value of at least __minValue__.\' | i18next:{minValue: $ctrl.propertyConfig.minValue} }}\n          </p>\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.integer && !$ctrl.minMaxValueValidationConflict()">\n              {{\'Value must be an integer.\' | i18next}}\n          </p>\n        </span>\n\n        \x3c!-- Default value for double types --\x3e\n        <span ng-if="$ctrl.isDoubleValueType()">\n          <input\n            id="defaultValueId"\n            name="defaultValueName"\n            type="text"\n            class="form-control"\n            max="{{$ctrl.propertyConfig.maxValue}}"\n            min="{{$ctrl.propertyConfig.minValue}}"\n            ng-model="$ctrl.defaultValueNumber"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n            ng-model-options="{debounce: 300}"\n            os-double-value="true"\n          />\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.max && !$ctrl.minMaxValueValidationConflict()">\n              {{\'Specify a value no greater than __maxValue__.\' | i18next:{maxValue: $ctrl.getFormattedMaxValue()} }}\n          </p>\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.min && !$ctrl.minMaxValueValidationConflict()">\n              {{\'Specify a value of at least __minValue__.\' | i18next:{minValue: $ctrl.getFormattedMinValue()} }}\n          </p>\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.validDoubleValue">\n              {{ \'Enter a valid number.\' | i18next }}\n          </p>\n        </span>\n\n        \x3c!-- Default value for date type --\x3e\n        <div ng-if="$ctrl.isDateValueType()" uib-dropdown auto-close="disabled" is-open="$ctrl.datePickers.defaultPickerOpen">\n          <div class="input-group">\n            <input\n              id="defaultValueId"\n              name="defaultValueName"\n              type="text"\n              class="form-control"\n              os-date-input="{{$ctrl.datePickers.format}}"\n              placeholder="{{$ctrl.datePickers.format}}"\n              min-date="{{$ctrl.propertyConfig.minDate}}"\n              max-date="{{$ctrl.propertyConfig.maxDate}}"\n              ng-model="$ctrl.propertyConfig.defaultValue"\n              ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n              ng-change="$ctrl.updateDefaultDateValueAndMarkDirty()"\n              ng-model-options="{debounce: 300}"\n            />\n            <span class="input-group-btn">\n              <button type="button" class="btn btn-secondary rounded-0 rounded-end" ng-disabled="$ctrl.restricted || $ctrl.readOnly" uib-dropdown-toggle><i class="glyphicon glyphicon-calendar"></i></button>\n            </span>\n          </div>\n          <div class="dropdown-menu float-end p-2" uib-dropdown-menu os-dropdown-position>\n            <div>\n              <os-date-picker ng-if="$ctrl.datePickers.defaultPickerOpen" picker-model="$ctrl.datePickers.defaultPickerDate" picker-format="{{::$ctrl.datePickers.format}}" picker-view="date" picker-min-view="date" picker-min-date="{{$ctrl.propertyConfig.minDate}}" picker-max-date="{{$ctrl.propertyConfig.maxDate}}"></os-date-picker>\n              <div class="float-end me-2">\n                <button type="button" class="btn btn-primary btn-sm" ng-click="$ctrl.datePickers.setDefaultDate()">{{\'Update\' | i18next}}</button>\n                <button type="button" class="btn btn-sm btn-secondary" ng-click="$ctrl.datePickers.closeDefaultPicker()">{{\'Close\' | i18next}}</button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \x3c!-- Default value for enum types --\x3e\n        <span ng-if="$ctrl.isEnumValueType()">\n          <select\n            id="defaultValueId"\n            name="defaultValueName"\n            class="form-control"\n            ng-model="$ctrl.defaultValueEnum"\n            ng-change="$ctrl.updateEnumDefaultValue()"\n            ng-options="enumObject.label || enumObject.value for enumObject in $ctrl.propertyConfig.enumValues | filter: {state: \'!\' + $ctrl.enumValueStateInactive} track by enumObject.value"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly || !$ctrl.propertyConfig.enumValues || $ctrl.propertyConfig.enumValues.length === 0"\n            ng-model-options="{debounce: 300}">\n            <option value="">\n              {{$ctrl.getDefaultEnumValueSelectionMessage()}}\n            </option>\n          </select>\n        </span>\n        <p\n          class="text-danger"\n          ng-show="propertyDetailsForm.defaultValueName.$error.validtext">\n            {{\' Field cannot contain HTML.\' | i18next}}\n        </p>\n        <div ng-if="$ctrl.isDateValueType()" class="text-danger" ng-messages="propertyDetailsForm.defaultValueName.$error">\n          <span ng-message="date, parse" class="text-danger">{{$ctrl.datePickers.formatErrorMsg}}</span>\n          <span ng-message="minDate && !$ctrl.minMaxDateValidationConflict()" class="text-danger" ng-i18next="[text:i18next]({date:$ctrl.datePickers.getFormattedMinDate()})Specify a date no earlier than __date__."></span>\n          <span class="text-danger" ng-message=\'maxDate && !$ctrl.minMaxDateValidationConflict()\' ng-i18next="[text:i18next]({date:$ctrl.datePickers.getFormattedMaxDate()})Specify a date no later than __date__."></span>\n        </div>\n\n        \x3c!-- Default value for value with units types --\x3e\n        <span ng-if="$ctrl.isValueWithUnitsType()">\n          <input\n            id="defaultValueId"\n            name="defaultValueName"\n            type="text"\n            class="form-control"\n            ng-model="$ctrl.defaultValueValueWithUnits"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n            ng-model-options="{debounce: 300}"\n            ng-blur="$ctrl.formatDefaultValueWithUnitsValue()"\n            formatted-supplier="$ctrl.formattedValueWithUnitsSupplier"\n            quantity-type="{{$ctrl.propertyConfig.quantityType}}"\n            os-value-with-units-value="true"\n          />\n          <p\n            class="text-danger"\n            ng-show="propertyDetailsForm.defaultValueName.$error.validExpression">\n              {{ \'Enter a valid expression.\' | i18next }}\n          </p>\n        </span>\n        \x3c!-- Add new default value inputs above this line --\x3e\n      </div>\n\n      <div ng-if="!$ctrl.isStringValueType()" class="clearfix"></div>\n\n      \x3c!-- Description --\x3e\n      <div class="custom-properties-form-group">\n        <label for="descriptionId" class="control-label" ng-class="{\'dirty\': $ctrl.prop.dirty}">\n          {{ \'Description\' | i18next }}\n        </label>\n        <textarea\n          id="descriptionId"\n          name="descriptionName"\n          class="form-control"\n          ng-model="$ctrl.property.description"\n          ng-maxlength="{{$ctrl.MAX_LEN_STRFIELD}}"\n          ng-required="false"\n          ng-model-options="{debounce: 300}"\n          ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n        ></textarea>\n        <p\n          class="text-danger"\n          ng-show="propertyDetailsForm.descriptionName.$error.maxlength">\n            {{\'Length must not exceed __maxLength__ characters.\' | i18next:{maxLength: $ctrl.MAX_LEN_STRFIELD} }}\n        </p>\n      </div>\n\n      \x3c!-- Id --\x3e\n      <div ng-if="$ctrl.property.id" class="custom-properties-form-group">\n        <label class="control-label">\n          {{ \'Id\' | i18next }}\n        </label>\n        <div class="form-inline">\n          <input\n            name="idFieldName"\n            id="idFieldId"\n            type="text"\n            readonly="true"\n            class="form-control id-input"\n            value="{{$ctrl.property.id}}"\n          />\n          <input\n            id="copy-id-button"\n            ngclipboard\n            ngclipboard-success="$ctrl.confirmIdCopy()"\n            data-clipboard-target="#idFieldId"\n            class="btn btn-primary form-control-spacer"\n            type="button"\n            value="{{\'Copy to clipboard\' | i18next}}"\n          />\n        </div>\n      </div>\n\n      \x3c!-- Is Required --\x3e\n      <div ng-hide="$ctrl.isBooleanValueType()">\n        <label ng-class="{\'disabled\': $ctrl.restricted}"\n              class="os-align-center disable-user-select padded-checkbox">\n          <input type="checkbox"\n                ng-disabled="$ctrl.restricted || $ctrl.readOnly || $ctrl.propertyConfig.computedPropertyFunctionLinkedLocationName"\n                ng-model="$ctrl.propertyConfig.required"/>\n          {{ \'Required\' | i18next }}\n        </label>\n      </div>\n\n      \x3c!-- Is Multivalued --\x3e\n      <div ng-hide="!$ctrl.isCategoryValueType()">\n        <label class="os-align-center disable-user-select padded-checkbox">\n          <input type="checkbox" ng-model="$ctrl.propertyConfig.multivalued" ng-disabled="$ctrl.readOnly" />\n          {{ \'Multivalued\' | i18next }}\n        </label>\n      </div>\n\n      \x3c!-- Editable in version --\x3e\n      <div class="os-row">\n        <label ng-class="{\'disabled\': $ctrl.builtIn}"\n              class="os-align-center disable-user-select padded-checkbox">\n          <input type="checkbox"\n                ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n                ng-model="$ctrl.property.editableInVersion"/>\n          {{ \'Edit value in version\' | i18next }}\n        </label>\n        <label\n          ng-if="$ctrl.property.editableInVersion && !$ctrl.builtIn"\n          class="os-align-center disable-user-select padded-checkbox"\n        >\n          <input type="checkbox" ng-model="$ctrl.property.uiReadonlyInVersion" ng-disabled="$ctrl.readOnly" />\n          {{ \'Edit only through the API\' | i18next }}\n        </label>\n        <span ng-if="!$ctrl.readOnly" class="control-label control-info os-user-preference-info os-question-mark"\n              popover-trigger="\'mouseenter\'"\n              popover-append-to-body="true"\n              uib-popover-html="$ctrl.getVersionPopoverHTML()"\n              popover-placement="right">\n        </span>\n        <span\n          class="text-danger"\n          style="padding-left:10px"\n          name="editableInVersionError"\n          ng-if=\'$ctrl.isEditableInFieldRequired() && !$ctrl.property.editableInVersion\'>\n            {{\'Required properties without defaults must be editable in versions.\' | i18next}}\n        </span>\n      </div>\n\n      \x3c!-- Editable in microversion --\x3e\n      <div class="os-row">\n        <label\n          ng-class="{\'disabled\': $ctrl.builtIn}"\n          class="os-align-center disable-user-select padded-checkbox"\n        >\n          <input\n            type="checkbox"\n            ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n            ng-model="$ctrl.property.editableInMicroversion"/>\n          {{ \'Edit value in workspace\' | i18next }}\n        </label>\n        <label\n          ng-if="$ctrl.property.editableInMicroversion && !$ctrl.builtIn"\n          class="os-align-center disable-user-select padded-checkbox"\n        >\n          <input type="checkbox" ng-model="$ctrl.property.uiReadonlyInMicroversion" ng-disabled="$ctrl.readOnly" />\n          {{ \'Edit only through the API\' | i18next }}\n        </label>\n        <span class="control-label control-info os-user-preference-info os-question-mark"\n              ng-if="!$ctrl.readOnly"\n              popover-trigger="\'mouseenter\'"\n              popover-append-to-body="true"\n              uib-popover-html="$ctrl.getWorkspacePopoverHTML()"\n              popover-placement="right">\n        </span>\n        <span\n          class="text-danger"\n          style="padding-left:10px"\n          name="editableInMicroversionError"\n          ng-if=\'$ctrl.isEditableInFieldRequired() && !$ctrl.property.editableInMicroversion\'>\n            {{\'Required properties without defaults must be editable in workspaces.\' | i18next}}\n        </span>\n      </div>\n\n      \x3c!-- Spacer --\x3e\n      <div class="custom-properties-form-group"></div>\n\n      <h4 class="section-header" ng-if="$ctrl.hasValidations()">{{ "Validations" | i18next }}</h4>\n\n      \x3c!-- String validations --\x3e\n      <div ng-if="$ctrl.isStringValueType()">\n\n        \x3c!-- Multiline --\x3e\n        <div class="custom-properties-form-group">\n          <label class="os-align-center disable-user-select">\n            <input type="checkbox"\n                  ng-model="$ctrl.propertyConfig.multiline"\n                  ng-disabled="$ctrl.builtIn || $ctrl.readOnly"/>\n            {{ \'Multiline\' | i18next }}\n          </label>\n        </div>\n\n        \x3c!-- Min/max length validation --\x3e\n        <div class="custom-properties-form-group form-inline">\n\n          \x3c!-- Min length --\x3e\n          <label for="minLengthId" class="control-label">\n            {{ \'Min length\' | i18next }}\n          </label>\n          <input\n            id="minLengthId"\n            name="minLengthName"\n            type="number"\n            class="form-control numeric-input form-control-spacer"\n            min="{{$ctrl.MIN_LEN_STRFIELD}}"\n            max="{{$ctrl.MAX_LEN_STRFIELD}}"\n            ng-model="$ctrl.propertyConfig.minLength"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n            ng-required="false"\n            ng-model-options="{debounce: 300}"\n            os-int-value="true"\n            step="1"\n          />\n\n          \x3c!-- Max length --\x3e\n          <label for="maxLengthId" class="control-label">\n            {{ \'Max length\' | i18next }}\n          </label>\n          <input\n            id="maxLengthId"\n            name="maxLengthName"\n            type="number"\n            class="form-control numeric-input"\n            min="{{$ctrl.MIN_LEN_STRFIELD}}"\n            max="{{$ctrl.MAX_LEN_STRFIELD}}"\n            ng-model="$ctrl.propertyConfig.maxLength"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n            ng-required="false"\n            ng-model-options="{debounce: 300}"\n            os-int-value="true"\n            step="1"\n          />\n          <div\n            class="text-danger"\n            ng-show="propertyDetailsForm.minLengthName.$error.min">\n            {{\'Specify a minimum length of at least __minLength__.\' | i18next:{minLength: $ctrl.MIN_LEN_STRFIELD} }}\n          </div>\n          <div\n            class="text-danger"\n            ng-show="propertyDetailsForm.maxLengthName.$error.min">\n            {{\'Specify a maximum length of at least __minLength__.\' | i18next:{minLength: $ctrl.MIN_LEN_STRFIELD} }}\n          </div>\n          <div\n            class="text-danger"\n            ng-show="propertyDetailsForm.minLengthName.$error.max">\n            {{\'Specify a minimum length no greater than __maxLength__.\' | i18next:{maxLength: $ctrl.MAX_LEN_STRFIELD} }}\n          </div>\n          <div\n            class="text-danger"\n            ng-show="propertyDetailsForm.maxLengthName.$error.max">\n            {{\'Specify a maximum length no greater than __maxLength__.\' | i18next:{maxLength: $ctrl.MAX_LEN_STRFIELD} }}\n          </div>\n          <div\n            class="text-danger"\n            ng-show=\'$ctrl.minMaxLenValidationConflict()\'>\n            {{\'Minimum length must be less than or equal to max length.\' | i18next}}\n          </div>\n        </div>\n\n        \x3c!-- Pattern --\x3e\n        <div class="custom-properties-form-group form-inline">\n          <label for="patternFieldId" class="control-label">\n            {{ \'Pattern\' | i18next }}\n          </label>\n          <input\n            id="patternFieldId"\n            name="patternFieldName"\n            type="text"\n            class="form-control"\n            ng-model="$ctrl.propertyConfig.pattern"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n            ng-change="$ctrl.patternChanged()"\n            ng-required="false"\n            ng-model-options="{ updateOn: \'default blur\', debounce: { \'default\': 500, \'blur\': 0 } }"\n          />\n          <span class="control-label control-info os-user-preference-info os-question-mark align-middle"\n                popover-trigger="\'mouseenter\'"\n                popover-append-to-body="true"\n                uib-popover-html="$ctrl.getPatternPopoverHTML()"\n                popover-placement="right">\n          </span>\n          <div\n            class="text-danger"\n            ng-show=\'$ctrl.isPatternInvalid\'>\n            {{ \'Invalid pattern\' }}\n          </div>\n        </div>\n\n      </div>\n\n      \x3c!-- Int max/min value validations --\x3e\n      <div ng-if="$ctrl.isIntValueType()">\n\n        <div class="custom-properties-form-group form-inline">\n          \x3c!-- Min value --\x3e\n          <label for="minvalue-attribute" class="control-label">\n            {{ \'Min value\' | i18next }}\n          </label>\n          <input\n            id="minvalue-attribute"\n            name="minValueField"\n            type="number"\n            class="form-control numeric-input form-control-spacer"\n            ng-model="$ctrl.propertyConfig.minValue"\n            ng-required="false"\n            ng-model-options="{debounce: 300}"\n            os-int-value="true"\n            step="1"\n            ng-disabled="$ctrl.readOnly"\n          />\n\n          \x3c!-- Max value --\x3e\n          <label for="maxvalue-attribute" class="control-label">\n            {{ \'Max value\' | i18next }}\n          </label>\n          <input\n            id="maxvalue-attribute"\n            name="maxValueField"\n            type="number"\n            class="form-control numeric-input"\n            ng-model="$ctrl.propertyConfig.maxValue"\n            ng-required="false"\n            ng-model-options="{debounce: 300}"\n            os-int-value="true"\n            step="1"\n            ng-disabled="$ctrl.readOnly"\n          />\n          <div\n            class="text-danger"\n            ng-show=\'$ctrl.minMaxValueValidationConflict()\'>\n            {{\'Minimum value must be less than or equal to max value.\' | i18next}}\n          </div>\n          <div\n            class="text-danger"\n            ng-show="propertyDetailsForm.minValueField.$error.integer">\n              {{\'Min value must be an integer.\' | i18next}}\n          </div>\n          <div\n            class="text-danger"\n            ng-show="propertyDetailsForm.maxValueField.$error.integer">\n              {{\'Max value must be an integer.\' | i18next}}\n          </div>\n        </div>\n\n      </div>\n\n      \x3c!-- Double max/min value validations --\x3e\n      <div ng-if="$ctrl.isDoubleValueType()">\n\n        <div class="custom-properties-form-group form-inline">\n          \x3c!-- Min value --\x3e\n          <label for="minvalue-attribute" class="control-label">\n            {{ \'Min value\' | i18next }}\n          </label>\n          <input\n            id="minvalue-attribute"\n            name="minValueField"\n            type="text"\n            class="form-control numeric-input form-control-spacer"\n            ng-model="$ctrl.propertyConfig.minValue"\n            ng-required="false"\n            ng-model-options="{debounce: 300}"\n            os-double-value="true"\n            ng-disabled="$ctrl.readOnly"\n          />\n\n          \x3c!-- Max value --\x3e\n          <label for="maxvalue-attribute" class="control-label">\n            {{ \'Max value\' | i18next }}\n          </label>\n          <input\n            id="maxvalue-attribute"\n            name="maxValueField"\n            type="text"\n            class="form-control numeric-input"\n            ng-model="$ctrl.propertyConfig.maxValue"\n            ng-required="false"\n            ng-model-options="{debounce: 300}"\n            os-double-value="true"\n            ng-disabled="$ctrl.readOnly"\n          />\n          <div\n            class="text-danger"\n            ng-show=\'$ctrl.minMaxValueValidationConflict()\'>\n            {{\'Minimum value must be less than or equal to max value.\' | i18next}}\n          </div>\n          <div\n            class="text-danger"\n            ng-show=\'propertyDetailsForm.minValueField.$error.validDoubleValue\'>\n            {{\'Enter a valid min value.\' | i18next}}\n          </div>\n          <div\n            class="text-danger"\n            ng-show=\'propertyDetailsForm.maxValueField.$error.validDoubleValue\'>\n            {{\'Enter a valid max value.\' | i18next}}\n          </div>\n        </div>\n\n      </div>\n\n      \x3c!-- User max/min count validations --\x3e\n      <div ng-if="$ctrl.isUserValueType()">\n\n        <div class="custom-properties-form-group form-inline">\n          \x3c!-- Min count --\x3e\n          <label for="mincount-attribute" class="control-label">\n            {{ \'Min count\' | i18next }}\n          </label>\n          <input\n            id="mincount-attribute"\n            name="minCountField"\n            type="number"\n            class="form-control numeric-input form-control-spacer"\n            ng-model="$ctrl.propertyConfig.minCount"\n            ng-required="false"\n            ng-model-options="{debounce: 300}"\n            min="{{$ctrl.MIN_LIST_SIZE}}"\n            max="{{$ctrl.MAX_LIST_SIZE}}"\n            os-int-value="true"\n            step="1"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n          />\n\n          \x3c!-- Max count --\x3e\n          <label for="maxcount-attribute" class="control-label">\n            {{ \'Max count\' | i18next }}\n          </label>\n          <input\n            id="maxcount-attribute"\n            name="maxCountField"\n            type="number"\n            class="form-control numeric-input"\n            ng-model="$ctrl.propertyConfig.maxCount"\n            ng-required="false"\n            ng-model-options="{debounce: 300}"\n            min="{{$ctrl.MIN_LIST_SIZE + 1}}"\n            max="{{$ctrl.MAX_LIST_SIZE}}"\n            os-int-value="true"\n            step="1"\n            ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n          />\n          <div\n            class="text-danger"\n            ng-show="propertyDetailsForm.minCountField.$error.min">\n            {{\'Specify a minimum count of at least __minLength__.\' | i18next:{minLength: $ctrl.MIN_LIST_SIZE} }}\n          </div>\n          <div\n            class="text-danger"\n            ng-show="propertyDetailsForm.maxCountField.$error.min">\n            {{\'Specify a maximum count of at least __minLength__.\' | i18next:{minLength: $ctrl.MIN_LIST_SIZE + 1} }}\n          </div>\n          <div\n            class="text-danger"\n            ng-show="propertyDetailsForm.minCountField.$error.max">\n            {{\'Specify a minimum count no greater than __maxLength__.\' | i18next:{maxLength: $ctrl.MAX_LIST_SIZE} }}\n          </div>\n          <div\n            class="text-danger"\n            ng-show="propertyDetailsForm.maxCountField.$error.max">\n            {{\'Specify a maximum count no greater than __maxLength__.\' | i18next:{maxLength: $ctrl.MAX_LIST_SIZE} }}\n          </div>\n          <div\n            class="text-danger"\n            ng-show=\'$ctrl.minMaxCountValidationConflict()\'>\n            {{\'Minimum count must be less than or equal to max count.\' | i18next}}\n          </div>\n        </div>\n\n      </div>\n\n      \x3c!-- Date validations --\x3e\n      <div ng-if="$ctrl.isDateValueType()" class="clearfix">\n        \x3c!-- Min date --\x3e\n        <div class="col-lg-4 custom-properties-form-group form-inline" uib-dropdown auto-close="disabled" is-open="$ctrl.datePickers.minPickerOpen">\n          <label for="minDateId" class="control-label">\n            {{ \'Min date\' | i18next }}\n          </label>\n          <div class="input-group">\n            <input\n              id="minDateId"\n              name="minDateName"\n              type="text"\n              os-date-input="{{$ctrl.datePickers.format}}"\n              placeholder="{{$ctrl.datePickers.format}}"\n              class="form-control"\n              min-date="0001-01-01"\n              ng-model="$ctrl.propertyConfig.minDate"\n              ng-change="$ctrl.updateMinDateValueAndMarkDirty()"\n              ng-required="false"\n              ng-model-options="{debounce: 300}"\n              ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n            />\n            <span class="input-group-btn">\n              <button type="button" class="btn btn-secondary rounded-0 rounded-end" ng-disabled="$ctrl.restricted || $ctrl.readOnly" uib-dropdown-toggle><i class="glyphicon glyphicon-calendar"></i></button>\n            </span>\n          </div>\n          <span class="text-danger" ng-if="propertyDetailsForm.minDateName.$error.date || propertyDetailsForm.minDateName.$error.parse">{{$ctrl.datePickers.formatErrorMsg}}</span>\n          <span class="text-danger" ng-if="propertyDetailsForm.minDateName.$error.minDate">{{$ctrl.datePickers.formattedMinMinDateErrorMsg}}</span>\n          <div class="dropdown-menu float-end p-2" style="margin-right: 15px" uib-dropdown-menu os-dropdown-position>\n            <div>\n              <os-date-picker picker-model="$ctrl.datePickers.minPickerDate" picker-format="{{::$ctrl.datePickers.format}}" picker-view="date" picker-min-view="date" picker-min-date="0001-01-01"></os-date-picker>\n              <div class="float-end me-2">\n                <button type="button" class="btn btn-primary btn-sm" ng-click="$ctrl.datePickers.setMinDate()">{{\'Update\' | i18next}}</button>\n                <button type="button" class="btn btn-sm btn-secondary" ng-click="$ctrl.datePickers.closeMinPicker()">{{\'Close\' | i18next}}</button>\n              </div>\n            </div>\n          </div>\n          <div\n            class="text-danger"\n            ng-show=\'$ctrl.minMaxDateValidationConflict()\'>\n            {{\'Min date must be before or equal to max date.\' | i18next}}\n          </div>\n        </div>\n\n        <div class="col-lg-4 custom-properties-form-group form-inline" uib-dropdown auto-close="disabled" is-open="$ctrl.datePickers.maxPickerOpen">\n          \x3c!-- Max date --\x3e\n          <label for="maxDateId" class="control-label">\n            {{ \'Max date\' | i18next }}\n          </label>\n          <div class="input-group">\n            <input\n              id="maxDateId"\n              name="maxDateName"\n              type="text"\n              os-date-input="{{$ctrl.datePickers.format}}"\n              placeholder="{{$ctrl.datePickers.format}}"\n              class="form-control"\n              min-date="0001-01-01"\n              ng-model="$ctrl.propertyConfig.maxDate"\n              ng-model-options="{debounce: 300}"\n              ng-required="false"\n              ng-change="$ctrl.updateMaxDateValueAndMarkDirty()"\n              ng-disabled="$ctrl.restricted || $ctrl.readOnly"\n            />\n            <span class="input-group-btn">\n              <button type="button" class="btn btn-secondary rounded-0 rounded-end" ng-disabled="$ctrl.restricted || $ctrl.readOnly" uib-dropdown-toggle><i class="glyphicon glyphicon-calendar"></i></button>\n            </span>\n          </div>\n          <span class="text-danger" ng-if="propertyDetailsForm.maxDateName.$error.date || propertyDetailsForm.maxDateName.$error.parse">{{$ctrl.datePickers.formatErrorMsg}}</span>\n          <span class="text-danger" ng-if="propertyDetailsForm.maxDateName.$error.minDate">{{$ctrl.datePickers.formattedMinMaxDateErrorMsg}}</span>\n          <div class="dropdown-menu float-end p-2" style="margin-right: 15px" uib-dropdown-menu os-dropdown-position>\n            <div>\n              <os-date-picker picker-model="$ctrl.datePickers.maxPickerDate" picker-format="{{$ctrl.datePickers.format}}" picker-view="date" picker-min-view="date" picker-min-date="0001-01-01"></os-date-picker>\n              <div class="float-end me-2">\n                <button type="button" class="btn btn-primary btn-sm" ng-click="$ctrl.datePickers.setMaxDate()">{{\'Update\' | i18next}}</button>\n                <button type="button" class="btn btn-sm btn-secondary" ng-click="$ctrl.datePickers.closeMaxPicker()">{{\'Close\' | i18next}}</button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class="member-categories" ng-if="$ctrl.initialized">\n        <h4 class="section-header">{{ "Categories" | i18next }}</h4>\n        <div class="os-col member-category-list">\n\n          <category-picker\n            ng-if="$ctrl.ownerInfo.isPaidAdmin && $ctrl.propertyConfig.publishState !== 2 && $ctrl.property.assignable && !$ctrl.isNewCategoryPickerReplacementEnabled"\n            company-id="$ctrl.ownerInfo.ownerId"\n            include-onshape="false"\n            include-global="true"\n            active-only="true"\n            os-multiple="false"\n            ng-model="$ctrl.nextCategory"\n            ng-change="$ctrl.onNextCategory()"\n            cat-filter="$ctrl.isCategoryAvailable"\n            placeholder="$ctrl.catPickerPlaceholder"\n            ng-disabled="$ctrl.readOnly"\n          ></category-picker>\n\n          <osx-category-picker\n            ng-if="$ctrl.ownerInfo.isPaidAdmin && $ctrl.propertyConfig.publishState !== 2 && $ctrl.property.assignable && $ctrl.isNewCategoryPickerReplacementEnabled"\n            ng-model="$ctrl.nextCategory"\n            [company-id]="$ctrl.ownerInfo.ownerId"\n            [include-onshape]="false"\n            [include-global]="true"\n            [active-only]="true"\n            [multiselect]="false"\n            [cat-filter]="$ctrl.isCategoryAvailable"\n            [placeholder]="$ctrl.catPickerPlaceholder"\n            [ng-disabled]="$ctrl.readOnly"\n            [append-to-body]="true"\n            [with-class]="\'property-details\'"\n            (category-change)="$ctrl.onNextCategory()"\n          ></osx-category-picker>\n\n          <div class="custom-properties-form-group">\n            <category-tree\n              owner-info="$ctrl.ownerInfo"\n              read-only="true"\n              selectable="false"\n              remove-item="$ctrl.removeFromCategory(category)"\n              show-remove="!$ctrl.readOnly && $ctrl.ownerInfo.isPaidAdmin && $ctrl.propertyConfig.publishState !== 2 && $ctrl.property.assignable"\n              remove-icon="\'remove-button-x\'"\n              remove-tooltip="$ctrl.catTreeRemoveTooltip"\n              nodes="$ctrl.categories"\n              inner-tmpl-url="\'/project/web/ts/customProperties/inner-node.html\'"\n              label-with="$ctrl.catTreeLabelWith"\n              rebuild-event="rebuildCategoryTree"\n            ></category-tree>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \x3c!-- new fields for computed part properties\n         Only show these sections if the computed-part-properties capability is enabled.\n         Also note that some sections are shown if either the property is allowed to be configured as a computed property,\n         or if it is already pre-configured that way (as is the case with the standard Mass property).\n     --\x3e\n    <h4 class="section-header" ng-if="$ctrl.getShouldShowComputedPartPropertyUI()">\n      {{ "Computed part properties" | i18next }} </h4>\n\n    \x3c!-- Compute part property --\x3e\n    <div class="custom-properties-form-group padded-checkbox" ng-if="$ctrl.getShouldShowComputedPartPropertyUI() && $ctrl.getUserCanChangeComputedPartProperty()">\n      <label class="os-align-center disable-user-select">\n        <input type="checkbox" ng-model="$ctrl.computePartProperty" ng-disabled="$ctrl.readOnly" />\n        {{ \'Compute part property\' | i18next }}\n      </label>\n    </div>\n\n    \x3c!-- button for selecting the property function --\x3e\n    <div class="clearfix" ng-if="$ctrl.getShouldShowComputedPartPropertyUI() && $ctrl.getUserCanChangeComputedPartProperty() && $ctrl.computePartProperty">\n      <div class="custom-properties-form-group">\n        <button type="button" class="btn btn-primary"\n                ng-click="$ctrl.openSelectComputedPartPropertyFunctionDialog()">\n          {{ \'Select computed part property function\' | i18next }}\n        </button>  <span id="selectPropertyFunctionButton"> </span>\n      </div>\n    </div>\n\n    \x3c!-- Property Function human-readable location name --\x3e\n    <div class="custom-properties-form-group" ng-if="$ctrl.getShouldShowComputedPartPropertyUI() && $ctrl.computePartProperty">\n      <label for="propertyFunctionLocationId" class="control-label">\n        {{ \'Property function source\' | i18next }}\n      </label>\n      <span ng-if="$ctrl.propertyFunctionHasNewerVersion"\n            popover-trigger="\'mouseenter\'"\n            popover-append-to-body="true"\n            uib-popover-html="$ctrl.getPropertyFunctionUpdatePopoverHTML()"\n            popover-placement="right">\n        <os-svg icon="inserted-version-update"></os-svg>\n      </span>\n      <span class="control-label control-info os-question-mark os-svg-icon"\n            popover-trigger="\'mouseenter\'"\n            popover-append-to-body="true"\n            uib-popover-html="$ctrl.getPropertyFunctionSourcePopoverHTML()"\n            popover-placement="right">\n      </span>\n      <div class="text-danger" ng-show="$ctrl.propertyFunctionTypeMismatch">\n        {{\'Property function return type must match the property type\' | i18next }}\n      </div>\n      <div id="propertyFunctionLocationId" class="input-group col-lg-12 os-row os-align-center">\n        <div class="form-control uneditable-input">\n          <a ng-if="$ctrl.propertyConfig.computedPropertyFunctionLinkedLocationName" target="_blank" href="{{ $ctrl.propertyFunctionSourceUrl }}"\n          >{{ $ctrl.propertyConfig.computedPropertyFunctionLinkedLocationName }} /\n            {{ $ctrl.propertyConfig.computedPropertyFunctionName }}</a>\n          <span ng-if="$ctrl.propertyConfig.computedPropertyFunctionLinkedLocationName"\n                class="property-function-return-clause">{{ $ctrl.propertyFunctionReturnsClause }}</span>\n        </div>\n        <span>\n          <button class="btn btn-secondary custom-properties-function-clear-btn" type="button"\n                  ng-disabled="!$ctrl.propertyConfig.computedPropertyFunctionName || $ctrl.readOnly || $ctrl.propertyCannotBeCustomComputedProperty()"\n                  ng-click="$ctrl.clearComputedPartPropertyFunction()"\n                  data-bs-original-title="{{ \'Clear property function\' | i18next }}"\n                  ><os-svg icon="remove-button-x"></os-svg></button>\n          <span class="visually-hidden">{{ \'Clear property function\' | i18next }}</span>\n        </span>\n      </div>\n    </div>\n\n    <h4 class="section-header" ng-if="$ctrl.getShouldShowAggregatedAssemblyPropertyUI()">\n      {{ "Aggregated assembly properties" | i18next }}\n    </h4>\n\n    <div class="clearfix" ng-if="$ctrl.getShouldShowAggregatedAssemblyPropertyUI()">\n      <p ng-if="!$ctrl.getShouldShowAggregatedPropertiesSettings()" class="col-lg-12 ps-4">\n        {{ $ctrl.getAggregatedPropertiesInfoText() }}\n      </p>\n\n      <div class="custom-properties-form-group col-lg-4" ng-if="$ctrl.getShouldShowAggregatedPropertiesSettings()">\n        \x3c!-- Aggregate assembly property --\x3e\n        <div class="os-row">\n          <label ng-class="{\'disabled\': $ctrl.builtIn}"\n                class="os-align-center disable-user-select padded-checkbox">\n            <input type="checkbox"\n                  ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n                  ng-change="$ctrl.updateAggregatedAssemblyProperties()"\n                  ng-model="$ctrl.aggregateAssemblyProperty"/>\n            {{ \'Aggregate assembly property\' | i18next }}\n          </label>\n        </div>\n\n        <div class="conditional-list-section" ng-if="$ctrl.aggregateAssemblyProperty">\n          \x3c!-- Assembly aggregation method --\x3e\n          <label for="aggregationOperatorId" class="control-label">\n            {{ \'Assembly aggregation method\' | i18next }}\n          </label>\n          <select\n            ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n            id="aggregationOperatorId"\n            ng-show="$ctrl.initialized"\n            ng-change="$ctrl.updateAggregatedAssemblyProperties()"\n            ng-model="$ctrl.propertyConfig.computedAssemblyPropertyAggregationOperator"\n            ng-options="aggregationOperator.operator as aggregationOperator.name for aggregationOperator in $ctrl.getValidAggregationOperatorEntries()"\n            class="form-control">\n            <option\n              ng-repeat="aggregationOperatorEntry in $ctrl.getValidAggregationOperatorEntries()"\n              value="{{aggregationOperatorEntry.operator}}"\n              ng-selected="aggregationOperatorEntry.operator === $ctrl.propertyConfig.aggregationOperator">\n              {{aggregationOperatorEntry.name}}\n            </option>\n          </select>\n          <p class="col-lg-12 ps-4">\n            {{ $ctrl.getAggregationOperatorDescriptor() }}\n          </p>\n          \x3c!-- Aggregated property --\x3e\n          <label for="aggregatedPropertyId" class="control-label">\n            {{ \'Aggregated property\' | i18next }}\n          </label>\n          <select\n            ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n            id="aggregatedPropertyId"\n            ng-show="$ctrl.initialized"\n            ng-change="$ctrl.updateAggregatedAssemblyProperties()"\n            ng-model="$ctrl.propertyConfig.computedAssemblyPropertyAggregatedPropertyId"\n            ng-options="$ctrl.getAggregatedPropertyId(property) as $ctrl.getAggregatedPropertyDisplayName(property) for property in $ctrl.getValidAggregatedProperties()"\n            class="form-control">\n            <option\n              ng-repeat="property in $ctrl.getValidAggregatedProperties()"\n              value="{{property.displayName}}"\n              ng-selected="property.id === $ctrl.propertyConfig.computedAssemblyPropertyAggregatedPropertyId">\n              {{property.displayName}}\n            </option>\n          </select>\n          \x3c!-- Secondary property --\x3e\n          <label for="secondaryAggregationPropertyId" class="control-label" ng-if="$ctrl.getHasSecondaryAggregationProperty()">\n            {{ $ctrl.getSecondaryAggregationPropertyLabel() }}\n          </label>\n          <select\n            ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n            id="secondaryAggregationPropertyId"\n            ng-show="$ctrl.initialized && $ctrl.getHasSecondaryAggregationProperty()"\n            ng-model="$ctrl.propertyConfig.computedAssemblyPropertySecondaryPropertyId"\n            ng-options="property.id as property.displayName for property in $ctrl.getValidSecondaryAggregationProperties()"\n            class="form-control">\n            <option\n              ng-repeat="property in $ctrl.getValidSecondaryAggregationProperties()"\n              value="{{property.displayName}}"\n              ng-selected="property.id === $ctrl.propertyConfig.computedAssemblyPropertySecondaryPropertyId">\n              {{property.displayName}}\n            </option>\n          </select>\n          \x3c!-- Missing value handling --\x3e\n          <label for="aggregationMissingValuePolicy" class="control-label" ng-if="$ctrl.shouldShowAggregationMissingValueHandlingSection">\n            {{ \'Missing value handling\' | i18next }}\n          </label>\n          <select\n            ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n            id="aggregationMissingValuePolicy"\n            ng-show="$ctrl.initialized && $ctrl.shouldShowAggregationMissingValueHandlingSection"\n            ng-model="$ctrl.propertyConfig.computedAssemblyPropertyMissingValuePolicy"\n            ng-options="missingValuePolicyEntry.value as missingValuePolicyEntry.label for missingValuePolicyEntry in $ctrl.getValidAggregationMissingValuePolicyEntries()"\n            class="form-control">\n            <option\n              ng-repeat="missingValuePolicyEntry in $ctrl.getValidAggregationMissingValuePolicyEntries()"\n              value="{{missingValuePolicyEntry.displayName}}"\n              ng-selected="missingValuePolicyEntry.value === $ctrl.propertyConfig.computedAssemblyPropertyMissingValuePolicy">\n              {{missingValuePolicyEntry.label}}\n            </option>\n          </select>\n          \x3c!-- Error handling --\x3e\n          <label for="aggregationErrorValuePolicy" class="control-label">\n            {{ \'Error handling\' | i18next }}\n          </label>\n          <select\n            ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n            id="aggregationErrorValuePolicy"\n            ng-show="$ctrl.initialized"\n            ng-model="$ctrl.propertyConfig.computedAssemblyPropertyErrorValuePolicy"\n            ng-options="errorValuePolicyEntry.value as errorValuePolicyEntry.label for errorValuePolicyEntry in $ctrl.getValidAggregationErrorValuePolicyEntries()"\n            class="form-control">\n            <option\n              ng-repeat="errorValuePolicyEntry in $ctrl.getValidAggregationErrorValuePolicyEntries()"\n              value="{{errorValuePolicyEntry.displayName}}"\n              ng-selected="errorValuePolicyEntry.value === $ctrl.propertyConfig.computedAssemblyPropertyErrorValuePolicy">\n              {{errorValuePolicyEntry.label}}\n            </option>\n          </select>\n\n          <label ng-class="{\'disabled\': $ctrl.builtIn}"\n                class="os-align-center disable-user-select padded-checkbox"\n                ng-if="$ctrl.anyPropertiesAvailableToFilterAggregation">\n            <input type="checkbox"\n                  ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n                  ng-change="$ctrl.updateAggregatedAssemblyProperties()"\n                  ng-model="$ctrl.filterAggregatedProperty"/>\n            {{ \'Filter aggregation\' | i18next }}\n          </label>\n\n          <div class="conditional-list-section" ng-if="$ctrl.filterAggregatedProperty && $ctrl.anyPropertiesAvailableToFilterAggregation">\n            \x3c!-- Filter property --\x3e\n            <label for="aggregationFilterPropertyId" class="control-label">\n              {{ \'Boolean filter property\' | i18next }}\n            </label>\n            <select\n              ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n              id="aggregationFilterPropertyId"\n              ng-show="$ctrl.initialized"\n              ng-model="$ctrl.propertyConfig.computedAssemblyPropertyFilterPropertyId"\n              ng-options="property.id as $ctrl.getOrRenameDisplayName(property) for property in $ctrl.getValidAggregationFilterProperties()"\n              class="form-control">\n              <option\n                ng-repeat="property in $ctrl.getValidAggregationFilterProperties()"\n                value="{{$ctrl.getOrRenameDisplayName(property)}}"\n                ng-selected="property.id === $ctrl.propertyConfig.computedAssemblyPropertyAggregatedPropertyId">\n                {{$ctrl.getOrRenameDisplayName(property)}}\n              </option>\n            </select>\n            \x3c!-- Filter behavior --\x3e\n            <label for="aggregationFilterPropertyInvertedId" class="control-label">\n              {{ \'Filter behavior\' | i18next }}\n            </label>\n            <select\n              ng-disabled="$ctrl.builtIn || $ctrl.readOnly"\n              id="aggregationFilterPropertyInvertedId"\n              ng-show="$ctrl.initialized"\n              ng-model="$ctrl.propertyConfig.computedAssemblyPropertyFilterInverted"\n              ng-options="entry.value as entry.label for entry in $ctrl.aggregationFilterInvertedEntries"\n              class="form-control">\n              <option\n                ng-repeat="entry in $ctrl.aggregationFilterInvertedEntries"\n                value="{{entry.value}}"\n                ng-selected="entry.value === !!$ctrl.propertyConfig.computedAssemblyPropertyFilterInverted">\n                {{entry.label}}\n              </option>\n            </select>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class="properties-details-action-container">\n      <button\n        ng-if="!$ctrl.readOnly"\n        class="btn btn-primary"\n        type="button"\n        ng-disabled="$ctrl.isFormDisabled()"\n        ng-click="$ctrl.onSaveClick()">\n        <span ng-if="$ctrl.isNew"> {{ \'Create\' | i18next }} </span>\n        <span ng-if="!$ctrl.isNew"> {{ \'Save changes\' | i18next }} </span>\n      </button>\n      <button\n        class="btn btn-secondary button-cancel add-space-left"\n        type="button"\n        ng-click="$ctrl.cancel()">\n          {{ \'Cancel\' | i18next }}\n      </button>\n    </div>\n  </div>\n  </div>\n</form>\n')}]),e.exports=n},73053:function(e,t,i){var n="/project/web/ts/customProperties/propertyListTemplate.html";i(86399).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="os-control-container custom-properties">\n  <div class="os-control-row os-control-row-bottom">\n    <button type="button"\n            class="admin-spacer btn btn-primary float-start control-row"\n            ng-if="$ctrl.canCreate && !$ctrl.reorderingProperties"\n            ng-click="$ctrl.addProperty()">\n      {{ \'Create custom property\' | i18next }}\n    </button>\n\n    <div class="company-settings-context-help-btn" ng-if="helpUrl">\n      <a href="{{ helpUrl }}" target="help">\n        <span class="os-question-mark"></span>\n      </a>\n    </div>\n\n    \x3c!-- \'Find properties\' search box --\x3e\n    <div class="os-pin-right os-align-center os-row control-row" >\n      <div class="list-control" ng-if="$ctrl.canShowReorderOrConfirmButton()">\n        <button type="button"\n                class="btn btn-primary"\n                ng-disabled="$ctrl.reorderingProperties && !$ctrl.currentPropertiesReordered"\n                ng-click="$ctrl.reorderingProperties ? $ctrl.confirmReorder() : $ctrl.beginReorder()">\n          {{ $ctrl.getToggleReorderButtonText() | i18next }}\n        </button>\n      </div>\n\n      <div class="list-control" ng-if="$ctrl.canShowCancelReorderButton()">\n        <button type="button"\n                class="btn btn-secondary button-cancel"\n                ng-click="$ctrl.cancelReorder()">\n          {{ \'Cancel\' | i18next }}\n        </button>\n      </div>\n\n      <div class="list-control">\n        <os-search-box search-disabled="$ctrl.reorderingProperties"\n                       class="os-search-box-container os-field"\n                       search-text="$ctrl.findText"\n                       placeholder="$ctrl.findTextPlaceholder">\n        </os-search-box>\n      </div>\n\n      \x3c!-- Show inactive --\x3e\n      <div class="list-control">\n        <label class="os-align-center disable-user-select">\n          <input type="checkbox"\n                 ng-disabled="$ctrl.reorderingProperties"\n                 ng-change="$ctrl.showInactiveChanged()"\n                 ng-model="$ctrl.showInactive"/>\n          {{ \'Show inactive properties\' | i18next }}\n        </label>\n      </div>\n    </div>\n  </div>\n\n  <div class="os-profile-vertical-list" ng-class="{\'has-pending\': $ctrl.ownerInfo.isPaidAdmin && $ctrl.hasPending}">\n    \x3c!-- Column header row --\x3e\n    <div class="os-profile-list-item os-header-item column-header">\n      <div class="os-document-name">\n        {{ \'Property\' | i18next}}\n      </div>\n      <div>\n        {{ \'Type\' | i18next}}\n      </div>\n      <div>\n        <span>{{ \'Category\' | i18next }}</span>\n      </div>\n      <div>\n        {{ \'Id\' | i18next}}\n      </div>\n      <div>\n        {{ \'Status\' | i18next}}\n      </div>\n      <div>&nbsp;</div>\n    </div>\n    \x3c!-- Property list --\x3e\n    <div ng-if="!$ctrl.reorderingProperties">\n      <div ng-repeat="prop in filteredItems = ($ctrl.properties | filterPropertyIdAndName: $ctrl.findText | filterPropertyListByObjectType:$ctrl.objectTypeFilterSelection | filterInactiveProperties:$ctrl.showInactive)"\n            ng-click="$ctrl.selectItem(prop)">\n        <div class="os-profile-list-item"\n              ng-class="{\'os-selectable-item\': $ctrl.ownerInfo.isPaidAdmin, \'os-selected\': $ctrl.isItemSelected(prop)}"\n              ng-dblclick="$ctrl.editProperty(prop)">\n          <div ng-if="$ctrl.ownerInfo.isPaidAdmin" class="ellipseOverflowText" data-bs-original-title="{{ prop.name }}" overflow-tooltip="true">\n            \x3c!-- Admins can see and edit property details --\x3e\n            <a class="property-name" ng-click="$ctrl.editProperty(prop)">\n              <os-svg icon="{{prop.builtIn ? \'properties-builtin\' : \'properties-custom\'}}"></os-svg>\n              <span ng-bind="prop.name"></span>\n            </a>\n            <span ng-if="prop.config.displayName">({{prop.config.displayName}})</span>\n          </div>\n          <div ng-if="!$ctrl.ownerInfo.isPaidAdmin" class="ellipseOverflowText" data-bs-original-title="{{ prop.name }}" overflow-tooltip="true">\n            \x3c!-- Read only (non-link) --\x3e\n   