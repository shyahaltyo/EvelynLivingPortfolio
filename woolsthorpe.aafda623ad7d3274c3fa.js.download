ame\' | i18next}}"\n                ng-maxlength="255"\n                os-valid-text="true">\n            </div>\n            <p class="text-danger" ng-show="projectForm.projectName.$error.validtext">\n              {{ "Project name cannot contain HTML." | i18next}}\n            </p>\n            <p class="text-danger" ng-show="ctrl.project.name === \'\'">\n              {{ "Project name is required" | i18next}}\n            </p>\n            <p class="text-danger" ng-show="projectForm.projectName.$error.maxlength">\n              {{ "Project name must be between 1 and 255 characters with no forward slashes \'/\'." | i18next}}\n            </p>\n          </div>\n          <div class="form-group">\n            <label class="control-label">{{ "Description" | i18next}}</label>\n            <div>\n              <textarea\n                name="projectDescription"\n                class="form-control"\n                rows="2"\n                cols="40"\n                ng-model="ctrl.project.description"\n                data-automation="project-description"\n                placeholder="{{\'Description\' | i18next}}"\n                ng-maxlength="10000"\n                os-valid-text="true"></textarea>\n            </div>\n            <p class="text-danger" ng-show="projectForm.projectDescription.$error.validtext">\n              {{ "Project description cannot contain HTML." | i18next}}\n            </p>\n            <p class="text-danger" ng-show="projectForm.projectDescription.$error.maxlength">\n              {{ "Project description must be no more than 10000 characters in length." | i18next}}\n            </p>\n          </div>\n          <windchill-context-map\n            ng-if="ctrl.isWindchillIntegrationEnabled()"\n            custom-style="{ \'margin-left\': unset, \'width\': \'350px\' }"\n            context-label="Windchill context"\n            current-user="ctrl.currentUser"\n            plm-context="ctrl.project.plmContext"\n            update-plm-context="ctrl.updatePlmContext(updatedPlmContext)">\n          </windchill-context-map>\n          <div class="form-group">\n            <label class="control-label">{{ "Permission scheme" | i18next}}</label>\n            <div>\n              <ui-select class="os-grow" name="permissionScheme" ng-model="ctrl.project.permissionScheme" required theme="bootstrap" append-to-body="false" on-select="ctrl.permissionSchemeChange()" skip-focusser="true">\n                <ui-select-match placeholder="{{\'Select a permission scheme\' | i18next}}">{{ctrl.project.permissionScheme.name}}</ui-select-match>\n                <ui-select-choices repeat="option in ctrl.permissionSchemesList | filter: $select.search">\n                  <div ng-bind-html="option.name"></div>\n                </ui-select-choices>\n              </ui-select>\n            </div>\n            <div class="form-text text-muted scheme-description small">{{ctrl.project.permissionScheme.description}}</div>\n          </div>\n          <div class="role-map-entry-selectors">\n            <div class="os-tab-container">\n              <div class="os-tab"\n                   ng-class="{\'os-tab--active\': ctrl.isTabSelected(\'Individuals\')}"\n                   ng-click="ctrl.selectTab(\'Individuals\')">\n                <span>{{ "Individuals" | i18next }}</span>\n              </div>\n              <div class="os-tab"\n                   ng-class="{\'os-tab--active\': ctrl.isTabSelected(\'Teams\')}"\n                   ng-click="ctrl.selectTab(\'Teams\')">\n                <span>{{ "Teams" | i18next }}</span>\n              </div>\n              <div class="os-tab"\n                   ng-if="ctrl.canShowInviteGuestTab()"\n                   ng-class="{\'os-tab--active\': ctrl.isTabSelected(\'Guests\')}"\n                   ng-click="ctrl.selectTab(\'Guests\')">\n                <span>{{ "Invite guests" | i18next }}</span>\n              </div>\n            </div>\n            <div class="role-identities"  ng-if="ctrl.isTabSelected(\'Individuals\')">\n              <div class="form-group os-project-role-input-container">\n                <label class="control-label">{{ "Add users to project roles" | i18next}}</label>\n                <div class="os-row align-items-center">\n                  <span class="os-row os-grow os-rolemap-user-input">\n                    <os-suggestions class="add-email"\n                      get-suggestions="ctrl.findFriends(query)"\n                      is-valid-new-suggestion="ctrl.isNewEmailValid(query)"\n                      os-input-tokens\n                      on-suggestion-selected="TokenController.addToken(suggestion)"\n                      placeholder="{{ ctrl.suggestionPlaceholder }}">\n                    </os-suggestions>\n                  </span>\n                  <span class="os-row os-rolemap-role-select">\n                    <ui-select class="os-grow" ng-model="ctrl.roleUserMapper.selectedSchemeEntry" theme="bootstrap" append-to-body="false" skip-focusser="true" data-bs-original-title="{{$select.selected.role.name}}">\n                      <ui-select-match placeholder="{{\'Select a role\' | i18next}}">{{$select.selected.role.name}}</ui-select-match>\n                      <ui-select-choices repeat="option in ctrl.schemeEntryList | filter: $select.search">\n                        <div data-bs-original-title="{{ctrl.getRoleNameTooltip(option)}}" data-bs-placement="right">\n                          <div class="permission-role-name" ng-bind-html="option.role.name">{{\'Select a role\' | i18next}}</div>\n                          <div class="small text-muted permission-name-text">{{option.displayPermissionName}}</div>\n                        </div>\n                      </ui-select-choices>\n                    </ui-select>\n                  </span>\n                  <span>\n                    <button type="button" class="btn btn-primary form-control os-project-role-add-btn float-end" ng-click="ctrl.addUserListToRoleMap()" ng-di